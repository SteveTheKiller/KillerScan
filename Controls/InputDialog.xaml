<Window x:Class="KillerScan.Controls.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KillerScan"
        Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False">

    <!-- One-line text prompt on the ConfirmDialog chrome: same border, shadow, grain, wordmark
         title bar and button row, with an entry field where that dialog has its checkbox. Built
         so the SSH username prompt did not have to invent a second dialog language. -->
    <Border x:Name="RootBorder" Opacity="0"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource FlyoutCornerRadius}"
            Margin="{DynamicResource DialogHaloMargin}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270"
                              Opacity="{DynamicResource FlyoutShadowOpacity}"/>
        </Border.Effect>
        <Grid>
            <Border IsHitTestVisible="False" Panel.ZIndex="8"
                    BorderBrush="{DynamicResource FrameOuterLightBrush}"
                    BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
            <Border IsHitTestVisible="False" Panel.ZIndex="8"
                    BorderBrush="{DynamicResource FrameOuterDarkBrush}"
                    BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
            <!-- Film grain over the whole dialog (behind content), so it reads as one continuous
                 surface like the main window chrome. -->
            <Border IsHitTestVisible="False" CornerRadius="{DynamicResource FlyoutCornerRadius}"
                    Opacity="{DynamicResource GrainOpacity}"
                    Background="{DynamicResource GrainTileBrush}"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{DynamicResource DialogTitleBarHeight}"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title bar: transparent so the dialog grain + surface show through. Carries the
                     KillerScan wordmark exactly as the main window title bar does. -->
                <Border Grid.Row="0" Background="{DynamicResource InputDialogTitleBrush}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <!-- Wordmark with the same soft dark shadow copy the main title bar uses. -->
                        <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"
                              Visibility="{DynamicResource InputDialogWordmarkVisibility}">
                            <StackPanel Orientation="Horizontal" Margin="1,2,0,0"
                                        Opacity="{DynamicResource IconShadowOpacity}">
                                <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                                <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="15"><Run Text="Killer" Foreground="#D8000000"/><Run Text="Scan" FontSize="19.5" FontWeight="Bold" Foreground="#D8000000"/></TextBlock>
                            </StackPanel>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="15"><Run Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run Text="Scan" FontSize="19.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/></TextBlock>
                        </Grid>
                        <TextBlock Text="{DynamicResource Str_Ssh_Title}" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Visibility="{DynamicResource InputDialogPlainTitleVisibility}"
                                   FontFamily="Tahoma" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource ChromeTextBrush}"/>
                        <!-- The glyph is a named TextBlock recolored by TargetName, NOT the Button's
                             own Foreground: a local Foreground value outranks anything a trigger
                             sets on the same property, which leaves a red glyph on the red fill. -->
                        <Button Content="{DynamicResource AboutCloseGlyph}" Click="Cancel_Click"
                                Style="{StaticResource OverlayCloseButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="{DynamicResource AboutCloseWidth}" Height="{DynamicResource AboutCloseHeight}"
                                Margin="{DynamicResource AboutCloseMargin}"/>
                    </Grid>
                </Border>

                <!-- Body -->
                <StackPanel Grid.Row="1" Margin="{DynamicResource DialogContentMargin}">
                    <TextBlock x:Name="HeadingText"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock x:Name="DetailText" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" LineHeight="18" TextWrapping="Wrap"/>
                    <TextBlock x:Name="FieldLabel" Foreground="{StaticResource MutedTextBrush}"
                               FontFamily="Consolas" FontSize="10" Margin="0,14,0,4"/>
                    <TextBox x:Name="ValueBox"
                             Style="{StaticResource DarkTextBox}"
                             Padding="9,4" FontSize="12"
                             KeyDown="ValueBox_KeyDown"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="{DynamicResource DialogButtonsMargin}">
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click"
                            Style="{StaticResource SurfaceButton}"
                            MinWidth="80" Margin="0,0,8,0"/>
                    <!-- OutlineButton, not PrimaryButton: hollow by default, fills with the accent
                         on hover. Family standard, and what ConfirmDialog already uses. -->
                    <Button x:Name="OkButton" Content="OK" Click="OK_Click"
                            Style="{StaticResource OutlineButton}"
                            MinWidth="80"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
