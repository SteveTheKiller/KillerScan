<!-- One-line text prompt: KillerShell's RenameDialog (Controls/RenameDialog.xaml), the family's
     text-input dialog, element for element. The frame insets come from DialogContentMargin (0 on
     the flat themes) and the body and button row carry their own 24px padding, as RenameDialog's
     do; this dialog used to lean on DialogContentMargin for its body padding, which the family
     ThemeManager zeroes, so the field ran edge to edge. Adds a heading, an optional detail line and
     a field label above RenameDialog's single prompt. -->
<Window x:Class="KillerScan.Controls.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:KillerFamily.Theming"
        xmlns:kui="clr-namespace:KillerScan.Controls"
        Title="KillerScan"
        Width="300" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <kui:PickerBorder x:Name="RootBorder" Opacity="0"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="{DynamicResource DialogOuterBorderThickness}" CornerRadius="{DynamicResource PanelCornerRadius}"
            Margin="{DynamicResource DialogHaloMargin}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270"
                              Opacity="{DynamicResource FlyoutShadowOpacity}"/>
        </Border.Effect>
        <Grid>
            <Border IsHitTestVisible="False" Panel.ZIndex="6"
                    BorderBrush="{DynamicResource FrameOuterLightBrush}" BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
            <Border IsHitTestVisible="False" Panel.ZIndex="6"
                    BorderBrush="{DynamicResource FrameOuterDarkBrush}" BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
            <Border IsHitTestVisible="False" Panel.ZIndex="6" Margin="{DynamicResource FrameInnerMargin}"
                    BorderBrush="{DynamicResource FrameInnerLightBrush}" BorderThickness="{DynamicResource FrameInnerLightThickness}"/>
            <Border IsHitTestVisible="False" Panel.ZIndex="6" Margin="{DynamicResource FrameInnerMargin}"
                    BorderBrush="{DynamicResource FrameInnerDarkBrush}" BorderThickness="{DynamicResource FrameInnerDarkThickness}"/>
            <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                    Opacity="{DynamicResource GrainOpacity}"
                    Background="{DynamicResource GrainTileBrush}"/>
            <Grid Margin="{DynamicResource DialogContentMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="{DynamicResource DialogTitleBarRowHeight}"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource DialogTitleBarBrush}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Panel.ZIndex="1">
                    <Grid>
                        <Grid Margin="{DynamicResource DialogTitleBarPadding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <!-- The app icon leads the caption, as it does in the main title bar. -->
                                <kui:AppIcon x:Name="TitleIcon" VerticalAlignment="Center"
                                       Width="{DynamicResource TitleIconSize}" Height="{DynamicResource TitleIconSize}"
                                       Margin="{DynamicResource TitleIconMargin}"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <Grid VerticalAlignment="Center" Margin="0,-18,0,-22">
                                    <Grid.RenderTransform><TranslateTransform Y="-5"/></Grid.RenderTransform>
                                    <StackPanel Orientation="Horizontal" Margin="1,2,0,0"
                                                Visibility="{DynamicResource DialogWordmarkVisibility}"
                                                Opacity="{DynamicResource WordmarkShadowOpacity}">
                                        <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"><Run Text="Killer" Foreground="#D8000000"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Scan" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/></TextBlock>
                                    </StackPanel>
                                    <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"
                                               Visibility="{DynamicResource DialogWordmarkVisibility}" Margin="1,2,0,0" IsHitTestVisible="False" Opacity="{DynamicResource WordmarkAccentShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect><Run Text="Killer" Foreground="Transparent"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Scan" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/></TextBlock>
                                    <TextBlock theme:Bevel.Enabled="True" FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"
                                               Visibility="{DynamicResource DialogWordmarkVisibility}"><Run Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Scan" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="{DynamicResource AccentLogo}"/></TextBlock>
                                </Grid>
                                <!-- Outside the wordmark grid so the wordmark's lift and bleed never move it. -->
                                <TextBlock Text="KillerScan" FontFamily="{DynamicResource ChromeFontFamily}" VerticalAlignment="Center"
                                           FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ChromeTextBrush}"
                                           Visibility="{DynamicResource DialogPlainTitleVisibility}"/>
                            </StackPanel>
                        </Grid>
                        <!-- The family close: in the window's corner (AboutCloseMargin), as on ConfirmDialog
                             and the About card, not inset inside the title padding. -->
                        <Button Content="{DynamicResource AboutCloseGlyph}" Click="Cancel_Click"
                                AutomationProperties.Name="{DynamicResource Str_Sys_Close}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="{DynamicResource AboutCloseWidth}" Height="{DynamicResource AboutCloseHeight}"
                                Margin="{DynamicResource AboutCloseMargin}"
                                Style="{StaticResource OverlayCloseButton}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="16,10,16,10">
                    <TextBlock x:Name="HeadingText" Foreground="{DynamicResource TextBrush}" FontSize="13"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock x:Name="DetailText" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock x:Name="FieldLabel" Foreground="{DynamicResource MutedTextBrush}"
                               FontFamily="{DynamicResource UiFont}" FontSize="11" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ValueBox"
                                 Background="{DynamicResource TextFieldBrush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource PrimaryBrush}"
                                 BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
                                 FontFamily="{DynamicResource UiFont}" FontSize="13"
                                 Padding="6,3" KeyDown="ValueBox_KeyDown"/>
                        <!-- Optional icon choice right after the field (a Location's icon): the
                             button shows the current icon and opens a flyout of the choices. -->
                        <Button x:Name="IconButton" Grid.Column="1" Visibility="Collapsed" Margin="8,0,0,0"
                                Style="{StaticResource SurfaceButton}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                Width="36" Padding="0" Click="IconButton_Click"/>
                    </Grid>
                    <!-- Optional second field: a Location's notes, in New and Edit Location. -->
                    <TextBlock x:Name="NotesLabel" Visibility="Collapsed" Foreground="{DynamicResource MutedTextBrush}"
                               FontFamily="{DynamicResource UiFont}" FontSize="11" Margin="0,10,0,4"/>
                    <TextBox x:Name="NotesBox" Visibility="Collapsed"
                             Background="{DynamicResource TextFieldBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             CaretBrush="{DynamicResource PrimaryBrush}"
                             BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
                             FontFamily="{DynamicResource UiFont}" FontSize="13" Padding="6,3"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="220"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                    <!-- Optional read-only line: Edit Location's router, the gateway MAC it is recognized by. -->
                    <TextBlock x:Name="InfoLabel" Visibility="Collapsed" Foreground="{DynamicResource MutedTextBrush}"
                               FontFamily="{DynamicResource UiFont}" FontSize="11" Margin="0,10,0,2"/>
                    <TextBlock x:Name="InfoText" Visibility="Collapsed" Foreground="{DynamicResource TextBrush}"
                               FontFamily="{DynamicResource MonoFont}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,2,16,14">
                    <Button x:Name="CancelButton" Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click"
                            Style="{StaticResource SurfaceButton}" MinWidth="86" Margin="0,0,8,0"/>
                    <Button x:Name="OkButton" Content="OK" Click="OK_Click"
                            Style="{StaticResource OutlineButton}" MinWidth="86"/>
                </StackPanel>
            </Grid>
        </Grid>
    </kui:PickerBorder>
</Window>
