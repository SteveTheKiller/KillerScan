<UserControl x:Class="KillerScan.Controls.NetworkToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="Transparent">
    <UserControl.Resources>
        <!-- One Keep Alive target. Fixed width so the sparkline geometry stays honest and
             the wrap panel makes tidy columns instead of ragged full-width rows. -->
        <DataTemplate x:Key="WatchCardTemplate">
            <Border Width="264" Margin="0,0,8,8" VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <!-- The selected card is the one the details pane is reporting on,
                                 so it takes the accent edge rather than a filled row. -->
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <!-- A ContextMenu inherits DataContext from its placement target, so every
                     item here already carries this card and the handlers can read it back. -->
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource Str_Watch_CopyAddress}" Click="CardCopy_Click"/>
                        <MenuItem Header="{DynamicResource Str_Diag_Refresh}" Click="CardDiagnose_Click"/>
                        <Separator/>
                        <MenuItem Header="{DynamicResource Str_Watch_ResetStats}" Click="CardReset_Click"/>
                        <MenuItem Header="{DynamicResource Str_Watch_Remove}" Click="CardRemove_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#x25CF;" FontSize="13" Margin="0,0,6,0"
                                   VerticalAlignment="Center" Foreground="{Binding StateBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Address}" FontWeight="Bold" FontSize="14"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Grid.Column="2" FontSize="14" VerticalAlignment="Center"
                                   FontFamily="Consolas" Foreground="{Binding StateBrush}">
                            <Run Text="{Binding Latest, Mode=OneWay}"/><Run Text=" ms"/>
                        </TextBlock>
                    </Grid>
                    <TextBlock Grid.Row="1" Margin="0,1,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{Binding StateBrush}" Text="{Binding State}"/>
                    <Canvas Grid.Row="2" Height="26" Width="240" Margin="0,6,0,4" HorizontalAlignment="Left"
                            ClipToBounds="True">
                        <Polyline Points="{Binding Spark}" Stroke="{Binding SparkBrush}" StrokeThickness="1.4"
                                  StrokeLineJoin="Round"/>
                    </Canvas>
                    <TextBlock Grid.Row="3" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis">
                        <Run Text="{DynamicResource Str_Watch_Loss}"/><Run Text=" "/><Run Text="{Binding Loss, Mode=OneWay}"/><Run Text="   "/><Run Text="{DynamicResource Str_Watch_Sent}"/><Run Text=" "/><Run Text="{Binding Sent, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding Changed, Mode=OneWay}"/>
                    </TextBlock>

                    <!-- Details. Every card carries its own checks and its own log so several
                         targets can be read side by side instead of one at a time in a shared
                         pane. Watching one or two targets is the common case, so nothing is
                         hidden behind selection. -->
                    <StackPanel x:Name="Detail" Grid.Row="4" Margin="0,8,0,0">
                        <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,7"/>
                        <!-- AlternationCount, and the stripe read off the container's index, give
                             this list the same banding as the scan table. RowAltBrush is the
                             family's stripe: translucent, so the pane grain still shows. -->
                        <ItemsControl ItemsSource="{Binding Checks}" AlternationCount="2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="3,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Value="1" Binding="{Binding (ItemsControl.AlternationIndex),
                                                                 RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                                                        <Setter Property="Background" Value="{DynamicResource RowAltBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="88"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Check}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Result}" FontSize="11"
                                                       TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The log grows with the card up to a point, then scrolls. -->
                        <TextBlock Text="{DynamicResource Str_Watch_Events}" FontSize="10" Margin="0,8,0,3"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <Border Background="{DynamicResource MenuBackgroundBrush}" BorderThickness="1"
                                BorderBrush="{DynamicResource MenuBorderBrush}"
                                CornerRadius="{DynamicResource SmallCornerRadius}">
                            <Grid ClipToBounds="True">
                                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Padding="6,4">
                                    <ItemsControl ItemsSource="{Binding Events}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontFamily="Consolas" FontSize="11">
                                                    <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource DimTextBrush}"/><Run Text="  "/><Run
                                                        Text="{Binding State, Mode=OneWay}" Foreground="{Binding StateBrush}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Border IsHitTestVisible="False" Background="{DynamicResource GrainTileBrush}"
                                        Opacity="{DynamicResource GrainOpacity}"
                                        CornerRadius="{DynamicResource SmallCornerRadius}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Border Background="{DynamicResource ScanContentPaneBrush}" BorderBrush="{DynamicResource PaneBorderBrush}"
            BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}">
        <Grid>
            <Border IsHitTestVisible="False" Background="{DynamicResource GrainTileBrush}"
                    Opacity="{DynamicResource GrainOpacity}" CornerRadius="{DynamicResource PanelCornerRadius}"/>
            <Grid x:Name="ContentRoot" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="BodyHost" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <!-- Controls, then the cards. Each card carries its own checks and its
                             own log, so there is no shared details pane or log pane to make
                             room for down here. -->
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock x:Name="Hint" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Visibility="Collapsed"/>
                        <TextBlock x:Name="TargetLabel" Text="{DynamicResource Str_Watch_Targets}"
                                   Foreground="{DynamicResource TextBrush}" Visibility="Collapsed" TextWrapping="Wrap"/>
                        <!-- Detached into the workspace toolbar at startup, so Keep Alive's input
                             sits on the one bar at the top of the window instead of the pane
                             carrying a second one. Heading stays here as the fallback caption. -->
                        <WrapPanel x:Name="ToolBar" Margin="8,4">
                            <TextBlock x:Name="Heading" FontSize="12" FontWeight="Bold" Margin="0,0,8,0"
                                       Visibility="Collapsed"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="Targets" Style="{StaticResource DarkTextBox}" Padding="5,3,9,3"
                                     FontSize="12" Height="28" Width="280" MaxWidth="360" HorizontalAlignment="Left"
                                     ToolTip="{DynamicResource Str_Watch_Targets}" Margin="0,0,6,0"/>
                            <Button x:Name="StartButton" Style="{StaticResource OutlineButton}" Click="Start_Click" FontSize="12" Padding="8,3" Margin="0,0,6,0"/>
                            <Button x:Name="StopButton" Content="{DynamicResource Str_Watch_Stop}" Style="{StaticResource OutlineButton}" Click="Stop_Click" IsEnabled="False" FontSize="12" Padding="8,3" Margin="0,0,6,0"/>
                            <Button Content="{DynamicResource Str_Watch_Copy}" Style="{StaticResource OutlineButton}" Click="Copy_Click" FontSize="12" Padding="8,3"/>
                        </WrapPanel>
                        <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryBrush}" Margin="8,0,8,4">
                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Cards fill the pane. Selecting one expands it in place to show that
                         target's checks and log; diagnostics used to be a separate view, then a
                         shared side pane, and is now simply part of the card it describes. -->
                    <Grid Grid.Row="1">
                        <ListBox x:Name="Cards" Margin="8,4,8,8" ItemTemplate="{StaticResource WatchCardTemplate}"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <!-- Bare container: the card draws its own surface, and the default
                                 ListBoxItem chrome would paint a flat selection block over it. -->
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
