<Window x:Class="KillerScan.Controls.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:KillerFamily.Theming"
        xmlns:icons="clr-namespace:KillerScan.Controls"
        xmlns:kui="clr-namespace:KillerScan.Controls"
        Title="KillerScan"
        Width="390" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False">

    <kui:PickerBorder x:Name="RootBorder" Opacity="0"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource PanelCornerRadius}"
            Margin="{DynamicResource DialogHaloMargin}">
        <kui:PickerBorder.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Direction="270"
                              Opacity="{DynamicResource FlyoutShadowOpacity}"/>
        </kui:PickerBorder.Effect>
        <Grid>
            <Border IsHitTestVisible="False" Panel.ZIndex="8"
                    Margin="{DynamicResource FrameInnerMargin}"
                    BorderBrush="{DynamicResource FrameInnerLightBrush}"
                    BorderThickness="{DynamicResource FrameInnerLightThickness}"/>
            <Border IsHitTestVisible="False" Panel.ZIndex="8"
                    Margin="{DynamicResource FrameInnerMargin}"
                    BorderBrush="{DynamicResource FrameInnerDarkBrush}"
                    BorderThickness="{DynamicResource FrameInnerDarkThickness}"/>
            <Border IsHitTestVisible="False" Panel.ZIndex="8"
                    BorderBrush="{DynamicResource FrameOuterLightBrush}"
                    BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
            <Border IsHitTestVisible="False" Panel.ZIndex="8"
                    BorderBrush="{DynamicResource FrameOuterDarkBrush}"
                    BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
            <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                    Opacity="{DynamicResource GrainOpacity}"
                    Background="{DynamicResource GrainTileBrush}"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Height="{DynamicResource DialogTitleBarHeight}" Panel.ZIndex="1"
                        Background="{DynamicResource InputDialogTitleBrush}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <!-- The app icon leads the caption, as it does in the main title bar. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{DynamicResource DialogTitleBarPadding}"
                                    Visibility="{DynamicResource DialogWordmarkVisibility}">
                        <icons:AppIcon x:Name="TitleIcon" Width="{DynamicResource TitleIconSize}" Height="{DynamicResource TitleIconSize}"
                               VerticalAlignment="Center" Margin="{DynamicResource TitleIconMargin}"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <Grid VerticalAlignment="Center" Margin="0,-18,0,-22">
                            <Grid.RenderTransform><TranslateTransform Y="-5"/></Grid.RenderTransform>
                            <StackPanel Orientation="Horizontal" Margin="1,2,0,0"
                                        Opacity="{DynamicResource WordmarkShadowOpacity}">
                                <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                                <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"><Run Text="Killer" Foreground="#D8000000"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Scan" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/></TextBlock>
                            </StackPanel>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}" Margin="1,2,0,0" IsHitTestVisible="False" Opacity="{DynamicResource WordmarkAccentShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect><Run Text="Killer" Foreground="Transparent"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Scan" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/></TextBlock>
                            <TextBlock theme:Bevel.Enabled="True" FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"><Run Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Scan" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="{DynamicResource AccentLogo}"/></TextBlock>
                        </Grid>
                        </StackPanel>
                        <TextBlock Text="KillerScan" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Visibility="{DynamicResource DialogPlainTitleVisibility}"
                                   FontFamily="Tahoma" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource ChromeTextBrush}"/>
                        <Button Content="{DynamicResource AboutCloseGlyph}" Click="Cancel_Click" AutomationProperties.Name="{DynamicResource Str_Sys_Close}"
                                Style="{StaticResource OverlayCloseButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="{DynamicResource AboutCloseWidth}" Height="{DynamicResource AboutCloseHeight}"
                                Margin="{DynamicResource AboutCloseMargin}"/>
                    </Grid>
                </Border>

                <!-- Body -->
                <Grid Grid.Row="1" Margin="24,18,24,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <!-- Notice ring, as in the family setup dialog: amber "!" on a confirmation, accent "i" on a notice. -->
                    <Border x:Name="NoticeRing" Width="28" Height="28" CornerRadius="14" BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock x:Name="NoticeGlyph" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                    <!-- These are NOT design-time placeholders. The portable install badge opens
                         this dialog through the parameterless constructor, so whatever is set here
                         is what a user reads - which is why they have to be resources. -->
                    <TextBlock x:Name="HeadingText" Text="{DynamicResource Str_Install_HeadUser}"
                               Foreground="{StaticResource TextBrush}"
                               FontFamily="{DynamicResource HeadingFont}" FontSize="18"
                                               TextOptions.TextFormattingMode="Ideal" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailText" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" LineHeight="19" TextWrapping="Wrap" Margin="0,10,0,0">
                        <Run Text="{DynamicResource Str_Install_BulletShortcut}"/>
                        <LineBreak/>
                        <Run Text="{DynamicResource Str_Install_BulletArp}"/>
                    </TextBlock>
                    <!-- Optional choice for a reused dialog, such as the startup update prompt's
                         "Always check on startup". Hidden on the install prompt. -->
                    <CheckBox x:Name="Check1" Visibility="Collapsed" Margin="0,16,0,0"
                              Foreground="{StaticResource TextBrush}" FontSize="12"/>

                    <!-- All-users install: routes to the same machine-wide path winget and choco
                         already use (Program Files + HKLM), by re-running the app elevated with
                         /silent. Unticked keeps the original per-user behavior, so the default
                         install still needs no admin rights. -->
                    <CheckBox x:Name="AllUsersCheck" Margin="0,16,0,0"
                              Checked="AllUsers_Changed" Unchecked="AllUsers_Changed"
                              Foreground="{StaticResource TextBrush}" FontSize="12"
                              Content="{DynamicResource Str_Install_AllUsers}"/>
                    <!-- Always visible, so the dialog does not change height when the box is
                         ticked and the consequence is readable before committing to it. -->
                    <TextBlock x:Name="AllUsersNote" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" LineHeight="16" TextWrapping="Wrap"
                               Margin="22,5,0,0"
                               Text="{DynamicResource Str_Install_AllUsersNote}"/>
                </StackPanel>
                </Grid>

                <!-- Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="24,0,24,20">
                    <Button x:Name="CancelButton" Content="{DynamicResource Str_Btn_Cancel}" Click="Cancel_Click"
                            Style="{StaticResource SurfaceButton}"
                            Height="28" MinWidth="80" Padding="12,2" Margin="0,0,8,0"/>
                    <!-- OutlineButton, not PrimaryButton: hollow by default, fills with the accent
                         on hover. Matches the Scan button and the status-bar Install button, which
                         were already the only other buttons in the app. -->
                    <Button x:Name="OkButton" Content="{DynamicResource Str_Btn_Install}" Click="OK_Click"
                            Style="{StaticResource OutlineButton}"
                            Height="28" MinWidth="80" Padding="12,2"/>
                </StackPanel>
            </Grid>
        </Grid>
    </kui:PickerBorder>
</Window>
