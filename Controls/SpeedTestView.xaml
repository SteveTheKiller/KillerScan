<UserControl x:Class="KillerScan.Controls.SpeedTestView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" KeyDown="View_KeyDown">
 <StackPanel x:Name="ContentPanel" Margin="24" MaxWidth="680" VerticalAlignment="Top">
  <TextBlock Text="{DynamicResource Str_Speed_Title}" FontSize="22" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/>
  <UniformGrid Columns="3" Margin="0,28,0,24">
   <StackPanel Margin="4"><TextBlock Text="{DynamicResource Str_Speed_Download}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="DownloadValue" FontSize="28" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="Mbps" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/></StackPanel>
   <StackPanel Margin="4"><TextBlock Text="{DynamicResource Str_Speed_Upload}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="UploadValue" FontSize="28" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="Mbps" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/></StackPanel>
   <StackPanel Margin="4"><TextBlock Text="{DynamicResource Str_Speed_Latency}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/><TextBlock x:Name="IdleValue" FontSize="28" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/><TextBlock Text="ms" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/></StackPanel>
  </UniformGrid>
  <ProgressBar x:Name="TestProgress" Height="4" Minimum="0" Maximum="100" Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource CardBorderBrush}"/>
  <TextBlock x:Name="Status" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,14" Foreground="{DynamicResource MutedTextBrush}"/>
  <WrapPanel HorizontalAlignment="Center">
   <Button x:Name="StartButton" Content="{DynamicResource Str_Speed_Start}" Style="{DynamicResource PrimaryButton}" Click="Start_Click" Margin="4"/>
   <Button x:Name="StopButton" Content="{DynamicResource Str_Speed_Stop}" Style="{DynamicResource OutlineButton}" Click="Stop_Click" Visibility="Collapsed" Margin="4"/>
   <Button x:Name="CopyButton" Content="{DynamicResource Str_Speed_Copy}" Style="{DynamicResource OutlineButton}" Click="Copy_Click" Visibility="Collapsed" Margin="4"/>
  </WrapPanel>
 </StackPanel>
</UserControl>
