<Window x:Class="KillerScan.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About KillerScan"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Grain over the whole card -->
            <Border Grid.RowSpan="3" IsHitTestVisible="False" CornerRadius="6"
                    Opacity="{DynamicResource GrainOpacity}"
                    Background="{DynamicResource GrainTileBrush}"/>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BackgroundBrush}"
                    CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0">
                    <TextBlock Text="About" Foreground="{StaticResource MutedTextBrush}"
                               FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                    <Button Content="&#x2715;" Click="Close_Click"
                            HorizontalAlignment="Right" Width="28" FontSize="10"
                            Foreground="{StaticResource MutedTextBrush}"
                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent" CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#C42B1C"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="26,22,26,8">
                <TextBlock FontFamily="Consolas" FontSize="30" FontWeight="Bold"><Run Text="Killer" Foreground="{StaticResource TextBrush}"/><Run Text="Scan" Foreground="{StaticResource PrimaryBrush}"/></TextBlock>
                <TextBlock Text="Network Scanner" Foreground="{StaticResource MutedTextBrush}"
                           FontFamily="Consolas" FontSize="12" Margin="0,0,0,16"/>

                <TextBlock Foreground="{StaticResource DimTextBrush}" FontSize="10" Text="VERSION" FontFamily="Consolas"/>
                <TextBlock x:Name="VersionText" Foreground="{StaticResource TextBrush}"
                           FontFamily="Consolas" FontSize="13" Margin="0,0,0,12"/>

                <TextBlock Text="ARP + IP sweep with vendor lookup, device classification, and a themeable, sortable HTML export. Portable, single-file, no telemetry."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,14"/>

                <TextBlock Foreground="{StaticResource DimTextBrush}" FontSize="10" Text="SHA-256 (this build)" FontFamily="Consolas"/>
                <TextBlock x:Name="HashText" Foreground="{StaticResource MutedTextBrush}"
                           FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <TextBlock FontFamily="Consolas" FontSize="12">
                    <Hyperlink NavigateUri="https://scan.killertools.net" RequestNavigate="Link_Navigate"
                               Foreground="{StaticResource PrimaryBrush}" TextDecorations="None">scan.killertools.net</Hyperlink>
                    <Run Text="   ·   " Foreground="{StaticResource DimTextBrush}"/>
                    <Hyperlink NavigateUri="https://thekiller.net" RequestNavigate="Link_Navigate"
                               Foreground="{StaticResource PrimaryBrush}" TextDecorations="None">thekiller.net</Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="26,4,26,18">
                <TextBlock Text="&#x00A9; 2026 Steve the Killer" Foreground="{StaticResource TextFooter}"
                           FontFamily="Consolas" FontSize="10.5" VerticalAlignment="Center"/>
                <Button Content="Close" Click="Close_Click"
                        Style="{StaticResource OutlineButton}"
                        HorizontalAlignment="Right" Width="84"/>
            </Grid>
        </Grid>
    </Border>
</Window>
