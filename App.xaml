<Application x:Class="KillerScan.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KillerScan.Controls"
>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] Theme COLORS (swapped in place at startup by ThemeManager). -->
                <ResourceDictionary Source="Themes/Dark.xaml"/>
                <!-- [1] Strings base (chosen locale layered on top at startup by LocaleManager.Initialize). -->
                <ResourceDictionary Source="Strings/en-US.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ================================================================
                 Control styles - theme-INDEPENDENT, kept out of the swapped
                 theme dictionary. All brush references use DynamicResource so a
                 live theme/accent change repaints them automatically.
                 ================================================================ -->

            <!-- Shared film-grain tile. ImageSource is assigned once at startup
                 (WindowChrome.ApplyGrainTexture) so global styles - like the
                 context menus - can layer the same grain as the chrome/flyouts. -->
            <ImageBrush x:Key="GrainTileBrush" TileMode="Tile"
                        ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>

            <!-- Elevation for the content pane, cast DOWN onto the footer. ShadowDepth must be
                 non-zero with Direction 270; a zero depth is a halo with nothing below to land on. -->
            <DropShadowEffect x:Key="PaneShadow" Color="Black" BlurRadius="16" ShadowDepth="5" Direction="270" Opacity="0.6"/>

            <!-- KillerUI scrollbar thumb floor: keeps the thumb grabbable on large documents. -->
            <controls:ThumbViewportFloorConverter x:Key="ThumbFloor"/>

            <!-- Device type: stored English value in, localized label out. Display only - nothing
                 that persists, colors, filters or exports goes through it (DeviceTypeConverter). -->
            <controls:DeviceTypeConverter x:Key="DeviceTypeLoc"/>
            <controls:VendorConverter x:Key="VendorLoc"/>

            <!-- Typewriter wordmark font (bundled in Fonts/). -->
            <FontFamily x:Key="WordmarkFont">/KillerScan;component/Fonts/#Typewriter - a602 (dead postman 2004)</FontFamily>

            <!-- Global themed tooltip (replaces the plain system box). Implicit (no key) so every
                 tooltip app-wide picks it up; brushes are DynamicResource so it follows theme + accent. -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="HasDropShadow" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.45"/>
                                </Border.Effect>
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- DataGrid Row Style. Rows are translucent so the pane grain shows through. -->
            <Style x:Key="DarkDataGridRow" TargetType="DataGridRow">
                <Setter Property="Background" Value="{DynamicResource TableRowBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource RowAltBrush}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TableHoverTextBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- DataGrid Cell Style -->
            <Style x:Key="DarkDataGridCell" TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource TableHoverTextBrush}"/>
                    </DataTrigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ThemedDataGridColumnHeader" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource TableHeaderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="BorderBrush" Value="{DynamicResource HeaderLineBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Grid>

                            <Border IsHitTestVisible="False" Panel.ZIndex="2"
                                    BorderBrush="{DynamicResource BevelLightBrush}"
                                    BorderThickness="{DynamicResource BevelLightThickness}"/>
                            <Border IsHitTestVisible="False" Panel.ZIndex="2"
                                    BorderBrush="{DynamicResource BevelDarkBrush}"
                                    BorderThickness="{DynamicResource BevelDarkThickness}"/>
                            <Border x:Name="hdrBg"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    <TextBlock x:Name="sortGlyph" Grid.Column="1"
                                               Text="&#x25B2;" FontSize="8"
                                               VerticalAlignment="Center" Margin="6,1,0,0"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                                   Width="8" Margin="-4,0,0,0" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                                   Width="8" Margin="0,0,-4,0" Cursor="SizeWE">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="SortDirection" Value="Ascending">
                                    <Setter TargetName="sortGlyph" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="sortGlyph" Property="Text" Value="&#x25B2;"/>
                                </Trigger>
                                <Trigger Property="SortDirection" Value="Descending">
                                    <Setter TargetName="sortGlyph" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="sortGlyph" Property="Text" Value="&#x25BC;"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="hdrBg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="hdrBg" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary Button Style -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- Hover/press are a translucent tint OVER the accent, so the feedback
                                 works whatever the palette says. All 15 accent files set
                                 PrimaryHoverBrush == PrimaryBrush, so the old brush swap was a
                                 no-op and this button had never shown a hover. Ported from
                                 KillerShell. (2026-07-30) -->
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Grid>
                                    <Border x:Name="tint" CornerRadius="{DynamicResource ControlCornerRadius}" Background="Transparent"/>
                                    <!-- RAISED bevel, so the brushes are PAIRED with their slots:
                                         light on top+left, dark on bottom+right. Both thicknesses
                                         are 0 and both brushes transparent on every theme but
                                         98SE, so this draws nothing and costs nothing elsewhere. -->
                                    <Border BorderBrush="{DynamicResource BevelLightBrush}"
                                            BorderThickness="{DynamicResource BevelLightThickness}"/>
                                    <Border BorderBrush="{DynamicResource BevelDarkBrush}"
                                            BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="tint" Property="Background" Value="#2EFFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="tint" Property="Background" Value="#38000000"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Outline Button (green border + green text, transparent bg - matches killertools search) -->
            <!-- Hollow at rest, filling with the accent on hover. Background is Transparent, NOT
                 RowSelectedBrush: that key is the wash behind a selected LIST ROW, and on the
                 grunge palettes ported from KillerShell it is #44ffffff, a 27% white overlay.
                 Correct for a table row, and on a dark theme it turns this button into a light
                 gray block - which is what it did on Delirium. A hollow button has no fill by
                 definition, so there was never a brush to look up here. -->
            <Style x:Key="OutlineButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource OutlineFaceBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource OutlineTextBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="14,5"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource OutlineRestBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Grid>
                                    <!-- RAISED bevel - paired, see PrimaryButton. The padding moved
                                         off the Border and onto the content: a bevel belongs at the
                                         button's edge, and inside a padded Border it would be inset
                                         by the padding twice over. -->
                                    <Border BorderBrush="{DynamicResource BevelLightBrush}"
                                            BorderThickness="{DynamicResource BevelLightThickness}"/>
                                    <Border BorderBrush="{DynamicResource BevelDarkBrush}"
                                            BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Reactive toggle: hover FILLS with the outline color (contrast text);
                                     mousedown REVERTS to the outline look; release returns to the fill.
                                     Order matters - IsPressed must come after IsMouseOver to win. -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource OutlineHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource OutlineHoverTextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource OutlinePressedBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource OutlineTextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Scan-session tab. Active tab adopts the pane color so it reads as attached to the grid. -->
            <Style x:Key="TabButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Margin" Value="0,4,3,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="Transparent" CornerRadius="{DynamicResource TabCornerRadius}" Padding="11,5">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource PaneBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TabCloseBtn" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
                <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}"/>
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="cb" Background="Transparent" CornerRadius="{DynamicResource SmallCornerRadius}" Width="15" Height="15">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cb" Property="Background" Value="#C42B1C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TabNewBtn" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="4,4,0,0"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="nb" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}" Width="24" Height="22">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="nb" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Surface Button (secondary): fill one tier lighter than what it sits on, a dim border, and a
                 hover that dims rather than colors. Accent on hover belongs to OutlineButton and
                 PrimaryButton; a secondary button that lights up accent reads as the primary action. -->
            <Style x:Key="SurfaceButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource PaneBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Order matters: IsPressed after IsMouseOver so it wins. -->
                                <!-- A real fill change, not an opacity fade - the fade is invisible
                                     on a dark panel and the button reads as dead. (2026-07-30) -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Themed checkbox: small square, accent check. The family style, matching
                 KillerNotes/Controls.xaml, KillerFind/Controls.xaml and the KillerUI kit, so the
                 install dialog's "all users" box stops rendering as a stock Windows control.
                 Untyped (no x:Key) so every CheckBox in the app picks it up. Font is left to the
                 caller rather than forced to Consolas, since this one sits in dialog body copy. -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="box" Width="15" Height="15" CornerRadius="{DynamicResource SmallCornerRadius}" VerticalAlignment="Center"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                                    <TextBlock x:Name="check" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{DynamicResource OnPrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="box" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </Trigger>
                                <!-- Locked on because a machine-wide install already exists: keep the
                                     accent fill so it does not read as unavailable, just not clickable. -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.75"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- TextBox Style (inputs use the mid surface so they read on the dark chrome toolbar) -->
            <Style x:Key="DarkTextBox" TargetType="TextBox">
                <!-- TextFieldBrush, not SurfaceBrush: a Win98 field is WHITE against the face
                     gray, which is most of what makes it read as somewhere you type. Every flat
                     theme sets this to its own bar surface, so nothing changes there. -->
                <Setter Property="Background" Value="{DynamicResource TextFieldBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}"/>
                <Setter Property="SelectionOpacity" Value="0.3"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Grid>
                                    <!-- SUNKEN bevel, so the brushes are CROSSED against their
                                         slots: the DARK brush goes in the Light (top+left) slot and
                                         the light brush in the Dark (bottom+right) one. That
                                         inversion is the whole difference between a Win98 field you
                                         type into and a button you press, and pairing them by name
                                         here is what makes a recess stand proud instead. -->
                                    <Border BorderBrush="{DynamicResource BevelDarkBrush}"
                                            BorderThickness="{DynamicResource BevelLightThickness}"/>
                                    <Border BorderBrush="{DynamicResource BevelLightBrush}"
                                            BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="{TemplateBinding Padding}"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Hover first, focus second: a focused box keeps the accent border even while hovered -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dual-mode family scrollbar: the existing thin overlay on ordinary themes and
                 the full 16px arrow/track/beveled-thumb control on 98SE. -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}"/>
                <Setter Property="Width" Value="{DynamicResource ScrollBarThickness}"/>
                <Setter Property="MinWidth" Value="{DynamicResource ScrollBarThickness}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <RepeatButton x:Name="ArrowUp" Grid.Row="0" Grid.Column="1"
                                              Command="ScrollBar.LineUpCommand" Focusable="False" IsTabStop="False"
                                              Width="{DynamicResource ScrollArrowSize}" Height="{DynamicResource ScrollArrowSize}"
                                              Content="5" FontFamily="Marlett" FontSize="10"
                                              TextOptions.TextRenderingMode="Aliased"
                                              TextOptions.TextFormattingMode="Display"
                                              Foreground="{DynamicResource CaptionGlyphBrush}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid>
                                                <Border Background="{DynamicResource SortButtonBrush}"/>
                                                <Border BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                                                <Border BorderBrush="{DynamicResource BevelDarkBrush}" BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>

                                <RepeatButton x:Name="ArrowDown" Grid.Row="2" Grid.Column="1"
                                              Command="ScrollBar.LineDownCommand" Focusable="False" IsTabStop="False"
                                              Width="{DynamicResource ScrollArrowSize}" Height="{DynamicResource ScrollArrowSize}"
                                              Content="6" FontFamily="Marlett" FontSize="10"
                                              TextOptions.TextRenderingMode="Aliased"
                                              TextOptions.TextFormattingMode="Display"
                                              Foreground="{DynamicResource CaptionGlyphBrush}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid>
                                                <Border Background="{DynamicResource SortButtonBrush}"/>
                                                <Border BorderBrush="{DynamicResource BevelLightBrush}" BorderThickness="{DynamicResource BevelLightThickness}"/>
                                                <Border BorderBrush="{DynamicResource BevelDarkBrush}" BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>

                                <Track x:Name="PART_Track" Grid.Row="1" Grid.Column="1" IsDirectionReversed="True"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value}">
                                    <Track.ViewportSize>
                                        <MultiBinding Converter="{StaticResource ThumbFloor}" ConverterParameter="64">
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ViewportSize"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Minimum"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualHeight"/>
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Orientation"/>
                                        </MultiBinding>
                                    </Track.ViewportSize>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton x:Name="PageBack" Command="ScrollBar.PageUpCommand" Focusable="False" IsTabStop="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton x:Name="PageForward" Command="ScrollBar.PageDownCommand" Focusable="False" IsTabStop="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Style>
                                                <Style TargetType="Thumb">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Grid>
                                                                    <Border x:Name="thumbBorder"
                                                                            Background="{DynamicResource ScrollThumbBrush}"
                                                                            CornerRadius="{DynamicResource ScrollThumbRadius}"
                                                                            Margin="{DynamicResource ScrollThumbMargin}"/>
                                                                    <Border IsHitTestVisible="False" Margin="{DynamicResource ScrollThumbMargin}"
                                                                            BorderBrush="{DynamicResource ScrollTrackBevelLight}"
                                                                            BorderThickness="{DynamicResource BevelLightThickness}"/>
                                                                    <Border IsHitTestVisible="False" Margin="{DynamicResource ScrollThumbMargin}"
                                                                            BorderBrush="{DynamicResource ScrollTrackBevelDark}"
                                                                            BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                                                </Grid>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type ScrollBar}}}" Value="Horizontal">
                                                                        <Setter TargetName="thumbBorder" Property="Margin" Value="{DynamicResource ScrollThumbMarginH}"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="thumbBorder" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                                                                        <Setter TargetName="thumbBorder" Property="Margin" Value="{DynamicResource ScrollThumbHoverMargin}"/>
                                                                        <Setter TargetName="thumbBorder" Property="Effect" Value="{DynamicResource ScrollThumbHoverEffect}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- A vertical track counts downward, so it needs IsDirectionReversed;
                                     a horizontal one counts rightward and must not, or dragging the thumb
                                     left scrolls the content right. The paging commands flip with it. -->
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter TargetName="PART_Track"   Property="IsDirectionReversed" Value="False"/>
                                    <Setter TargetName="PageBack"     Property="Command" Value="ScrollBar.PageLeftCommand"/>
                                    <Setter TargetName="PageForward"  Property="Command" Value="ScrollBar.PageRightCommand"/>
                                    <Setter TargetName="ArrowUp" Property="Grid.Row" Value="1"/>
                                    <Setter TargetName="ArrowUp" Property="Grid.Column" Value="0"/>
                                    <Setter TargetName="ArrowUp" Property="Content" Value="3"/>
                                    <Setter TargetName="ArrowUp" Property="Command" Value="ScrollBar.LineLeftCommand"/>
                                    <Setter TargetName="ArrowDown" Property="Grid.Row" Value="1"/>
                                    <Setter TargetName="ArrowDown" Property="Grid.Column" Value="2"/>
                                    <Setter TargetName="ArrowDown" Property="Content" Value="4"/>
                                    <Setter TargetName="ArrowDown" Property="Command" Value="ScrollBar.LineRightCommand"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Height" Value="{DynamicResource ScrollBarThickness}"/>
                        <Setter Property="MinHeight" Value="{DynamicResource ScrollBarThickness}"/>
                        <Setter Property="Width" Value="Auto"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Dark Context Menu -->
            <Style TargetType="ContextMenu">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="HasDropShadow" Value="False"/>
                <!-- Compensates MenuRoot's shadow halo so the card lands where it did when that
                     halo was a uniform 6. Only the DIFFERENCE matters. -->
                <Setter Property="HorizontalOffset" Value="-16"/>
                <Setter Property="VerticalOffset" Value="-12"/>
                <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource MenuBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Padding" Value="0,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <!-- Margin gives the drop shadow room; grain + rounding + shadow match the theme flyout.
                                 FADE IN: a ContextMenu has no PopupAnimation property - it is not a
                                 Popup, it is hosted inside one WPF owns - so the fade is driven from
                                 the template with an EventTrigger on Loaded. Submenus already faded,
                                 so a menu appeared instantly while its own children faded in, which
                                 is backwards. 150ms ease-out. (2026-07-30) -->
                            <!-- Halo sized to the 22/4 shadow below: WPF expands render bounds by
                                 the FULL BlurRadius, so 22 each way, less the 4px lift off the top
                                 and plus it on the bottom. A uniform 6 clipped every edge. -->
                            <Border x:Name="MenuRoot" Opacity="1" Margin="22,18,22,26" CornerRadius="{DynamicResource PanelCornerRadius}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.55"/>
                                </Border.Effect>
                                <Grid>
                                    <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PaneGrainCornerRadius}"
                                            Background="{DynamicResource GrainTileBrush}"
                                            Opacity="{DynamicResource GrainOpacity}"/>
                                    <!-- RAISED bevel - a Win98 menu stands off the window. Paired
                                         with their slots, and zero on every other theme. -->
                                    <Border IsHitTestVisible="False"
                                            BorderBrush="{DynamicResource BevelLightBrush}"
                                            BorderThickness="{DynamicResource BevelLightThickness}"/>
                                    <Border IsHitTestVisible="False"
                                            BorderBrush="{DynamicResource BevelDarkBrush}"
                                            BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                    <StackPanel IsItemsHost="True" Margin="{TemplateBinding Padding}"
                                                KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <EventTrigger RoutedEvent="ContextMenu.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Release Opacity after the fade. Holding an opacity animation
                                                 keeps the popup on a bitmap-composited surface and softens text. -->
                                            <DoubleAnimation Storyboard.TargetName="MenuRoot" Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.15" FillBehavior="Stop">
                                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="MenuItem">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <!-- TextBrush, not MenuTextBrush: menu items are body text, not secondary
                     labels. Family standard, see KillerUI/README.md surface rules. -->
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <!-- 8 on the left, not 24: the 16px icon gutter provides the inset now. Family
                     standard, matching KillerPDF. -->
                <Setter Property="Padding" Value="8,6,10,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="bg" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}" CornerRadius="{DynamicResource SmallCornerRadius}" SnapsToDevicePixels="True">
                                <!-- Icon gutter. The column is Auto and the presenter collapses when
                                     an item has no Icon, so menus that don't use icons keep their
                                     exact previous layout.

                                     The Popup below is what makes submenus work at all. This
                                     template sets OverridesDefaultStyle, so WPF's stock MenuItem
                                     template - and with it the submenu Popup - is discarded; without
                                     replacing it here, an item with children highlights on hover but
                                     can never open. That is why "Set Device Type" did nothing. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16"/>     <!-- icon gutter -->
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>   <!-- shortcut -->
                                        <ColumnDefinition Width="Auto"/>   <!-- submenu chevron -->
                                    </Grid.ColumnDefinitions>
                                    <!-- Fixed 16, not Auto: the gutter is reserved whether or not an
                                         item carries an icon, so headers line up down the menu and
                                         across the apps. -->
                                    <ContentPresenter x:Name="ico" Grid.Column="0" ContentSource="Icon"
                                                      TextElement.FontFamily="Segoe MDL2 Assets"
                                                      TextElement.FontSize="12"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="check" Grid.Column="0" Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               VerticalAlignment="Center" HorizontalAlignment="Left"
                                               Visibility="Collapsed"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"/>
                                    <!-- Keyboard shortcut, right-aligned. This column was missing
                                         entirely, so InputGestureText never rendered - the family
                                         standard is icons left, shortcuts right (KillerPDF).
                                         Added 2026-07-30. -->
                                    <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                               VerticalAlignment="Center" Margin="24,0,0,0"/>
                                    <!-- Submenu chevron, shown only when the item actually has children -->
                                    <TextBlock x:Name="arrow" Grid.Column="3" Text="&#xE76C;"
                                               FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Margin="18,0,0,0" VerticalAlignment="Center"
                                               Visibility="Collapsed"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                    <Popup x:Name="sub" Grid.Column="2"
                                           Placement="Right" HorizontalOffset="-18" VerticalOffset="-22"
                                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                           AllowsTransparency="True" Focusable="False"
                                           PopupAnimation="Fade">
                                        <!-- Same chrome as the ContextMenu template: halo sized to the
                                             22/4 shadow, rounded, grain overlay. The offsets above
                                             carry the -16,-12 compensation on top of this popup's
                                             own -2,-10 placement. -->
                                        <Border Margin="22,18,22,26" CornerRadius="{DynamicResource PanelCornerRadius}"
                                                Background="{DynamicResource MenuBackgroundBrush}"
                                                BorderBrush="{DynamicResource MenuBorderBrush}"
                                                BorderThickness="1" SnapsToDevicePixels="True">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="4"
                                                                  Direction="270" Opacity="0.55"/>
                                            </Border.Effect>
                                            <Grid>
                                                <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PaneGrainCornerRadius}"
                                                        Background="{DynamicResource GrainTileBrush}"
                                                        Opacity="{DynamicResource GrainOpacity}"/>
                                                <StackPanel IsItemsHost="True" Margin="0,4"
                                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                            </Grid>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- SELECTION, not a gray wash - solid SelectionBg fill with
                                     SelectionFg text, the same treatment a selected tool or tab
                                     gets. The gesture and chevron are recolored too: they are
                                     MutedTextBrush at rest, which is unreadable on a saturated
                                     fill. Family standard, see KillerUI. (2026-07-30) -->
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource SelectionBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                    <Setter TargetName="Gesture" Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                    <Setter TargetName="arrow" Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                </Trigger>
                                <!-- Collapse the shortcut column when there is no gesture, so items
                                     without one do not reserve its 24px margin as phantom padding. -->
                                <Trigger Property="InputGestureText" Value="">
                                    <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <!-- The template had no disabled state, so a grayed-out item looked
                                     identical to a live one. Needed by the themed system menu
                                     (Restore/Maximize/Move/Size switch on window state), and it
                                     also fixes the results grid's Rescan item, which is disabled
                                     mid-scan but gave no visual sign of it. -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                                <Trigger Property="Icon" Value="{x:Null}">
                                    <Setter TargetName="ico" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <!-- Only a parent item gets the chevron. -->
                                <Trigger Property="HasItems" Value="True">
                                    <Setter TargetName="arrow" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="ico" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- NOTE: inside a Menu or ContextMenu, WPF does NOT use this implicit style - it
                 looks up MenuItem.SeparatorStyleKey and falls back to the stock Aero separator,
                 which is the light gray line that showed up in the themed window menu. The keyed
                 alias just below is what actually applies in menus; this one covers separators
                 used anywhere else. -->
            <Style TargetType="Separator">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Height" Value="1"/>
                <Setter Property="Margin" Value="8,4"/>
                <Setter Property="Background" Value="{DynamicResource MenuBorderBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Background="{TemplateBinding Background}"
                                    Height="{TemplateBinding Height}"
                                    Margin="{TemplateBinding Margin}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The key WPF actually resolves for a Separator sitting in a menu. Same look as
                 above; registering it here is what stops the stock light-gray line. -->
            <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator"
                   BasedOn="{StaticResource {x:Type Separator}}"/>

            <!-- Glyph for a MenuItem.Icon. Keeps the 30-odd icons in the context menus to one
                 line each and puts the size/color in one place. Every codepoint used with this
                 was checked against the installed Segoe MDL2 Assets before being adopted. -->
            <Style x:Key="MenuIcon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <!-- MenuIcon has its own local foreground, so the MenuItem template's
                         highlighted foreground cannot reach it through inheritance. Follow the
                         selected label explicitly (black on Ectoplasm's yellow selection). -->
                    <DataTrigger Binding="{Binding IsHighlighted, RelativeSource={RelativeSource AncestorType=MenuItem}}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Card Border Style -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}"/>
                <Setter Property="Padding" Value="12,8"/>
            </Style>

            <!-- ================================================================
                 Rail button (the 24px column down the left of the content area).
                 Family standard, ported from KillerNotes 2026-08-11: a bare glyph
                 with a soft shadow, accent on hover, and Tag="on" lighting a
                 toggle whose panel is open. 20 logical hugs the 16px glyphs, so
                 the 24px column leaves a 2px inset per side and the app-wide zoom
                 scales icons rather than blank strip.
                 ================================================================ -->
            <Style x:Key="RailButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Width" Value="20"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <TextBlock Text="{TemplateBinding Content}"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           TextOptions.TextFormattingMode="Display"
                                           TextOptions.TextRenderingMode="ClearType"
                                           UseLayoutRounding="True" SnapsToDevicePixels="True"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Direction="270"
                                                          Opacity="{DynamicResource IconShadowOpacity}"/>
                                    </TextBlock.Effect>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="on">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================================================================
                 Theme radio row - the family theme picker, ported from KillerShell
                 2026-08-11. Twelve themes do not fit a row of dots, and a dot for a
                 grunge palette would have to be an invented color; a named row needs
                 neither. The name comes from Str_Theme_*, shared key for key with
                 KillerShell and KillerNotes.

                 The row Border is Transparent, NOT a well brush: painting a well
                 across the whole row is what turned every option into a white pill
                 on 98SE in KillerShell. The well ellipse below is where it belongs.

                 CornerRadius 4 and the transparent well are literals for now. Both
                 want to be palette tokens (SmallCornerRadius / RadioWellBrush) when
                 the geometry pass tokenizes this app for 98SE; every theme KillerScan
                 currently ships is flat, so there is nothing to drift today.
                 ================================================================ -->
            <Style x:Key="ThemeRadio" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}"
                                    Margin="-8,0,2,0" Padding="10,3,10,3">
                                <DockPanel LastChildFill="True" Background="Transparent">
                                    <Grid Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left">
                                        <Ellipse Width="14" Height="14" Fill="Transparent"/>
                                        <Ellipse x:Name="ring" Width="14" Height="14"
                                                 Stroke="{DynamicResource DimTextBrush}" StrokeThickness="1.5"
                                                 Fill="Transparent"/>
                                        <Ellipse x:Name="dot" Width="7" Height="7"
                                                 Fill="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                                    </Grid>
                                    <ContentPresenter x:Name="label" VerticalAlignment="Center">
                                        <ContentPresenter.Effect>
                                            <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Direction="270"
                                                              Opacity="{DynamicResource IconShadowOpacity}"/>
                                        </ContentPresenter.Effect>
                                    </ContentPresenter>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                                    <!-- The text must change WITH the wash: 98SE's MenuHoverBrush is
                                         solid navy, and the resting TextBrush there is black -
                                         black-on-navy was unreadable. Family rule from CLAUDE.md:
                                         the Combo token, never PrimaryBrush, because 98SE's
                                         PrimaryBrush IS that navy. -->
                                    <Setter Property="Foreground" Value="{DynamicResource ComboHighlightTextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    <!-- A shadow muddies dark selected text on bright fills such as
                                         Ectoplasm's yellow. Keep depth on idle labels, not selection. -->
                                    <Setter TargetName="label" Property="Effect" Value="{x:Null}"/>
                                </Trigger>
                                <!-- Checked AND hovered: ring, dot and label take RadioHoverFgBrush,
                                     which ThemeManager aliases to PrimaryBrush so twelve themes are
                                     unchanged. Sepulchre's accent sits on its own hover teal, so it
                                     sets the key to white. Declared last so it wins both single triggers. -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource RadioHoverFgBrush}"/>
                                    <Setter TargetName="dot" Property="Fill" Value="{DynamicResource RadioHoverFgBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource RadioHoverFgBrush}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Theme swatch. Still used for the ACCENT dots; the theme picker itself
                 moved to the named ThemeRadio rows above. Background = the color;
                 BorderBrush/Thickness form the active ring (set in code). -->
            <Style x:Key="ThemeSwatch" TargetType="Button">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Margin" Value="0,0,7,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <!-- A Border with a bound CornerRadius, not an Ellipse: the radius comes
                             from AccentSwatchCornerRadius, which is 9 on every flat theme (a
                             circle at 15px) and 0 on 98SE, where the dots have to be square.
                             An Ellipse cannot be squared, which is why KillerNotes' AccentDot is
                             built this way too. -->
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="dot"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource AccentSwatchCornerRadius}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="dot" Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="dot" Property="BorderThickness" Value="3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- KillerUI caption buttons (Segoe MDL2 glyphs, hover fill, red close). -->
            <SolidColorBrush x:Key="DangerRed" Color="#e04444"/>

            <!-- Caption buttons, ported from KillerShell 2026-08-11. Every metric is a token, so
                 98SE turns these from 44x36 flush strips into the 18x16 beveled buttons Win98 had,
                 gapped and inset from the frame, without a second template. Flat-theme values come
                 from Themes/Defaults.xaml.

                 Foreground is TextBrush rather than a CaptionGlyphBrush token on purpose: 98SE
                 wants a black glyph and its TextBrush is already black, so one key does both jobs
                 and there is one less thing to keep in step. -->
            <Style x:Key="ChromeButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource CaptionButtonBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin" Value="{DynamicResource CaptionButtonMargin}"/>
                <Setter Property="Width" Value="{DynamicResource CaptionButtonWidth}"/>
                <Setter Property="Height" Value="{DynamicResource CaptionButtonHeight}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- RAISED bevel, paired with its slots. Zero everywhere but 98SE. -->
                                <Border IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource BevelLightBrush}"
                                        BorderThickness="{DynamicResource BevelLightThickness}"/>
                                <Border IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource BevelDarkBrush}"
                                        BorderThickness="{DynamicResource BevelDarkThickness}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Inherits geometry and the bevel from ChromeButton; only the gap and the hover
                 differ, and BOTH come from tokens. On 98SE the shared layer makes this a beveled
                 gray button with a black glyph and a TRANSPARENT hover - Win98's X never turned
                 red, it reacted to being pressed, not hovered. Flat themes keep the red from
                 Themes/Defaults.xaml. No literal colors in this template. -->
            <Style x:Key="ChromeCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
                <Setter Property="Foreground" Value="{DynamicResource CaptionCloseBrush}"/>
                <Setter Property="Margin" Value="{DynamicResource CaptionCloseGap}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource BevelLightBrush}"
                                        BorderThickness="{DynamicResource BevelLightThickness}"/>
                                <Border IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource BevelDarkBrush}"
                                        BorderThickness="{DynamicResource BevelDarkThickness}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CaptionCloseHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource CaptionCloseHoverFgBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Shared close control for the About and keyboard-shortcuts cards. -->
            <Style x:Key="OverlayCloseButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource AboutCloseFg}"/>
                <Setter Property="FontFamily" Value="{DynamicResource AboutCloseFont}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="{DynamicResource CaptionGlyphWeight}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Background="{DynamicResource CaptionButtonBrush}"/>
                                <Border x:Name="bevelLight" IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource BevelLightBrush}"
                                        BorderThickness="{DynamicResource BevelLightThickness}"/>
                                <Border x:Name="bevelDark" IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource BevelDarkBrush}"
                                        BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AboutCloseHoverFg}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bevelLight" Property="BorderBrush" Value="{DynamicResource BevelDarkBrush}"/>
                                    <Setter TargetName="bevelDark" Property="BorderBrush" Value="{DynamicResource BevelLightBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
