<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="GrainOpacity">0.3</sys:Double>
    <sys:Double x:Key="IconShadowOpacity">1.0</sys:Double>

    <!-- App-specific geometry only - see Dark.xaml. -->
    <CornerRadius x:Key="PaneGrainCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="TabCornerRadius">5,5,0,0</CornerRadius>
    <SolidColorBrush x:Key="TextFieldBrush" Color="#454039" po:Freeze="True"/>

    <!-- ================================================================
         SEPULCHRE - ported from KillerShell 2026-08-11. Coffin-wood browns
         edged in copper, under a cold verdigris accent.
           Background = chrome   (#25282b)
           Surface    = bar      (#454039)
           Pane       = content  (#3a352f)

         BackgroundBrush is a gradient in KillerShell and is taken here as
         its FIRST STOP, solid - see the note in Decay.xaml for why.
         ================================================================ -->

    <!-- Accent -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#4faaa8" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#6bb8b6" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#458d8c" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#292d2f" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnPrimaryBrush"      Color="#ffffff" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#4faaa8" po:Freeze="True"/>
    <SolidColorBrush x:Key="InputHoverBrush"     Color="#4faaa8" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextFooter"          Color="#b4b6b1" po:Freeze="True"/>

    <!-- Surface tiers -->
    <SolidColorBrush x:Key="BackgroundBrush"     Color="#25282b" po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfaceBrush"        Color="#454039" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaneBrush"           Color="#3a352f" po:Freeze="True"/>
    <SolidColorBrush x:Key="TableHeaderBrush"    Color="#48433e" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardBorderBrush"     Color="#835a30" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaneBorderBrush"     Color="#4d3d2b" po:Freeze="True"/>
    <SolidColorBrush x:Key="AppBorderBrush"      Color="#44585b" po:Freeze="True"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush"           Color="#f4f4f0" po:Freeze="True"/>
    <SolidColorBrush x:Key="MutedTextBrush"      Color="#d7d7cf" po:Freeze="True"/>
    <SolidColorBrush x:Key="ChromeTextBrush"     Color="#fafaf6" po:Freeze="True"/>
    <SolidColorBrush x:Key="DimTextBrush"        Color="#b4b6b1" po:Freeze="True"/>

    <!-- Grid rows -->
    <SolidColorBrush x:Key="RowAltBrush"         Color="#18ffffff" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowHoverBrush"       Color="#4faaa8" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#44ffffff" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg"         Color="#2d595d" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg"         Color="#ffffff" po:Freeze="True"/>

    <!-- Inputs / menus / scrollbar -->
    <SolidColorBrush x:Key="InputBorderBrush"    Color="#4d3d2b" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#242729" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuBorderBrush"     Color="#4d3d2b" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuTextBrush"       Color="#d7d7cf" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuHoverBrush"      Color="#407b7b" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#44ffffff" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"    Color="#554faaa8" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#4faaa8" po:Freeze="True"/>

    <!-- Device-type label colors (bright, for dark panes) -->
    <SolidColorBrush x:Key="TypeRouter"     Color="#F0A030" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeWindows"    Color="#60A0F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypePrinter"    Color="#D080A0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeSwitch"     Color="#C0C0C0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeHypervisor" Color="#E06060" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeNas"        Color="#40C080" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeIot"        Color="#B060D0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeServer"     Color="#E08050" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeLinux"      Color="#D0C050" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeDns"        Color="#50B0D0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeHa"         Color="#50D0A0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeMobile"     Color="#A0A0F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeCamera"     Color="#F0C060" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeSmarttv"    Color="#E0A0E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeMedia"      Color="#70C0E0" po:Freeze="True"/>

</ResourceDictionary>
