<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="GrainOpacity">0.3</sys:Double>
    <sys:Double x:Key="IconShadowOpacity">1.0</sys:Double>

    <!-- App-specific geometry only - see Dark.xaml. -->
    <CornerRadius x:Key="PaneGrainCornerRadius">5</CornerRadius>
    <CornerRadius x:Key="TabCornerRadius">5,5,0,0</CornerRadius>
    <SolidColorBrush x:Key="TextFieldBrush" Color="#314548" po:Freeze="True"/>

    <!-- ================================================================
         ECTOPLASM - ported from KillerShell 2026-08-11. Cold teal panes
         ringed in cyan, under a sickly yellow accent.
           Background = chrome   (#5e1764)
           Surface    = bar      (#314548)
           Pane       = content  (#293c3f)

         BackgroundBrush is a gradient in KillerShell and is taken here as
         its FIRST STOP, solid - see the note in Decay.xaml for why.
         ================================================================ -->

    <!-- Accent -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#ead900" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#eddf29" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#beb109" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#bd00c6" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnPrimaryBrush"      Color="#1e1f22" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#ead900" po:Freeze="True"/>
    <SolidColorBrush x:Key="InputHoverBrush"     Color="#ead900" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextFooter"          Color="#b4b6b1" po:Freeze="True"/>

    <!-- Surface tiers -->
    <SolidColorBrush x:Key="BackgroundBrush"     Color="#5e1764" po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfaceBrush"        Color="#314548" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaneBrush"           Color="#293c3f" po:Freeze="True"/>
    <SolidColorBrush x:Key="TableHeaderBrush"    Color="#384a4c" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardBorderBrush"     Color="#096366" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaneBorderBrush"     Color="#096366" po:Freeze="True"/>
    <SolidColorBrush x:Key="AppBorderBrush"      Color="#7e0685" po:Freeze="True"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush"           Color="#f4f4f0" po:Freeze="True"/>
    <SolidColorBrush x:Key="MutedTextBrush"      Color="#d7d7cf" po:Freeze="True"/>
    <SolidColorBrush x:Key="ChromeTextBrush"     Color="#fafaf6" po:Freeze="True"/>
    <SolidColorBrush x:Key="DimTextBrush"        Color="#b4b6b1" po:Freeze="True"/>

    <!-- Grid rows -->
    <SolidColorBrush x:Key="RowAltBrush"         Color="#18ffffff" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowHoverBrush"       Color="#25232c" po:Freeze="True"/>
    <!-- Ectoplasm's selected row is the same solid sickly-yellow/black pair used by its
         primary controls. A pale neutral wash made selection look detached from the palette. -->
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#ead900" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg"         Color="#ead900" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg"         Color="#1e1f22" po:Freeze="True"/>

    <!-- Inputs / menus / scrollbar -->
    <SolidColorBrush x:Key="InputBorderBrush"    Color="#096366" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#383838" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuBorderBrush"     Color="#096366" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuTextBrush"       Color="#d7d7cf" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuHoverBrush"      Color="#6f6f6f" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#44ffffff" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"    Color="#55ead900" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#ead900" po:Freeze="True"/>

    <!-- Device-type label colors (bright, for dark panes) -->
    <SolidColorBrush x:Key="TypeRouter"     Color="#F0A030" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeWindows"    Color="#60A0F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypePrinter"    Color="#D080A0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeSwitch"     Color="#C0C0C0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeHypervisor" Color="#E06060" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeNas"        Color="#40C080" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeIot"        Color="#B060D0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeServer"     Color="#E08050" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeLinux"      Color="#D0C050" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeDns"        Color="#50B0D0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeHa"         Color="#50D0A0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeMobile"     Color="#A0A0F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeCamera"     Color="#F0C060" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeSmarttv"    Color="#E0A0E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeMedia"      Color="#70C0E0" po:Freeze="True"/>

</ResourceDictionary>
