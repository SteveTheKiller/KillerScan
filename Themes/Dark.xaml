<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="TextFieldBrush" Color="#101010" po:Freeze="True"/>

    <sys:Double x:Key="GrainOpacity">0.24</sys:Double>
    <sys:Double x:Key="IconShadowOpacity">0.9</sys:Double>

    <!-- Text-stroke shadows behind button labels. Light nulls these: any Effect
         rasterizes ClearType, so on a light surface the label just looks blurry. -->
    <DropShadowEffect x:Key="TextStroke"     Color="Black" BlurRadius="3" ShadowDepth="0.8" Direction="270" Opacity="0.7"/>
    <DropShadowEffect x:Key="TextStrokeSoft" Color="Black" BlurRadius="2" ShadowDepth="0.6" Direction="270" Opacity="0.45"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#22bb56" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#22bb56" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#22bb56" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="HeaderLineBrush" Color="#22bb56" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <!-- Near-black, matching the Black family. This is the text ON a filled accent button, and
         Dark's accents are mid-tone rather than deep: white measures 2.38 to 3.94 across the six
         (blue, teal, orange and purple all under 3), near-black measures 5.32 to 8.83. -->
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#0a0a0a" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="OutlineBtnBrush" Color="#22bb56" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="InputHoverBrush" Color="#707070" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="TextFooter"          Color="#858585" po:Freeze="True"/>

    <!-- Surface tiers -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1c1c1c" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#333333" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="PaneBrush" Color="#3a3a3a" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="TableHeaderBrush" Color="#333333" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#4a4a4a" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="TreeLineBrush"       Color="#3d3d3d" po:Freeze="True"/>
    <SolidColorBrush x:Key="WarnBrush"           Color="#d9a218" po:Freeze="True"/>
    <!-- The status dot's "all fine" green. A real traffic light needs three fixed colors; using
         the accent here meant "fine" was whatever accent you had picked (MainWindow.xaml.cs
         ApplyStatusTone). Muted on purpose - it sits in the footer permanently. -->
    <SolidColorBrush x:Key="OkBrush"             Color="#3fb950" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaneBorderBrush" Color="#555555" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#e0e0e0" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#a3a3a3" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="ChromeTextBrush" Color="#b6b6b6" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="DimTextBrush" Color="#858585" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />

    <!-- Grid rows -->
    <SolidColorBrush x:Key="RowAltBrush" Color="#18FFFFFF" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#404040" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#0d2a18" po:Freeze="True"/>
    <LinearGradientBrush x:Key="SelectionBg" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#387552" Offset="0"/><GradientStop Color="#104E2B" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="SelectionFg" Color="#ffffff" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />

    <!-- Inputs / menus / scrollbar -->
<SolidColorBrush x:Key="InputBorderBrush" Color="#2e2e2e" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
<SolidColorBrush x:Key="MenuBackgroundBrush" Color="#141414" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
<SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#3a3a3a" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
<SolidColorBrush x:Key="MenuBorderBrush" Color="#404040" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="MenuTextBrush"       Color="#a3a3a3" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#404040" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#0d2a18" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"    Color="#5522bb56" po:Freeze="True"/>

    <!-- Resting accent edge: the accent at 40%, for a lip that has to read as accent-colored
         without claiming to be the live thing. The active tab of the UNFOCUSED pane uses it,
         the same way the site's feature cards carry a dim tab-edge until hovered. Every
         accent overlay redefines it, or picking an accent would leave this one behind. -->
    <SolidColorBrush x:Key="TabEdgeBrush"        Color="#6622bb56" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#22bb56" po:Freeze="True"/>

    <!-- Device-type label colors (bright, for dark panes) -->
    <SolidColorBrush x:Key="TypeRouter"     Color="#F0A030" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeWindows"    Color="#60A0F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypePrinter"    Color="#D080A0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeSwitch"     Color="#C0C0C0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeHypervisor" Color="#E06060" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeNas"        Color="#40C080" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeIot"        Color="#B060D0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeServer"     Color="#E08050" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeLinux"      Color="#D0C050" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeDns"        Color="#50B0D0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeHa"         Color="#50D0A0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeMobile"     Color="#A0A0F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeCamera"     Color="#F0C060" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeSmarttv"    Color="#E0A0E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeMedia"      Color="#70C0E0" po:Freeze="True"/>

    <!-- Shortcut categories. One color per group, shared by the list headings and the keyboard
         map's keycap borders (KeyboardMapOverlay.cs), so a key's color tells you what it does
         before you read the caption. -->
    <SolidColorBrush x:Key="KsCatFile"      Color="#00fff9" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatNav"       Color="#8c1eff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatView"      Color="#f222ff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatSearch"    Color="#00b3ff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatEdit"      Color="#ff2975" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatTabs"      Color="#ffd319" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatHelp"      Color="#39ff14" po:Freeze="True"/>

    <CornerRadius x:Key="WindowCornerRadius" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">7</CornerRadius>

    <CornerRadius x:Key="PanelCornerRadius" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">6</CornerRadius>

    <CornerRadius x:Key="ControlCornerRadius" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">4</CornerRadius>

    <CornerRadius x:Key="SmallCornerRadius" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">3</CornerRadius>

    <CornerRadius x:Key="FlyoutCornerRadius">4</CornerRadius>

    <CornerRadius x:Key="AccentSwatchCornerRadius" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">9</CornerRadius>

    <SolidColorBrush x:Key="TitleBarBrush" Color="#1c1c1c" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />

    <SolidColorBrush x:Key="AppBorderBrush" Color="#3f3f3f" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />

    <SolidColorBrush x:Key="ComboHighlightTextBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="AccentLogo"     Color="#1ea54c" po:Freeze="True"/>
    <SolidColorBrush x:Key="RadioAccent"    Color="#22bb56" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionAccent" Color="#22bb56" po:Freeze="True"/>
    <sys:Double x:Key="PaneShadowOpacity" xmlns:sys="clr-namespace:System;assembly=mscorlib">0.6</sys:Double>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#FF404040" po:Freeze="True"/>
    <sys:Double x:Key="TitleBarHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">32</sys:Double>
    <sys:Double x:Key="BarShadowOpacity" xmlns:sys="clr-namespace:System;assembly=mscorlib">0.38</sys:Double>
    <SolidColorBrush x:Key="DialogTitleBarBrush" Color="#FF1C1C1C" po:Freeze="True"/>
    <SolidColorBrush x:Key="FooterBackgroundBrush" Color="#FF1C1C1C" po:Freeze="True"/>
    <sys:Double x:Key="FlyoutShadowOpacity" xmlns:sys="clr-namespace:System;assembly=mscorlib">0.55</sys:Double>
    <sys:Double x:Key="WordmarkShadowOpacity" xmlns:sys="clr-namespace:System;assembly=mscorlib">0.45</sys:Double>
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#FF2E2E2E" po:Freeze="True"/>
    <sys:Double x:Key="TitleWordmarkBoldSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">22.52</sys:Double>
    <sys:Double x:Key="TitleWordmarkSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">15</sys:Double>
    <SolidColorBrush x:Key="FileDialogPaneBrush" Color="#FF3A3A3A" po:Freeze="True"/>
</ResourceDictionary>
