<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <SolidColorBrush x:Key="PrimaryBrush"        Color="#2B2A24" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#484539" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1B1A16" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#C69500" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#2B2A24" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#2B2A24" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#FFD94D" po:Freeze="True"/>
    <LinearGradientBrush x:Key="SelectionBg" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFF5A3" Offset="0"/><GradientStop Color="#FFD43B" Offset="1"/></LinearGradientBrush>

    <SolidColorBrush x:Key="SelectionFg"         Color="#24231C" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#FFF5A3" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"    Color="#886E6650" po:Freeze="True"/>
  <SolidColorBrush x:Key="SelectionAccent" Color="#C69500"/>
  <SolidColorBrush x:Key="RadioAccent" Color="#C69500"/>
    <SolidColorBrush x:Key="AccentLogo" Color="#C69500" po:Freeze="True"/>
    <StaticResource x:Key="ComboHighlightTextBrush" ResourceKey="PrimaryBrush"/>
</ResourceDictionary>
