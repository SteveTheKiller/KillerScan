<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <!-- 98SE family - RED accent, the Win98 maroon rather than a bright red: nothing in the
         period palette was that saturated. Values from KillerShell's Accents/98SE/Red.xaml. -->
    <!-- Caption gradient - see Blue.xaml. -->
    <LinearGradientBrush x:Key="TitleBarBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#700000" Offset="0"/><GradientStop Color="#B05050" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#800000" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#A00000" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#580000" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#800000" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#800000" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg"         Color="#800000" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#800000" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowAltBrush" Color="#08000000" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
    <!-- Hovered row text. 98SE hovers a light gray row, so this is a dark accent tint rather than
         the pale one the dark families use. -->
    <SolidColorBrush x:Key="TableHoverTextBrush" Color="#800000" po:Freeze="True"/>
    <SolidColorBrush x:Key="AccentLogo" Color="#800000"/>
    <SolidColorBrush x:Key="SelectionAccent" Color="#800000"/>
    <SolidColorBrush x:Key="RadioAccent" Color="#800000"/>
    <LinearGradientBrush x:Key="DialogTitleBarBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True"><GradientStop Color="#700000" Offset="0"/><GradientStop Color="#B05050" Offset="1"/></LinearGradientBrush>
</ResourceDictionary>
