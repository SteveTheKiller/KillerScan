<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <LinearGradientBrush x:Key="TitleBarBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#685900" Offset="0"/><GradientStop Color="#847100" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#685900" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#847100" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#4F4300" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#685900" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#685900" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg"         Color="#685900" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#685900" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowAltBrush"         Color="#F1EABF" po:Freeze="True"/>

    <SolidColorBrush x:Key="TableHoverTextBrush" Color="#685900" po:Freeze="True"/>
</ResourceDictionary>
