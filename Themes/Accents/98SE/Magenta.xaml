<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <LinearGradientBrush x:Key="TitleBarBrush" StartPoint="0,0" EndPoint="1,0" po:Freeze="True">
        <GradientStop Color="#750052" Offset="0"/><GradientStop Color="#A52A80" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#750052" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#960069" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#55003B" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#750052" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#750052" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg"         Color="#750052" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#750052" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowAltBrush"         Color="#F1D5E7" po:Freeze="True"/>

    <SolidColorBrush x:Key="TableHoverTextBrush" Color="#750052" po:Freeze="True"/>
</ResourceDictionary>
