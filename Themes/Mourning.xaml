<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="GrainOpacity">0.28</sys:Double>
    <sys:Double x:Key="IconShadowOpacity">0.9</sys:Double>

    <!-- ================================================================
         MOURNING - ported from KillerShell 2026-08-11. Funeral purple with
         a rose accent; the one grunge theme whose BackgroundBrush is solid
         in KillerShell too, so nothing was derived here.
           Background = chrome   (#3b3642)
           Surface    = bar      (#34373e)
           Pane       = content  (#554c5d)  - lighter than the chrome
         ================================================================ -->

    <!-- Accent -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#ff6f91" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#ff86a2" po:Freeze="True"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#e85e80" po:Freeze="True"/>
    <SolidColorBrush x:Key="HeaderLineBrush"     Color="#a0ffe6" po:Freeze="True"/>
    <SolidColorBrush x:Key="OnPrimaryBrush"      Color="#292c31" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlineBtnBrush"     Color="#ffb199" po:Freeze="True"/>
    <SolidColorBrush x:Key="InputHoverBrush"     Color="#f9f871" po:Freeze="True"/>
    <SolidColorBrush x:Key="TextFooter"          Color="#b4b6b1" po:Freeze="True"/>

    <!-- Surface tiers -->
    <SolidColorBrush x:Key="BackgroundBrush"     Color="#3b3642" po:Freeze="True"/>
    <SolidColorBrush x:Key="SurfaceBrush"        Color="#34373e" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaneBrush"           Color="#554c5d" po:Freeze="True"/>
    <SolidColorBrush x:Key="TableHeaderBrush"    Color="#5c5364" po:Freeze="True"/>
    <SolidColorBrush x:Key="CardBorderBrush"     Color="#756b79" po:Freeze="True"/>
    <SolidColorBrush x:Key="PaneBorderBrush"     Color="#756b79" po:Freeze="True"/>
    <SolidColorBrush x:Key="AppBorderBrush"      Color="#756b79" po:Freeze="True"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush"           Color="#f4f4f0" po:Freeze="True"/>
    <SolidColorBrush x:Key="MutedTextBrush"      Color="#d7d7cf" po:Freeze="True"/>
    <SolidColorBrush x:Key="ChromeTextBrush"     Color="#fafaf6" po:Freeze="True"/>
    <SolidColorBrush x:Key="DimTextBrush"        Color="#b4b6b1" po:Freeze="True"/>

    <!-- Grid rows -->
    <SolidColorBrush x:Key="RowAltBrush"         Color="#18ffffff" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowHoverBrush"       Color="#a75167" po:Freeze="True"/>
    <SolidColorBrush x:Key="RowSelectedBrush"    Color="#44ffffff" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionBg"         Color="#ff6f91" po:Freeze="True"/>
    <SolidColorBrush x:Key="SelectionFg"         Color="#292c31" po:Freeze="True"/>

    <!-- Inputs / menus / scrollbar -->
    <SolidColorBrush x:Key="InputBorderBrush"    Color="#756b79" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#4f413f" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuBorderBrush"     Color="#756b79" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuTextBrush"       Color="#d7d7cf" po:Freeze="True"/>
    <SolidColorBrush x:Key="MenuHoverBrush"      Color="#b2556c" po:Freeze="True"/>
    <SolidColorBrush x:Key="OutlinePressedBrush" Color="#44ffffff" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbBrush"    Color="#55ff6f91" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#ff6f91" po:Freeze="True"/>

    <!-- Device-type label colors (bright, for dark panes) -->
    <SolidColorBrush x:Key="TypeRouter"     Color="#F0A030" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeWindows"    Color="#60A0F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypePrinter"    Color="#D080A0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeSwitch"     Color="#C0C0C0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeHypervisor" Color="#E06060" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeNas"        Color="#40C080" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeIot"        Color="#B060D0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeServer"     Color="#E08050" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeLinux"      Color="#D0C050" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeDns"        Color="#50B0D0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeHa"         Color="#50D0A0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeMobile"     Color="#A0A0F0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeCamera"     Color="#F0C060" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeSmarttv"    Color="#E0A0E0" po:Freeze="True"/>
    <SolidColorBrush x:Key="TypeMedia"      Color="#70C0E0" po:Freeze="True"/>

</ResourceDictionary>
