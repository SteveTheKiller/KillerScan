<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <CornerRadius x:Key="WindowCornerRadius">7</CornerRadius><CornerRadius x:Key="PanelCornerRadius">6</CornerRadius><CornerRadius x:Key="ControlCornerRadius">4</CornerRadius><CornerRadius x:Key="SmallCornerRadius">3</CornerRadius><CornerRadius x:Key="FlyoutCornerRadius">0,0,4,4</CornerRadius><CornerRadius x:Key="AccentSwatchCornerRadius">9</CornerRadius>
  <SolidColorBrush x:Key="TitleBarBrush" Color="#001a28"/>
  <SolidColorBrush x:Key="BackgroundBrush" Color="#001a28"/><SolidColorBrush x:Key="SurfaceBrush" Color="#00263a"/><SolidColorBrush x:Key="PaneBrush" Color="#002e48"/><SolidColorBrush x:Key="TableHeaderBrush" Color="#00263a"/>
  <SolidColorBrush x:Key="RowAltBrush" Color="#18FFFFFF"/><SolidColorBrush x:Key="RowHoverBrush" Color="#0a5478"/><SolidColorBrush x:Key="MenuHoverBrush" Color="#0a5478"/>
  <SolidColorBrush x:Key="CardBorderBrush" Color="#183450"/><SolidColorBrush x:Key="PaneBorderBrush" Color="#26507a"/><SolidColorBrush x:Key="AppBorderBrush" Color="#183450"/>
  <SolidColorBrush x:Key="TextBrush" Color="#fffde8"/><SolidColorBrush x:Key="MutedTextBrush" Color="#e0d49a"/><SolidColorBrush x:Key="ChromeTextBrush" Color="#c2d2dc"/><SolidColorBrush x:Key="DimTextBrush" Color="#c0aa68"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="#26507a"/><SolidColorBrush x:Key="InputHoverBrush" Color="#2f6f9c"/><SolidColorBrush x:Key="MenuBackgroundBrush" Color="#001624"/><SolidColorBrush x:Key="MenuBorderBrush" Color="#26507a"/>
  <!-- SelectionBg, PrimaryBrush, PrimaryHoverBrush, PrimaryPressedBrush and OutlineBtnBrush are
       deliberately absent. This layer applies AFTER the app palette, so defining them here
       overwrote Cyanotic's pale yellow accent with white and a saturated blue. Themes/Cyanotic.xaml
       owns the accent; do not restore these keys when re-vendoring. -->
  <SolidColorBrush x:Key="SelectionFg" Color="#ffffff"/><SolidColorBrush x:Key="OnPrimaryBrush" Color="#00263a"/><SolidColorBrush x:Key="HeaderLineBrush" Color="#3aa0d8"/>
</ResourceDictionary>
