<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <CornerRadius x:Key="WindowCornerRadius">7</CornerRadius><CornerRadius x:Key="PanelCornerRadius">6</CornerRadius><CornerRadius x:Key="ControlCornerRadius">4</CornerRadius><CornerRadius x:Key="SmallCornerRadius">3</CornerRadius><CornerRadius x:Key="FlyoutCornerRadius">0,0,4,4</CornerRadius><CornerRadius x:Key="AccentSwatchCornerRadius">9</CornerRadius>
  <SolidColorBrush x:Key="TitleBarBrush" Color="#002115"/>
  <SolidColorBrush x:Key="BackgroundBrush" Color="#002115"/><SolidColorBrush x:Key="SurfaceBrush" Color="#002e1c"/><SolidColorBrush x:Key="PaneBrush" Color="#003824"/><SolidColorBrush x:Key="TableHeaderBrush" Color="#002e1c"/>
  <SolidColorBrush x:Key="RowAltBrush" Color="#18FFFFFF"/><SolidColorBrush x:Key="RowHoverBrush" Color="#00593a"/><SolidColorBrush x:Key="MenuHoverBrush" Color="#00593a"/>
  <SolidColorBrush x:Key="CardBorderBrush" Color="#0f4a30"/><SolidColorBrush x:Key="PaneBorderBrush" Color="#0f4a30"/><SolidColorBrush x:Key="AppBorderBrush" Color="#0f4a30"/>
  <SolidColorBrush x:Key="TextBrush" Color="#fffde8"/><SolidColorBrush x:Key="MutedTextBrush" Color="#e0d49a"/><SolidColorBrush x:Key="ChromeTextBrush" Color="#cfd6c2"/><SolidColorBrush x:Key="DimTextBrush" Color="#c0aa68"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="#0f4a30"/><SolidColorBrush x:Key="InputHoverBrush" Color="#2a7a52"/><SolidColorBrush x:Key="MenuBackgroundBrush" Color="#001e13"/><SolidColorBrush x:Key="MenuBorderBrush" Color="#0f4a30"/>
  <!-- SelectionBg, PrimaryBrush, PrimaryHoverBrush, PrimaryPressedBrush and OutlineBtnBrush are
       deliberately absent. This layer applies AFTER the app palette, so defining them here
       overwrote Greed's pale yellow accent with white and a saturated green. Themes/Greed.xaml
       owns the accent; do not restore these keys when re-vendoring. -->
  <SolidColorBrush x:Key="SelectionFg" Color="#ffffff"/><SolidColorBrush x:Key="OnPrimaryBrush" Color="#002e1c"/><SolidColorBrush x:Key="HeaderLineBrush" Color="#3fbf6f"/>
</ResourceDictionary>
