<!-- KillerScan's own Trash Polka values: keys only KillerScan's views use. ThemeManager.AppTokens
     (Services/AppTheme.cs) merges them over the family palette. Trash Polka uses Dark's neutrals,
     so these match Themes/App/Dark.xaml, plus no shade under the view tabs. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="KsCatViews" Color="#00fff9" />
    <SolidColorBrush x:Key="KsCatScan" Color="#39ff14" />
    <SolidColorBrush x:Key="KsCatDevice" Color="#ffd319" />
    <SolidColorBrush x:Key="KsCatTopology" Color="#f222ff" />
    <SolidColorBrush x:Key="KsCatToolbar" Color="#00b3ff" />
    <SolidColorBrush x:Key="KsCatApp" Color="#ff901f" />
    <!-- No shade under the view tabs: inactive tabs are the inked window background, undarkened. -->
    <sys:Double x:Key="TabStripFadeOpacity">0</sys:Double>
</ResourceDictionary>
