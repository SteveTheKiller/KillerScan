<!-- KillerScan's own theme values: keys only KillerScan's views use. ThemeManager.AppTokens
     (Services/AppTheme.cs) merges the Mourning values over the family palette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="KsCatViews" Color="#00fff9" />
    <SolidColorBrush x:Key="KsCatScan" Color="#39ff14" />
    <SolidColorBrush x:Key="KsCatDevice" Color="#ffd319" />
    <SolidColorBrush x:Key="KsCatTopology" Color="#f222ff" />
    <SolidColorBrush x:Key="KsCatToolbar" Color="#00b3ff" />
    <SolidColorBrush x:Key="KsCatApp" Color="#ff901f" />
</ResourceDictionary>
