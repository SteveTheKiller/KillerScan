<!-- KillerScan's own theme values: keys only KillerScan's views use. ThemeManager.AppTokens
     (Services/AppTheme.cs) merges the Light values over the family palette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="KsCatViews" Color="#009e99" />
    <SolidColorBrush x:Key="KsCatScan" Color="#128c07" />
    <SolidColorBrush x:Key="KsCatDevice" Color="#a67c00" />
    <SolidColorBrush x:Key="KsCatTopology" Color="#a316b5" />
    <SolidColorBrush x:Key="KsCatToolbar" Color="#0077b3" />
    <SolidColorBrush x:Key="KsCatApp" Color="#cc6a00" />
</ResourceDictionary>
