<!-- KillerScan's own theme values: keys only KillerScan's views use. ThemeManager.AppTokens
     (Services/AppTheme.cs) merges the defaults for every theme over the family palette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="TableHoverTextBrush" Color="#ffffff" po:Freeze="True"/>
    <sys:Double x:Key="ScanFrameBandSize">0</sys:Double>
    <SolidColorBrush x:Key="ScanFrameTopBrush" Color="#00000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScanFrameLeftBrush" Color="#00000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScanFrameRightBrush" Color="#00000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScanFrameBottomBrush" Color="#00000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScanOuterKeylineBrush" Color="#00000000" po:Freeze="True"/>
    <Thickness x:Key="ScanOuterKeylineThickness">0</Thickness>
    <sys:Double x:Key="ScanPaneBandSize">0</sys:Double>
    <SolidColorBrush x:Key="ScanPaneTopBrush" Color="#00000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScanPaneLeftBrush" Color="#00000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScanPaneRightBrush" Color="#00000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="ScanPaneBottomBrush" Color="#00000000" po:Freeze="True"/>
    <SolidColorBrush x:Key="ExportButtonBackground" Color="#00000000" po:Freeze="True"/>
    <Visibility x:Key="RailSeparatorVisibility">Visible</Visibility>
    <GridLength x:Key="RailColumnWidth">24</GridLength>
    <sys:Double x:Key="RailWidth">24</sys:Double>
    <Thickness x:Key="RailSeparatorMargin">0,6,0,6</Thickness>
    <Thickness x:Key="DevicesPaneMargin">0,0,8,0</Thickness>
    <Thickness x:Key="ScanTitleBarPadding">5,4,0,0</Thickness>
    <!-- The title-bar scan bar: the bar's content row starts at the padding's top, so a -4 top margin recentres it on the whole bar (2px up). -->
    <Thickness x:Key="ScanTitleToolbarMargin">16,-4,0,0</Thickness>
    <Thickness x:Key="ScanCaptionButtonsMargin">0</Thickness>
    <Thickness x:Key="ScanAboutContentMargin">8,10,8,18</Thickness>
    <Thickness x:Key="ShortcutsScrollBleed">0,0,-24,-12</Thickness>
    <Thickness x:Key="ShortcutsScrollInset">0,0,24,4</Thickness>
    <SolidColorBrush x:Key="KsCatViews"    Color="#00fff9" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatScan"     Color="#39ff14" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatDevice"   Color="#ffd319" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatTopology" Color="#f222ff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatToolbar"  Color="#00b3ff" po:Freeze="True"/>
    <SolidColorBrush x:Key="KsCatApp"      Color="#ff901f" po:Freeze="True"/>
</ResourceDictionary>
