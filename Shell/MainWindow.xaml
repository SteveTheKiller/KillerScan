<Window x:Class="KillerScan.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KillerScan.Shell"
        xmlns:cm="clr-namespace:System.ComponentModel;assembly=System"
        mc:Ignorable="d"
        Title="KillerScan"
        Height="700" Width="1025"
        MinHeight="500" MinWidth="800"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        BorderThickness="0"
        BorderBrush="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Icon="pack://application:,,,/Resources/ks-icon.ico">

    <!-- Native custom chrome (no AllowsTransparency): WPF composites on the GPU and Windows
         draws the drop shadow + rounds the HWND (Win11, via DWMWA_WINDOW_CORNER_PREFERENCE in
         WindowChrome.cs). The 36px title bar becomes the draggable caption; interactive bits in
         it opt back in with WindowChrome.IsHitTestVisibleInChrome. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="8"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- WIN98 WINDOW FRAME, ported from KillerShell verbatim. Zero-thickness / transparent on
         every flat theme (DWM does the edge there); on 98SE it is the hard raised sizing border.
         WindowFrame fills the whole window with the frame face; the client-face Border repaints
         the flat window color INSIDE the frame; four directional bevels sit on the rim; RootGrid
         is inset by WindowFramePadding so a strip of frame shows on every side - the notepad
         edge. The bevels must be siblings of the client face, NOT padding on a wrapper, or the
         raised edge draws inward instead of on the rim. -->
    <!-- Exact KillerNotes frame hierarchy: outer directional ring, a separate 3px gradient
         face, then the inner directional ring. Keeping the face in its own Border prevents the
         right and bottom from becoming alternating full-height stripes. -->
    <Border x:Name="WindowFrame" BorderBrush="{DynamicResource WindowEdgeBrush}"
            BorderThickness="{DynamicResource WindowEdgeThickness}" SnapsToDevicePixels="True">
        <Grid x:Name="FrameHost">

    <Grid x:Name="RootGrid" Opacity="0" Panel.ZIndex="9500" Margin="{DynamicResource WindowFramePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>     <!-- 0: title bar -->
            <RowDefinition Height="Auto"/>   <!-- 1: scan toolbar -->
            <RowDefinition Height="*"/>      <!-- 2: devices pane -->
            <RowDefinition Height="24"/>     <!-- 3: footer / status bar (24px + 11.5/10.5 type, family standard) -->
        </Grid.RowDefinitions>

        <!-- TitleBarBrush: equal to the window background on every flat theme, the Win98 navy
             gradient on 98SE. What makes that work is the swap below - a real Win98 caption has no
             logotype in it, just the icon and the window's name in plain bold, so on 98SE the
             wordmark and subtitle collapse and PlainTitle shows instead. Painting the wordmark
             onto navy was the alternative and it does not work: "Killer" is TextBrush (black
             there) and "Scan" is PrimaryBrush (navy by default there). Same answer KillerShell
             reached. Theme.cs drives the visibilities. -->
        <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}">
            <Grid>
                <!-- Film grain over the bar (behind content) -->
                <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}" Margin="0,0,0,1">
                    <Border.Background>
                        <ImageBrush x:Name="TitleGrainBrush" TileMode="Tile"
                                    ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>
                    </Border.Background>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{DynamicResource ScanTitleBarPadding}">
                    <Image x:Name="TitleIcon" Source="pack://application:,,,/Resources/ks-icon.png" Width="27" Height="27"
                            VerticalAlignment="Center" Margin="0,0,7,0"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            MouseWheel="LogoBar_MouseWheel"
                            MouseLeftButtonDown="LogoBar_MouseLeftButtonDown"
                            ToolTip="{DynamicResource Str_TT_AppSize}"
                            RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- The 98SE caption title. A Win98 caption carries the window's name in plain
                         bold, not a logotype, so this shows only there and the wordmark collapses.
                         Wheel-zoomable and drag-enabled like the wordmark, because on 98SE it is
                         the ONLY thing in the caption to roll the wheel over - without that the
                         app-size control would simply be unreachable on this theme. -->
                    <TextBlock x:Name="PlainTitle" Text="KillerScan" Visibility="Collapsed"
                               VerticalAlignment="Center" Background="Transparent"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               MouseWheel="LogoBar_MouseWheel"
                               MouseLeftButtonDown="LogoBar_MouseLeftButtonDown"
                               ToolTip="{DynamicResource Str_TT_AppSize}"
                               FontFamily="Segoe UI" FontWeight="Bold" FontSize="11"
                               Foreground="{DynamicResource ChromeTextBrush}"/>
                    <!-- Typewriter wordmark with KillerPDF-style soft shadow: a blurred dark copy behind the
                         crisp text, faded by IconShadowOpacity (0 in light mode = no shadow).
                         Rolling the wheel over it drives the app-wide size (AppScale.cs). The
                         hit-test opt-in that lets the wheel reach it also takes it out of
                         WindowChrome's native caption, so drag and double-click-maximize are
                         restored by hand in AppScale.cs. The website link lives in About. -->
                    <Grid x:Name="LogoBar" VerticalAlignment="Center" Background="Transparent"
                          WindowChrome.IsHitTestVisibleInChrome="True"
                          MouseWheel="LogoBar_MouseWheel"
                          MouseLeftButtonDown="LogoBar_MouseLeftButtonDown"
                          ToolTip="{DynamicResource Str_TT_AppSize}">
                        <StackPanel Orientation="Horizontal" Margin="1,2,0,0" Opacity="{DynamicResource IconShadowOpacity}">
                            <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="18"><Run Text="Killer" Foreground="#D8000000"/><Run Text="Scan" FontSize="23.4" FontWeight="Bold" Foreground="#D8000000"/></TextBlock>
                        </StackPanel>
                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="18"><Run Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run Text="Scan" FontSize="23.4" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/></TextBlock>
                    </Grid>
                    <TextBlock x:Name="SubtitleText" Text="{DynamicResource Str_Subtitle}" Foreground="{DynamicResource MutedTextBrush}"
                               FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Margin="10,2,0,0"/>
                </StackPanel>

                <!-- The shortcuts, language and theme buttons used to sit here, left of the
                     window controls. They moved to the rail down the left of the content area
                     (2026-08-11) so KillerScan matches the rest of the family, where those three
                     are always the bottom of the rail in that order. The title bar now carries
                     the wordmark and the window controls only. -->

                <!-- Window Controls (Segoe MDL2 glyphs, matched to KillerPDF) -->
                <!-- CaptionButtonsMargin: 0 on every flat theme so the buttons run flush to the
                     window edge; on 98SE it insets them from the raised frame. VerticalAlignment
                     is Top rather than Stretch because the 98SE buttons are 16px in a 22px bar and
                     must sit against the top, not be stretched down it. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="{DynamicResource ScanCaptionButtonsMargin}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE921;" Click="MinimizeBtn_Click" Style="{StaticResource ChromeButton}"/>
                    <Button x:Name="MaximizeBtn" Content="&#xE922;" Click="MaximizeBtn_Click" Style="{StaticResource ChromeButton}"/>
                    <Button Content="&#xE8BB;" Click="CloseBtn_Click" Style="{StaticResource ChromeCloseButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scan / toolbar - part of the chrome, blends with the title bar above -->
        <!-- Top padding 0 + a 1px pull-up: the title bar's fixed 36px row leaves ~9px of slack under
             the wordmark, so the toolbar's own 8px top padding read as ~17px above the subnet box vs
             8px below. Removing the 8 and overlapping the title row by 1 equalizes it at 8/8; both
             bars share the same background+grain, so the 1px overlap is invisible. -->
        <!-- ScaleHost: the app-wide accessibility zoom (AppScale.cs) scales THIS grid only, so
             the title bar and footer stay a fixed size and the wordmark you scroll to zoom
             never moves. The DataGrid's saved column widths are logical px measured inside
             this transform, so they need no conversion across a scale change. -->
        <Grid x:Name="ScaleHost" Grid.Row="1" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 0: scan toolbar -->
                <RowDefinition Height="*"/>      <!-- 1: devices pane -->
            </Grid.RowDefinitions>
            <!-- Column 0 is the icon rail. Every other app in the family hangs its rail on the
                 inner lip of a sidebar; KillerScan has no sidebar, so the rail is a bare 24px
                 strip on the chrome down the left of the pane. It sits INSIDE ScaleHost on
                 purpose, so the app-wide size control grows the rail icons along with the
                 toolbar and the table rather than leaving them stranded at 100%.
                 The pane's old 8px left margin becomes this column, so the content did not
                 move - the rail occupies space the window already had. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource RailColumnWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        <!-- IsHitTestVisibleInChrome is REQUIRED here, not optional polish. WindowChrome measures
             CaptionHeight (36) from BELOW ResizeBorderThickness (8), so the caption region runs to
             44px from the window top - past the 36px title row and 9px into this toolbar. Windows
             swallows every click in that region as caption, so the top of the Scan button and the
             subnet box were dead: only their lower two thirds responded. Opting the bar into chrome
             hit-testing hands those pixels back to WPF. Dragging the bar still works, because
             Toolbar_MouseDown forwards empty-space clicks as a caption drag itself. -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource BackgroundBrush}" Padding="16,5,12,5" Margin="0,-1,0,0"
                WindowChrome.IsHitTestVisibleInChrome="True"
                MouseLeftButtonDown="Toolbar_MouseDown">
            <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- The subnet field owns every spare pixel. Its 160px floor preserves
                             the compact layout; the network facts remain an Auto-sized group
                             anchored against the right side as the window grows. -->
                        <ColumnDefinition Width="*" MinWidth="160"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Film grain over the complete toolbar, including its padded perimeter.
                         The former zero top inset began the tile inside the 5px padding and left
                         a textureless stripe directly under the title bar. -->
                    <Border Grid.ColumnSpan="4" IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}" Margin="-16,-5,-12,-5">
                        <Border.Background>
                            <ImageBrush x:Name="ToolbarGrainBrush" TileMode="Tile"
                                        ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>
                        </Border.Background>
                    </Border>

                    <TextBlock Grid.Column="0" Text="{DynamicResource Str_Lbl_Subnet}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <TextBox Grid.Column="1" x:Name="SubnetInput"
                             Style="{StaticResource DarkTextBox}"
                             Padding="5,3,9,3" FontSize="12"
                             Text="192.168.1.0/24"
                             VerticalAlignment="Center"/>

                    <!-- Quiet at rest, accent-filled on hover: the same primary-action treatment
                         used by the other family toolbars. -->
                    <Button Grid.Column="2" x:Name="ScanBtn" Content="{DynamicResource Str_Btn_Scan}"
                            Style="{StaticResource OutlineButton}"
                            Click="ScanBtn_Click"
                            FontSize="12" Padding="14,5" Margin="10,0,0,0"/>

                    <!-- Local network info - clean label/value pairs + an accent interface badge -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="20,0,0,0">
                        <!-- MutedTextBrush, not ChromeTextBrush: ChromeText means "text on the
                             TITLE BAR", and on 98SE that is white for the navy caption. These
                             labels sit on the toolbar, which stays face gray, so white would be
                             invisible. The two brushes are a shade apart on every flat theme. -->
                        <TextBlock Text="{DynamicResource Str_Lbl_Local}" Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="LocalIpLabel" Text="--" Foreground="{DynamicResource TextBrush}"
                                   FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <TextBlock Text="{DynamicResource Str_Lbl_Gateway}" Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="GatewayLabel" Text="--" Foreground="{DynamicResource TextBrush}"
                                   FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <TextBlock Text="{DynamicResource Str_Lbl_Dns}" Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="DnsLabel" Text="--" Foreground="{DynamicResource TextBrush}"
                                   FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <TextBlock x:Name="InterfaceIcon" Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="InterfaceLabel" Text="--" Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>

            </Grid>
        </Border>

        <!-- Chrome strip behind the pane, so the side margins carry the grain like the other bars -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource BackgroundBrush}">
            <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}"
                    Background="{DynamicResource GrainTileBrush}"/>
        </Border>

        <!-- The family rail has a single hairline at its content edge. -->
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource PaneBorderBrush}"
                BorderThickness="0,0,1,0" IsHitTestVisible="False"
                Margin="{DynamicResource RailSeparatorMargin}"
                Visibility="{DynamicResource RailSeparatorVisibility}"/>

        <!-- ================================================================
             ICON RAIL (column 0).

             Family order, and it is fixed: app-specific toggles first, then ?,
             then language, then theme, with theme always bottom-most. The three
             universal buttons land in the same place in every app so muscle
             memory carries across. KillerScan has no app-specific toggles and
             nothing to collapse, so it has no chevron and the rail is just those
             three, pinned to the bottom.
             ================================================================ -->
        <!-- Left margin 2, not 0: the panel is centred, so trimming 2px off the left of the
             available width shifts every glyph 1px toward the pane, which is where they read as
             centred on the strip. Same trick and same reason as the collapse chevron's
             Margin="2,10,0,0" in KillerNotes and Killendar. -->
        <!-- Theme + accent flyout. Both rail menus are positioned against DevicesPane's
             lower-left corner, matching KillerShell. Display/ClearType is deliberately local:
             this Popup must not inherit the zoom host's fractional-scale grayscale renderer. -->
        <Popup x:Name="ThemePopup" StaysOpen="False" AllowsTransparency="True"
               HorizontalOffset="-17" VerticalOffset="-13"
               TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
               UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Border Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource FlyoutCornerRadius}" Padding="12,10" Margin="22,18,22,26"
                    PreviewMouseWheel="Menu_ForwardWheelToGrid">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.55"/>
                </Border.Effect>
                <Grid>
                    <!-- Grain LAST inside the Grid would sit over the rows; here it is first but
                         the selected row's fill is transparent, so the texture still reads through
                         every row including the checked one. -->
                    <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}" CornerRadius="{DynamicResource PaneGrainCornerRadius}" Margin="-12,-10">
                        <Border.Background>
                            <ImageBrush x:Name="FlyoutGrainBrush" TileMode="Tile"
                                        ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>
                        </Border.Background>
                    </Border>
                    <StackPanel x:Name="ThemeMenuContent" MinWidth="150">
                        <TextBlock Text="{DynamicResource Str_Lbl_Theme}" Foreground="{DynamicResource DimTextBrush}" FontSize="10"
                                   FontWeight="SemiBold" Margin="2,0,0,8"/>
                        <!-- Named rows, not dots: twelve swatches do not fit, and a dot for a
                             grunge palette would be an invented color. Tag carries the Theme enum
                             name, so one handler serves every row and adding a theme is one line.
                             Order is presentation, deliberately NOT the enum's order, and matches
                             KillerShell and KillerNotes so the family lists themes the same way.
                             98SE slots in after Black when it lands. -->
                        <StackPanel x:Name="ThemeRadios">
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Dark"      Content="{DynamicResource Str_Theme_Dark}"      Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Light"     Content="{DynamicResource Str_Theme_Light}"     Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Black"     Content="{DynamicResource Str_Theme_Black}"     Checked="ThemeRadio_Checked"/>
                            <!-- Tag is SE98, the enum member; the label reads "98SE". -->
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="SE98"      Content="{DynamicResource Str_Theme_SE98}"      Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Blood"     Content="{DynamicResource Str_Theme_Blood}"     Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Greed"     Content="{DynamicResource Str_Theme_Greed}"     Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Cyanotic"  Content="{DynamicResource Str_Theme_Cyanotic}"  Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Ectoplasm" Content="{DynamicResource Str_Theme_Ectoplasm}" Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Decay"     Content="{DynamicResource Str_Theme_Decay}"     Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Malaise"   Content="{DynamicResource Str_Theme_Malaise}"   Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Sepulchre" Content="{DynamicResource Str_Theme_Sepulchre}" Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Delirium"  Content="{DynamicResource Str_Theme_Delirium}"  Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Mourning"  Content="{DynamicResource Str_Theme_Mourning}"  Checked="ThemeRadio_Checked"/>

                            <!-- The accent row lives INSIDE the theme list and is moved to sit
                                 directly under whichever accent-capable theme is selected
                                 (Theme.cs, PositionAccentRow). An accent belongs to one theme -
                                 Dark, Light and Black each remember their own - so parking the
                                 dots at the bottom of the list left them nowhere near the thing
                                 they change. Same shape as KillerShell, which hardcodes a
                                 separate accent row under each accent-capable theme; one row
                                 that relocates avoids keeping three copies of six dots in step.
                                 Declared last here purely as a starting position.

                                 No "ACCENT" caption: sitting indented under the selected theme,
                                 six colored dots say what they are without one. -->
                            <!-- Accent dots in ROYGBIV order; revealed only for accent-capable themes -->
                            <StackPanel x:Name="AccentSwatches" Orientation="Horizontal" Margin="10,-5,0,5" Visibility="Collapsed">
                                <Button Style="{StaticResource ThemeSwatch}" Tag="Red"    Background="#DD504B" Click="AccentSwatch_Click" ToolTip="Red"/>
                                <Button Style="{StaticResource ThemeSwatch}" Tag="Orange" Background="#E8962C" Click="AccentSwatch_Click" ToolTip="Orange"/>
                                <Button Style="{StaticResource ThemeSwatch}" Tag="Green"  Background="#1ea54c" Click="AccentSwatch_Click" ToolTip="Green"/>
                                <Button Style="{StaticResource ThemeSwatch}" Tag="Teal"   Background="#1FB8A8" Click="AccentSwatch_Click" ToolTip="Teal"/>
                                <Button Style="{StaticResource ThemeSwatch}" Tag="Blue"   Background="#50AEE8" Click="AccentSwatch_Click" ToolTip="Blue"/>
                                <Button Style="{StaticResource ThemeSwatch}" Tag="Purple" Background="#B982E3" Click="AccentSwatch_Click" ToolTip="Purple"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <!-- Original family rail for every geometrically flat theme. It remains inside the
             accessibility LayoutTransform exactly as before the 98SE work. -->
        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Bottom"
                    HorizontalAlignment="Center" Margin="2,0,0,10"
                    Visibility="{DynamicResource ScaledRailVisibility}">
            <Button x:Name="ShortcutsButton" Style="{StaticResource RailButton}"
                    Content="?" FontFamily="Consolas" FontSize="18"
                    Click="ShortcutHelp_Click" Margin="0,0,0,10"
                    ToolTip="{DynamicResource Str_TT_Shortcuts}"/>
            <Button x:Name="LangButton" Style="{StaticResource RailButton}"
                    Content="&#xF2B7;" FontSize="15"
                    Click="LangButton_Click" Margin="0,0,0,10"
                    ToolTip="{DynamicResource Str_TT_Language}">
                <Button.ContextMenu>
                    <ContextMenu x:Name="LangMenu" PreviewMouseWheel="Menu_ForwardWheelToGrid"/>
                </Button.ContextMenu>
            </Button>
            <Button x:Name="ThemeButton" Style="{StaticResource RailButton}"
                    Content="&#xE790;" FontSize="15"
                    Click="ThemeButton_Click" ToolTip="{DynamicResource Str_TT_Theme}"/>
        </StackPanel>

        <!-- Devices pane - the lightest tier, lifted above the chrome with an outward drop shadow
             (kept tight to the bars; the shadow overlays them rather than adding gap) -->
        <!-- Named so the shadow can be switched off. Windows 98 had no drop shadows anywhere, and
             PaneShadow is a StaticResource effect that a palette cannot reach - so Theme.cs nulls
             the Effect on 98SE and restores it otherwise. Same approach KillerShell takes. -->
        <Border x:Name="DevicesPane"
                Grid.Row="1" Grid.Column="1" Background="{DynamicResource ScanContentPaneBrush}" BorderBrush="{DynamicResource PaneBorderBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}" Margin="{DynamicResource DevicesPaneMargin}" Panel.ZIndex="10"
                Effect="{StaticResource PaneShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- The complete client pane is the Win98 recessed white well. The gray table
                     rows live inside it; the toolbar is part of the white client surface too. -->
                <Border Grid.RowSpan="2" IsHitTestVisible="False" Panel.ZIndex="20"
                        BorderBrush="{DynamicResource PaneBevelDarkBrush}"
                        BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
                <Border Grid.RowSpan="2" IsHitTestVisible="False" Panel.ZIndex="20"
                        BorderBrush="{DynamicResource PaneBevelLightBrush}"
                        BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
                <Border Grid.RowSpan="2" IsHitTestVisible="False" Panel.ZIndex="20"
                        Margin="{DynamicResource PaneBevelInnerMargin}"
                        BorderBrush="{DynamicResource PaneBevelDark2Brush}"
                        BorderThickness="{DynamicResource PaneBevel2LightThickness}"/>
                <Border Grid.RowSpan="2" IsHitTestVisible="False" Panel.ZIndex="20"
                        Margin="{DynamicResource PaneBevelInnerMargin}"
                        BorderBrush="{DynamicResource PaneBevelLight2Brush}"
                        BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/>
                <Border Grid.RowSpan="2" IsHitTestVisible="False" Panel.ZIndex="21" VerticalAlignment="Top"
                        Height="{DynamicResource ScanPaneBandSize}" Background="{DynamicResource ScanPaneTopBrush}"/>
                <Border Grid.RowSpan="2" IsHitTestVisible="False" Panel.ZIndex="21" HorizontalAlignment="Left"
                        Width="{DynamicResource ScanPaneBandSize}" Background="{DynamicResource ScanPaneLeftBrush}"/>
                <Border Grid.RowSpan="2" IsHitTestVisible="False" Panel.ZIndex="22" HorizontalAlignment="Right"
                        Width="{DynamicResource ScanPaneBandSize}" Background="{DynamicResource ScanPaneRightBrush}"/>
                <Border Grid.RowSpan="2" IsHitTestVisible="False" Panel.ZIndex="22" VerticalAlignment="Bottom"
                        Height="{DynamicResource ScanPaneBandSize}" Background="{DynamicResource ScanPaneBottomBrush}"/>

                <!-- Film grain over the WHOLE pane (behind content, clipped to the rounded corners) -->
                <Border Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0.20" Panel.ZIndex="-1" CornerRadius="{DynamicResource PaneGrainCornerRadius}">
                    <Border.Background>
                        <ImageBrush x:Name="GrainBrush" TileMode="Tile"
                                    ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>
                    </Border.Background>
                </Border>

                <Grid Grid.Row="0" Margin="12,8,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource Str_DiscoveredDevices}"
                               Foreground="{DynamicResource TextBrush}" FontFamily="Consolas"
                               FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    <!-- Search/filter box - magnifier + placeholder so it's clearly a search -->
                    <Border Grid.Column="1" Margin="16,0,0,0" Width="180" Height="26" VerticalAlignment="Center"
                            Background="{DynamicResource TextFieldBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                                <Style.Triggers>
                                    <!-- Hover first, focus second so a focused box keeps the accent border -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource DimTextBrush}" Margin="8,0,5,0" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <TextBlock Text="{DynamicResource Str_FilterPlaceholder}" Foreground="{DynamicResource DimTextBrush}"
                                           FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Text, ElementName=FilterInput}" Value=""/>
                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=FilterInput}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="FilterInput" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                         SelectionBrush="{DynamicResource PrimaryBrush}" SelectionOpacity="0.35"
                                         FontSize="12" Padding="0,0,8,0" VerticalContentAlignment="Center"
                                         TextChanged="FilterInput_TextChanged"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="3" x:Name="DeviceCount"
                               Text="0 devices found"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Grid.Column="4" x:Name="ExportButton"
                            Click="ExportButton_Click" IsEnabled="False"
                            ToolTip="{DynamicResource Str_TT_Export}" Cursor="Hand"
                            Background="{DynamicResource ExportButtonBackground}" BorderThickness="0"
                            Width="32" Height="26" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource ControlCornerRadius}"/>
                                    <Border x:Name="raisedLight" IsHitTestVisible="False"
                                            BorderBrush="{DynamicResource FrameOuterLightBrush}"
                                            BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
                                    <Border x:Name="raisedDark" IsHitTestVisible="False"
                                            BorderBrush="{DynamicResource FrameOuterDarkBrush}"
                                            BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
                                    <TextBlock x:Name="ico" Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="15" Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                        <Setter TargetName="ico" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="raisedLight" Property="BorderBrush" Value="{DynamicResource FrameOuterDarkBrush}"/>
                                        <Setter TargetName="raisedLight" Property="BorderThickness" Value="{DynamicResource FrameOuterLightThickness}"/>
                                        <Setter TargetName="raisedDark" Property="BorderBrush" Value="{DynamicResource FrameOuterLightBrush}"/>
                                        <Setter TargetName="ico" Property="Margin" Value="1,1,0,0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom" HorizontalOffset="0" VerticalOffset="2"
                                         PreviewMouseWheel="Menu_ForwardWheelToGrid">
                                <MenuItem Header="{DynamicResource Str_Export_Csv}" Click="ExportCsv_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE9F9;"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- Braces, not a globe: the globe is the language picker in the
                                     title bar and the Web Device type, and this is markup. -->
                                <MenuItem Header="{DynamicResource Str_Export_Html}" Click="ExportHtml_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE943;"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <!-- Results DataGrid -->
                <DataGrid Grid.Row="1" x:Name="ResultsGrid"
                          Margin="0"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="Transparent"
                          Foreground="{DynamicResource TextBrush}"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource PaneBorderBrush}"
                          HeadersVisibility="Column"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          SelectionMode="Extended"
                          ContextMenuOpening="ResultsGrid_ContextMenuOpening"
                          ColumnHeaderHeight="28"
                          RowHeight="28"
                          AlternationCount="2"
                          RowStyle="{StaticResource DarkDataGridRow}"
                          CellStyle="{StaticResource DarkDataGridCell}">

                    <!-- The scrollbars own the second column / third row. This anchors them to the
                         table edge without floating over cells or relying on an 8px fake gutter. -->
                    <DataGrid.Template>
                        <ControlTemplate TargetType="DataGrid">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <Grid>
                                <ScrollViewer x:Name="DG_ScrollViewer" Focusable="false">
                                    <ScrollViewer.Template>
                                        <ControlTemplate TargetType="ScrollViewer">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Grid.Column="0" SizeChanged="HeaderStrip_SizeChanged">
                                                    <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter"
                                                        Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                                                </Border>
                                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Row="1" Grid.Column="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                                    Grid.Row="1" Grid.Column="1"
                                                    Orientation="Vertical"
                                                    Maximum="{TemplateBinding ScrollableHeight}"
                                                    ViewportSize="{TemplateBinding ViewportHeight}"
                                                    Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                                <ScrollBar x:Name="PART_HorizontalScrollBar"
                                                    Grid.Row="2" Grid.Column="0" Orientation="Horizontal"
                                                    Maximum="{TemplateBinding ScrollableWidth}"
                                                    ViewportSize="{TemplateBinding ViewportWidth}"
                                                    Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </ScrollViewer.Template>
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ScrollViewer>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </DataGrid.Template>

                    <!-- Override WPF system blue selection with green -->
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                         Color="#1a3a25"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                         Color="#1ea54c"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                         Color="#1a3a25"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}"
                                         Color="#1ea54c"/>
                    </DataGrid.Resources>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="RescanMenuItem" Header="{DynamicResource Str_Ctx_RescanOne}" InputGestureText="Ctrl+R" Click="RescanSelected_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE72C;"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator Style="{x:Null}" Background="#3a3a3a" Height="1" Margin="8,4"/>
                            <!-- The three Copy actions share one glyph on purpose: they do the same
                                 kind of thing, and varying the icon would imply otherwise. -->
                            <MenuItem Header="{DynamicResource Str_Ctx_CopyIp}" InputGestureText="Ctrl+C" Click="CopyIp_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8C8;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str_Ctx_CopyMac}" InputGestureText="Ctrl+Shift+C" Click="CopyMac_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8C8;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str_Ctx_CopyHost}" InputGestureText="Ctrl+Alt+C" Click="CopyHostname_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8C8;"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator Style="{x:Null}" Background="#3a3a3a" Height="1" Margin="8,4"/>
                            <MenuItem Header="{DynamicResource Str_Ctx_Ping}" InputGestureText="Ctrl+P" Click="PingDevice_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE704;"/></MenuItem.Icon>
                            </MenuItem>
                            <!-- Open-in-new-window, not the globe: the globe is the language picker
                                 in the title bar, so reusing it here would blur what it means. The
                                 globe goes to Export as HTML instead, where nothing competes. -->
                            <MenuItem Header="{DynamicResource Str_Ctx_OpenBrowser}" InputGestureText="Enter" Click="OpenBrowser_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8A7;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str_Ctx_Rdp}" InputGestureText="Ctrl+D" Click="RdpDevice_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE7F4;"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str_Ctx_Ssh}" InputGestureText="Ctrl+S" Click="SshDevice_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE756;"/></MenuItem.Icon>
                            </MenuItem>
                            <!-- Same E756 glyph as the row above on purpose: this is the same
                                 action with the username prompt forced, not a different one, and
                                 every other codepoint in this menu was adopted only after being
                                 rendered and checked. Reusing a proven glyph beats introducing an
                                 unverified one for a variant. -->
                            <MenuItem Header="{DynamicResource Str_Ctx_SshAs}" InputGestureText="Ctrl+Shift+S" Click="SshAsDevice_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE756;"/></MenuItem.Icon>
                            </MenuItem>
                            <Separator Style="{x:Null}" Background="#3a3a3a" Height="1" Margin="8,4"/>
                            <MenuItem Header="{DynamicResource Str_Ctx_SetType}" SubmenuOpened="SetTypeMenu_Opened">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8EC;"/></MenuItem.Icon>
                                <!-- One distinct glyph per type; every codepoint was checked against
                                     the installed Segoe MDL2 Assets and rendered before adoption.
                                     MDL2 has no true router or NAS glyph, so those two are the
                                     closest available appliance/storage shapes. -->
                                <MenuItem Header="Router" Click="SetType_Click" Tag="Router">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE965;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Switch/AP" Click="SetType_Click" Tag="Switch/AP">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE701;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Network" Click="SetType_Click" Tag="Network">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE839;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Windows" Click="SetType_Click" Tag="Windows">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE7F4;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Windows Server" Click="SetType_Click" Tag="Windows Server">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE968;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Linux/SSH" Click="SetType_Click" Tag="Linux/SSH">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE756;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Server" Click="SetType_Click" Tag="Server">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xEDA2;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Printer" Click="SetType_Click" Tag="Printer">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE749;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Smart TV" Click="SetType_Click" Tag="Smart TV">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE7F8;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Apple TV" Click="SetType_Click" Tag="Apple TV">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE786;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Media Streamer" Click="SetType_Click" Tag="Media Streamer">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8B2;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Apple Device" Click="SetType_Click" Tag="Apple Device">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE977;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Mobile" Click="SetType_Click" Tag="Mobile">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8EA;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="IoT" Click="SetType_Click" Tag="IoT">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE9A9;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="NAS" Click="SetType_Click" Tag="NAS">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE8CE;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Camera" Click="SetType_Click" Tag="Camera">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE714;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Hypervisor" Click="SetType_Click" Tag="Hypervisor">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE81E;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Home Assistant" Click="SetType_Click" Tag="Home Assistant">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE80F;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="DNS Server" Click="SetType_Click" Tag="DNS Server">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE12B;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Web Device" Click="SetType_Click" Tag="Web Device">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE774;"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Other" Click="SetType_Click" Tag="Other">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE9CE;"/></MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem Header="{DynamicResource Str_Ctx_ClearOverride}" Click="ClearOverride_Click">
                                <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE894;"/></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource TableHeaderBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource HeaderLineBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Grid>
                                        <!-- RAISED bevel per header, paired with its slots: a Win98
                                             column header is a BUTTON, each one its own raised
                                             plate. Zero on every flat theme. -->
                                        <Border IsHitTestVisible="False" Panel.ZIndex="2"
                                                BorderBrush="{DynamicResource BevelLightBrush}"
                                                BorderThickness="{DynamicResource BevelLightThickness}"/>
                                        <Border IsHitTestVisible="False" Panel.ZIndex="2"
                                                BorderBrush="{DynamicResource BevelDarkBrush}"
                                                BorderThickness="{DynamicResource BevelDarkThickness}"/>
                                        <Border x:Name="hdrBg"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                <TextBlock x:Name="sortGlyph" Grid.Column="1"
                                                           Text="&#x25B2;" FontSize="8"
                                                           VerticalAlignment="Center" Margin="6,1,0,0"
                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                           Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                        <!-- Column-resize grippers: WPF wires resize drags to these exact
                                             PART_ names; the old template dropped them, which killed column
                                             resizing. Invisible 8px grab zones straddling each column edge,
                                             so defaults stay as designed but users can drag. -->
                                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                                               Width="8" Margin="-4,0,0,0" Cursor="SizeWE">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                                               Width="8" Margin="0,0,-4,0" Cursor="SizeWE">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="SortDirection" Value="{x:Static cm:ListSortDirection.Ascending}">
                                                <Setter TargetName="sortGlyph" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="sortGlyph" Property="Text" Value="&#x25B2;"/>
                                            </Trigger>
                                            <Trigger Property="SortDirection" Value="{x:Static cm:ListSortDirection.Descending}">
                                                <Setter TargetName="sortGlyph" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="sortGlyph" Property="Text" Value="&#x25BC;"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="hdrBg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="hdrBg" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColIp" Header="{DynamicResource Str_Col_Ip}" Binding="{Binding IpAddress}" Width="Auto" MinWidth="92" SortMemberPath="IpSortKey"/>
                        <DataGridTextColumn x:Name="ColHost" Header="{DynamicResource Str_Col_Host}" Binding="{Binding Hostname}" Width="Auto" MinWidth="142" MaxWidth="220"/>
                        <DataGridTextColumn x:Name="ColMac" Header="{DynamicResource Str_Col_Mac}" Binding="{Binding MacAddress}" Width="Auto" MinWidth="110"/>
                        <DataGridTextColumn x:Name="ColVendor" Header="{DynamicResource Str_Col_Vendor}" Binding="{Binding Vendor}" Width="2*"/>
                        <DataGridTemplateColumn x:Name="ColType" Header="{DynamicResource Str_Col_Type}" Width="Auto" MinWidth="95" SortMemberPath="DeviceType">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeviceType}" FontWeight="Medium">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Router">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeRouter}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Router/DNS">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeRouter}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Windows">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeWindows}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Windows Server">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeWindows}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Printer">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypePrinter}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Switch/AP">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeSwitch}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Hypervisor">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeHypervisor}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="NAS">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeNas}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="IoT">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeIot}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Server">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeServer}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Linux/SSH">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeLinux}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="DNS Server">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeDns}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Home Assistant">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeHa}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Mobile">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeMobile}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Camera">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeCamera}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Apple Device">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeSwitch}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Smart TV">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeSmarttv}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Apple TV">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeSwitch}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Media Streamer">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeMedia}"/>
                                                    </DataTrigger>
                                                    <!-- Selection wins over device classification colors. -->
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="ColPorts" Header="{DynamicResource Str_Col_Ports}" Binding="{Binding OpenPortsDisplay}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
                                    <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
                                    <!-- Full port list on hover: the cell truncates, the tooltip wraps and shows every open port. -->
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <TextBlock Text="{Binding OpenPortsDisplay}" TextWrapping="Wrap" MaxWidth="360"/>
                                        </Setter.Value>
                                    </Setter>
                                    <!-- No open ports: nothing worth a tooltip. -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OpenPortsDisplay}" Value="-">
                                            <Setter Property="ToolTip" Value="{x:Null}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        </Grid>
        <!-- end ScaleHost -->

        <!-- The family rail is window furniture, not scalable document content. Keeping it
             outside ScaleHost matches KillerShell/KillerNotes and prevents fractional app zoom
             from rasterizing these small glyphs between device pixels. -->
        <StackPanel Grid.Row="2" Width="{DynamicResource RailWidth}" VerticalAlignment="Bottom"
                    HorizontalAlignment="Left" Margin="0,0,0,10" Panel.ZIndex="30"
                    Visibility="{DynamicResource FixedRailVisibility}">
            <Button x:Name="FixedShortcutsButton" Style="{StaticResource RailButton}"
                    Content="?" FontFamily="Consolas" FontSize="18"
                    Click="ShortcutHelp_Click" Margin="0,0,0,10"
                    ToolTip="{DynamicResource Str_TT_Shortcuts}"/>
            <Button x:Name="FixedLangButton" Style="{StaticResource RailButton}"
                    Content="&#xF2B7;" FontSize="15"
                    Click="LangButton_Click" Margin="0,0,0,10"
                    ToolTip="{DynamicResource Str_TT_Language}">
                <Button.ContextMenu>
                    <ContextMenu x:Name="FixedLangMenu" PreviewMouseWheel="Menu_ForwardWheelToGrid"/>
                </Button.ContextMenu>
            </Button>
            <Button x:Name="FixedThemeButton" Style="{StaticResource RailButton}"
                    Content="&#xE790;" FontSize="15"
                    Click="ThemeButton_Click" ToolTip="{DynamicResource Str_TT_Theme}"/>
        </StackPanel>

        <!-- Status Bar -->
        <!-- ZIndex -1 so the content pane's shadow lands on the footer rather than being painted
             over by it. The footer is pushed down rather than the content row raised, which would
             also put it above the overlays declared later. -->
        <Border Grid.Row="3" Panel.ZIndex="-1" Background="{DynamicResource BackgroundBrush}">
            <!-- FooterPadding: 16,0 on the flat themes (one continuous strip); 0 on 98SE, where
                 the strip breaks into sunken cells that run to the edges. -->
            <Grid Margin="{DynamicResource FooterPadding}">
                <!-- TWO cells now, not three: the wide LEFT cell is the status recess and it
                     ALSO holds the centered PORTABLE/install badge, so it runs from the left edge
                     right up to the version cell (Win98 status bars are a row of wide cells, the
                     first one dominant). The RIGHT cell is the version/copyright recess. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Film grain over the bar (negative margin pulls it to the full width) -->
                <Border Grid.ColumnSpan="2" IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}" Margin="-16,0">
                    <Border.Background>
                        <ImageBrush x:Name="StatusGrainBrush" TileMode="Tile"
                                    ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>
                    </Border.Background>
                </Border>
                <!-- WIDE SUNKEN STATUS CELL. Crossed bevels (dark in the Light slot) - a status
                     cell is a RECESS, not a button. Holds the status text (left) and the portable
                     badge (centered) in one recess. All four tokens zero on flat themes. -->
                <Grid Grid.Column="0" Margin="{DynamicResource FooterCellMargin}">
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource FooterBevelDarkBrush}"
                            BorderThickness="{DynamicResource FooterCellLightThickness}"/>
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource FooterBevelLightBrush}"
                            BorderThickness="{DynamicResource FooterCellDarkThickness}"/>
                    <TextBlock x:Name="StatusText" Text="Ready"
                               Margin="{DynamicResource FooterCellPadding}" HorizontalAlignment="Left"
                               Foreground="{DynamicResource MutedTextBrush}" FontFamily="Consolas"
                               FontSize="11.5" VerticalAlignment="Center"/>
                </Grid>
                <!-- Centered against the complete footer/window, not merely the shortened status
                     cell to the left of the version block. -->
                <StackPanel x:Name="PortableBadge" Grid.ColumnSpan="2" Panel.ZIndex="5"
                            Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Str_Portable}" Foreground="{DynamicResource TextFooter}"
                               FontFamily="Consolas" FontSize="9"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="InstallBtn" Content="{DynamicResource Str_InstallBtn}"
                            Click="Install_Click" Style="{StaticResource OutlineButton}"
                            FontFamily="Segoe UI" FontSize="10" Padding="8,1"
                            VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Version/progress cluster in its own sunken cell (crossed, like the status
                     cell). -->
                <Grid Grid.Column="1" HorizontalAlignment="Right" Margin="{DynamicResource FooterCellMargin}">
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource FooterBevelDarkBrush}"
                            BorderThickness="{DynamicResource FooterCellLightThickness}"/>
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource FooterBevelLightBrush}"
                            BorderThickness="{DynamicResource FooterCellDarkThickness}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="{DynamicResource FooterCellPadding}">
                    <ProgressBar x:Name="ScanProgress"
                                 Width="200" Height="4" VerticalAlignment="Center"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Background="{DynamicResource CardBorderBrush}"
                                 Visibility="Collapsed" Margin="0,0,12,0"/>
                    <TextBlock x:Name="VersionLabel" Text="v1.5.2"
                               Foreground="{DynamicResource TextFooter}" FontFamily="Consolas"
                               FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"
                               Cursor="Hand" ToolTip="About KillerScan"
                               MouseLeftButtonUp="VersionLabel_Click"/>
                    <!-- 14px trailing margin keeps the copyright clear of the corner grip (family standard) -->
                    <TextBlock FontSize="10" VerticalAlignment="Center"
                               FontFamily="Consolas" Margin="0,0,14,0">
                        <Run Text="&#x00A9; 2026 " Foreground="{DynamicResource TextFooter}"/>
                        <Hyperlink NavigateUri="https://thekiller.net"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{DynamicResource TextFooter}" TextDecorations="None">
                            <Run Text="Steve the Killer"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Bottom-right resize grip. Modern themes use the family six dots; 98SE switches to
             KillerNotes' three continuous beveled diagonal ridges. -->
        <Canvas x:Name="ResizeGripDots" Grid.Row="3" Width="13" Height="13" Panel.ZIndex="50"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                Background="Transparent" Cursor="SizeNWSE"
                MouseLeftButtonDown="ResizeGrip_MouseDown">
            <Canvas Visibility="{DynamicResource GripDotsVisibility}">
                <Rectangle Canvas.Left="10" Canvas.Top="2"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="6"  Canvas.Top="6"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="10" Canvas.Top="6"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="2"  Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="6"  Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="10" Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
            </Canvas>
            <Canvas Visibility="{DynamicResource GripHatchVisibility}">
                <Canvas.Resources>
                    <Style TargetType="Line">
                        <Setter Property="StrokeThickness" Value="1"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                    </Style>
                </Canvas.Resources>
                <Line X1="12.5" Y1="3.5"  X2="3.5"  Y2="12.5" Stroke="{DynamicResource BevelDarkBrush}"/>
                <Line X1="12.5" Y1="4.5"  X2="4.5"  Y2="12.5" Stroke="{DynamicResource BevelLightBrush}"/>
                <Line X1="12.5" Y1="6.5"  X2="6.5"  Y2="12.5" Stroke="{DynamicResource BevelDarkBrush}"/>
                <Line X1="12.5" Y1="7.5"  X2="7.5"  Y2="12.5" Stroke="{DynamicResource BevelLightBrush}"/>
                <Line X1="12.5" Y1="9.5"  X2="9.5"  Y2="12.5" Stroke="{DynamicResource BevelDarkBrush}"/>
                <Line X1="12.5" Y1="10.5" X2="10.5" Y2="12.5" Stroke="{DynamicResource BevelLightBrush}"/>
            </Canvas>
        </Canvas>

        <!-- Keyboard shortcuts overlay (F1 or the title-bar "?"). Same card chrome as the About
             overlay below; the rows are built in Shortcuts.cs so the list has one source of truth. -->
        <Grid x:Name="ShortcutsOverlay" Grid.RowSpan="4" Panel.ZIndex="9000" Visibility="Collapsed"
              Margin="{DynamicResource OverlayFrameBleed}"
              Background="#88000000" MouseLeftButtonDown="ShortcutsOverlay_Click">
            <Grid Width="420" VerticalAlignment="Center" MouseLeftButtonDown="ShortcutsCard_Click">
                <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.6"/>
                    </Border.Effect>
                </Border>
                <!-- PanelCornerRadius, not FlyoutCornerRadius: the shared KillerUI layer overwrites
                     FlyoutCornerRadius with 0,0,4,4 - a dropdown shape that hangs off a button, so
                     this centered card came out with square top corners. PanelCornerRadius is 6 on
                     every flat theme and 0 on 98SE, which is the shape a card wants. -->
                <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}">
                    <Grid>
                        <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                                Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>

                        <Border VerticalAlignment="Top" ClipToBounds="True"
                                Height="{DynamicResource AboutCaptionHeight}"
                                Margin="{DynamicResource AboutCaptionMargin}"
                                Background="{DynamicResource TitleBarBrush}">
                            <TextBlock Text="Keyboard shortcuts" VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource ChromeFontFamily}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource ChromeTextBrush}"/>
                        </Border>

                        <!-- Glyph is a named TextBlock recolored by TargetName. Setting Foreground
                             on the Button would be a local value and would outrank the trigger, so
                             the hover would never take - the same trap the About overlay documents. -->
                        <Button Content="{DynamicResource AboutCloseGlyph}" Click="ShortcutsClose_Click"
                                Style="{StaticResource OverlayCloseButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Width="{DynamicResource AboutCloseWidth}"
                                Height="{DynamicResource AboutCloseHeight}" Margin="{DynamicResource AboutCloseMargin}"
                                Panel.ZIndex="7"/>

                        <StackPanel Margin="{DynamicResource ShortcutsContentMargin}">
                            <TextBlock x:Name="ShortcutsTitle" Text="Keyboard shortcuts"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>
                            <Grid x:Name="ShortcutList">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <TextBlock x:Name="ShortcutsHint" Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- About overlay: dims the window behind it and shows a centered card (matches KillerPDF).
             The close X is blended into the card (no separate title bar) with a red hover. -->
        <Grid x:Name="AboutOverlay" Grid.RowSpan="4" Panel.ZIndex="9000" Visibility="Collapsed"
              Margin="{DynamicResource OverlayFrameBleed}"
              Background="#88000000" MouseLeftButtonDown="AboutOverlay_Click">
            <!-- No fixed width: the SHA-256 line never wraps, so it sizes the info panel and
                 the info panel sizes the card. The header below pins its width to that panel
                 so a long tagline wraps instead of widening the card. Family standard. -->
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MouseLeftButtonDown="AboutCard_Click">
                <!-- Shadow on a separate element so the card text stays crisp. Named so
                     ApplyFlatChrome (Theme.cs) can collapse it on 98SE - no shadows there,
                     and the card's elevation signal becomes the raised bevel below. -->
                <Border x:Name="AboutShadow" Background="{DynamicResource BackgroundBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.6"/>
                    </Border.Effect>
                </Border>
                <!-- PanelCornerRadius, not FlyoutCornerRadius: the shared KillerUI layer overwrites
                     FlyoutCornerRadius with 0,0,4,4 - a dropdown shape that hangs off a button, so
                     this centered card came out with square top corners. PanelCornerRadius is 6 on
                     every flat theme and 0 on 98SE, which is the shape a card wants. -->
                <Border Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}">
                    <Grid>
                        <!-- Raised card bevel, KillerShell's About verbatim: FrameOuter pair, so on
                             98SE the card carries the same edge as the window. Nothing elsewhere. -->
                        <Border IsHitTestVisible="False" Panel.ZIndex="6"
                                BorderBrush="{DynamicResource FrameOuterLightBrush}"
                                BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
                        <Border IsHitTestVisible="False" Panel.ZIndex="6"
                                BorderBrush="{DynamicResource FrameOuterDarkBrush}"
                                BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
                        <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                                Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>

                        <Border VerticalAlignment="Top" ClipToBounds="True"
                                Height="{DynamicResource AboutCaptionHeight}"
                                Margin="{DynamicResource AboutCaptionMargin}"
                                Background="{DynamicResource TitleBarBrush}">
                            <TextBlock Text="About KillerScan" VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource ChromeFontFamily}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource ChromeTextBrush}"/>
                        </Border>

                        <!-- Close X: just the glyph turns red on hover (no filled square), like KillerPDF.
                             Foreground is a Style setter (not a local value) so the hover trigger can win. -->
                        <Button Content="{DynamicResource AboutCloseGlyph}" Click="AboutClose_Click"
                                Style="{StaticResource OverlayCloseButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Width="{DynamicResource AboutCloseWidth}"
                                Height="{DynamicResource AboutCloseHeight}" Margin="{DynamicResource AboutCloseMargin}"
                                Panel.ZIndex="7"/>

                        <StackPanel Margin="{DynamicResource ScanAboutContentMargin}">
                            <!-- Header: icon to the left of the wordmark + description + tagline.
                                 A Grid (not a horizontal StackPanel) so the text column is bounded and wraps.
                                 Width is pinned to the info panel so the SHA-256 line stays the only thing
                                 that sets the card width. -->
                            <Grid Margin="0,4,0,14" Width="{Binding ActualWidth, ElementName=AboutInfoGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="pack://application:,,,/Resources/ks-icon.png" Width="58" Height="58"
                                       Margin="0,0,15,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.55"/>
                                    </Image.Effect>
                                </Image>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,4" HorizontalAlignment="Left">
                                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" Margin="1,2,0,0" IsHitTestVisible="False"
                                                   Opacity="{DynamicResource IconShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="2"/></TextBlock.Effect><Run Text="Killer" FontSize="22" Foreground="#C0000000"/><Run Text="Scan" FontSize="28.6" FontWeight="Bold" Foreground="#C0000000"/></TextBlock>
                                        <TextBlock FontFamily="{DynamicResource WordmarkFont}"><Run Text="Killer" FontSize="22" Foreground="{DynamicResource TextBrush}"/><Run Text="Scan" FontSize="28.6" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/></TextBlock>
                                    </Grid>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"><Run Text="{DynamicResource Str_About_DescA}"/><Run Text="GPLv3 "/><Hyperlink NavigateUri="https://killertools.net" RequestNavigate="AboutLink_Navigate" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None">Killer Tools</Hyperlink><Run Text="{DynamicResource Str_About_DescB}"/></TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- Info panel - matte, lifted above the grainy card. Named: the header
                                 binds its width to this panel (see above). -->
                            <Grid x:Name="AboutInfoGrid">
                                <Border x:Name="AboutInfoShadow" Background="{DynamicResource AboutPanelBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.5"/>
                                    </Border.Effect>
                                </Border>
                                <Border Background="{DynamicResource AboutPanelBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="14,12,14,4">
                                    <StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Version}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <!-- One row, two ends: version accent left, release date muted and
                                                 italic hard right. Bottom-aligned so the two sizes share a
                                                 baseline. Only the version text is clickable. -->
                                            <Grid Margin="0,1,0,0">
                                                <TextBlock x:Name="AboutVersionBlock" Foreground="{DynamicResource PrimaryBrush}"
                                                           FontFamily="Consolas" FontSize="13" Cursor="Hand"
                                                           HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                           MouseLeftButtonUp="AboutVersion_Click"/>
                                                <TextBlock x:Name="AboutReleaseDateBlock" Foreground="{DynamicResource MutedTextBrush}"
                                                           FontFamily="Consolas" FontSize="11" FontStyle="Italic"
                                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Publisher}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <TextBlock x:Name="AboutPublisherBlock" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,1,0,0"/>
                                            <!-- Shown only on an exe signed by Steve. The alias is an accent link to
                                                 thekiller.net; "AKA" stays muted so the eye lands on the name. -->
                                            <TextBlock x:Name="AboutAkaBlock" Visibility="Collapsed" Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="11" Margin="0,3,0,0"><Run Text="AKA "/><Hyperlink NavigateUri="https://thekiller.net" RequestNavigate="AboutLink_Navigate" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None" ToolTip="thekiller.net"><Run x:Name="AboutAkaRun"/></Hyperlink></TextBlock>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Thumbprint}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <TextBlock x:Name="AboutThumbprintBlock" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Sha}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <TextBlock x:Name="AboutSha256Block" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Db}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <TextBlock x:Name="AboutDbBlock" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                            <TextBlock FontFamily="Consolas" FontSize="11" Margin="0,2,0,0">
                                                <Hyperlink x:Name="AboutDbUpdateLink" Click="AboutDbUpdate_Click" Foreground="{DynamicResource PrimaryBrush}"><Run Text="{DynamicResource Str_About_DbUpdate}"/></Hyperlink>
                                            </TextBlock>
                                            <TextBlock x:Name="AboutDbStatus" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource PaneBevelDarkBrush}"
                                        BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
                                <Border IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource PaneBevelLightBrush}"
                                        BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
                                <Border IsHitTestVisible="False" Margin="{DynamicResource PaneBevelInnerMargin}"
                                        BorderBrush="{DynamicResource PaneBevelDark2Brush}"
                                        BorderThickness="{DynamicResource PaneBevel2LightThickness}"/>
                                <Border IsHitTestVisible="False" Margin="{DynamicResource PaneBevelInnerMargin}"
                                        BorderBrush="{DynamicResource PaneBevelLight2Brush}"
                                        BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/>
                                <Border IsHitTestVisible="False" VerticalAlignment="Top"
                                        Height="{DynamicResource ScanPaneBandSize}" Background="{DynamicResource ScanPaneTopBrush}"/>
                                <Border IsHitTestVisible="False" HorizontalAlignment="Left"
                                        Width="{DynamicResource ScanPaneBandSize}" Background="{DynamicResource ScanPaneLeftBrush}"/>
                                <Border IsHitTestVisible="False" HorizontalAlignment="Right"
                                        Width="{DynamicResource ScanPaneBandSize}" Background="{DynamicResource ScanPaneRightBrush}"/>
                                <Border IsHitTestVisible="False" VerticalAlignment="Bottom"
                                        Height="{DynamicResource ScanPaneBandSize}" Background="{DynamicResource ScanPaneBottomBrush}"/>
                            </Grid>

                            <!-- Update notice: shown only when a newer release is found -->
                            <Button x:Name="AboutUpdateButton" Visibility="Collapsed" Margin="0,14,0,0"
                                    HorizontalAlignment="Left" Cursor="Hand" Click="AboutUpdateButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ub" Background="Transparent" BorderBrush="{DynamicResource PrimaryBrush}"
                                                BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="14,7">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ub" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="AboutUpdateText" Text="Update available" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </Button>

                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

    </Grid>
    <!-- /RootGrid -->

        <!-- Window frame, copied from KillerNotes. Each ring occupies its own depth instead of
             painting several unrelated bands over the same right and bottom pixels. -->
        <Border Panel.ZIndex="9001" IsHitTestVisible="False"
                BorderBrush="{DynamicResource FrameOuterLightBrush}"
                BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
        <Border Panel.ZIndex="9001" IsHitTestVisible="False"
                BorderBrush="{DynamicResource FrameOuterDarkBrush}"
                BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
        <Border Panel.ZIndex="8999" IsHitTestVisible="False"
                Margin="{DynamicResource WindowFrameMargin}"
                BorderBrush="{DynamicResource WindowFrameBrush}"
                BorderThickness="{DynamicResource WindowFrameThickness}"/>
        <Border Panel.ZIndex="9000" IsHitTestVisible="False"
                Margin="{DynamicResource FrameInnerMargin}"
                BorderBrush="{DynamicResource FrameInnerLightBrush}"
                BorderThickness="{DynamicResource FrameInnerLightThickness}"/>
        <Border Panel.ZIndex="9000" IsHitTestVisible="False"
                Margin="{DynamicResource FrameInnerMargin}"
                BorderBrush="{DynamicResource FrameInnerDarkBrush}"
                BorderThickness="{DynamicResource FrameInnerDarkThickness}"/>
        <!-- RootGrid is inset inside the 98SE sizing frame, so its modal backdrops cannot
             reliably paint over that frame. This sibling dims only the exposed frame area;
             RootGrid (z=9500) covers its center while its own overlay dims the client. -->
        <Border x:Name="FrameDimmer" Panel.ZIndex="9400" IsHitTestVisible="False"
                Background="#88000000" Visibility="Collapsed"/>
        </Grid>
    </Border>
    <!-- /WindowFrame -->
</Window>
