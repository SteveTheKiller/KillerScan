<Window x:Class="KillerScan.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:KillerFamily.Theming"
        xmlns:a11y="clr-namespace:KillerFamily.Accessibility"
        xmlns:kl="clr-namespace:KillerFamily.Layout"
        xmlns:icons="clr-namespace:KillerScan.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KillerScan.Shell"
        xmlns:controls="clr-namespace:KillerScan.Controls"
        xmlns:cm="clr-namespace:System.ComponentModel;assembly=System"
        mc:Ignorable="d"
        Title="KillerScan"
        Height="700" Width="1025"
        MinHeight="500" MinWidth="800"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        BorderThickness="0"
        BorderBrush="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="{DynamicResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Icon="pack://application:,,,/Resources/ks-icon.ico">

    <!-- Native custom chrome (no AllowsTransparency): WPF composites on the GPU and Windows
         draws the drop shadow + rounds the HWND (Win11, via DWMWA_WINDOW_CORNER_PREFERENCE in
         WindowChrome.cs). The 36px title bar becomes the draggable caption; interactive bits in
         it opt back in with WindowChrome.IsHitTestVisibleInChrome. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="8"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- WIN98 WINDOW FRAME, ported from KillerShell verbatim. Zero-thickness / transparent on
         every flat theme (DWM does the edge there); on 98SE it is the hard raised sizing border.
         WindowFrame fills the whole window with the frame face; the client-face Border repaints
         the flat window color INSIDE the frame; four directional bevels sit on the rim; RootGrid
         is inset by WindowFramePadding so a strip of frame shows on every side - the notepad
         edge. The bevels must be siblings of the client face, NOT padding on a wrapper, or the
         raised edge draws inward instead of on the rim. -->
    <!-- Exact KillerNotes frame hierarchy: outer directional ring, a separate 3px gradient
         face, then the inner directional ring. Keeping the face in its own Border prevents the
         right and bottom from becoming alternating full-height stripes. -->
    <Border x:Name="WindowFrame" BorderBrush="{DynamicResource WindowEdgeBrush}"
            BorderThickness="{DynamicResource WindowEdgeThickness}" SnapsToDevicePixels="True">
        <Grid x:Name="FrameHost">

    <Grid x:Name="RootGrid" Opacity="0" Panel.ZIndex="9500" Margin="{DynamicResource WindowFramePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>     <!-- 0: title bar -->
            <RowDefinition Height="Auto"/>   <!-- 1: scan toolbar -->
            <RowDefinition Height="*"/>      <!-- 2: devices pane -->
            <RowDefinition Height="24"/>     <!-- 3: footer / status bar (24px + 11.5/10.5 type, family standard) -->
        </Grid.RowDefinitions>

        <!-- TitleBarBrush: equal to the window background on every flat theme, the Win98 navy
             gradient on 98SE. What makes that work is the swap below - a real Win98 caption has no
             logotype in it, just the icon and the window's name in plain bold, so on 98SE the
             wordmark and subtitle collapse and PlainTitle shows instead. Painting the wordmark
             onto navy was the alternative and it does not work: "Killer" is TextBrush (black
             there) and "Scan" is PrimaryBrush (navy by default there). Same answer KillerShell
             reached. Theme.cs drives the visibilities. -->
        <!-- ZIndex 1 so the wordmark's drips can hang into the top of the toolbar row below. -->
        <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" Panel.ZIndex="1">
            <Grid>
                <!-- Film grain over the whole bar (behind content). Stopping it short of the bottom
                     edge left a bare one-pixel line under the title bar on every grained theme. -->
                <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}">
                    <Border.Background>
                        <ImageBrush x:Name="TitleGrainBrush" TileMode="Tile"
                                    ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>
                    </Border.Background>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{DynamicResource ScanTitleBarPadding}">
                    <icons:AppIcon x:Name="TitleIcon" Width="27" Height="27"
                            VerticalAlignment="Center" Margin="0,0,7,0"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            MouseWheel="LogoBar_MouseWheel"
                            MouseLeftButtonDown="LogoBar_MouseLeftButtonDown"
                            ToolTip="{DynamicResource Str_TT_AppSize}"
                            RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                    <!-- The 98SE caption title. A Win98 caption carries the window's name in plain
                         bold, not a logotype, so this shows only there and the wordmark collapses.
                         Wheel-zoomable and drag-enabled like the wordmark, because on 98SE it is
                         the ONLY thing in the caption to roll the wheel over - without that the
                         app-size control would simply be unreachable on this theme. -->
                    <TextBlock x:Name="PlainTitle" Text="KillerScan" Visibility="Collapsed"
                               VerticalAlignment="Center" Background="Transparent"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               MouseWheel="LogoBar_MouseWheel"
                               MouseLeftButtonDown="LogoBar_MouseLeftButtonDown"
                               ToolTip="{DynamicResource Str_TT_AppSize}"
                               FontFamily="Segoe UI" FontWeight="Bold" FontSize="11"
                               Foreground="{DynamicResource ChromeTextBrush}"/>
                    <!-- Typewriter wordmark with KillerPDF-style soft shadow: a blurred dark copy behind the
                         crisp text, faded by WordmarkShadowOpacity (off on 98SE).
                         Rolling the wheel over it drives the app-wide size (AppScale.cs). The
                         hit-test opt-in that lets the wheel reach it also takes it out of
                         WindowChrome's native caption, so drag and double-click-maximize are
                         restored by hand in AppScale.cs. The website link lives in About. -->
                    <!-- Negative margins keep Lacquer's deep descent out of the layout so the bar never
                         clips the drips; the 2px imbalance and the lift match KillerPDF. -->
                    <Grid x:Name="LogoBar" VerticalAlignment="Center" Background="Transparent" Margin="0,-18,0,-22"
                          WindowChrome.IsHitTestVisibleInChrome="True"
                          MouseWheel="LogoBar_MouseWheel"
                          MouseLeftButtonDown="LogoBar_MouseLeftButtonDown"
                          ToolTip="{DynamicResource Str_TT_AppSize}">
                        <Grid.RenderTransform><TranslateTransform Y="-5"/></Grid.RenderTransform>
                        <StackPanel Orientation="Horizontal" Margin="1,2,0,0" Opacity="{DynamicResource WordmarkShadowOpacity}">
                            <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"><Run Text="Killer" Foreground="#D8000000"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Scan" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/></TextBlock>
                        </StackPanel>
                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"
                                   Margin="1,2,0,0" Opacity="{DynamicResource WordmarkAccentShadowOpacity}" IsHitTestVisible="False">
                            <TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect>
                            <Run Text="Killer" Foreground="Transparent"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Scan" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="#D8000000"/>
                        </TextBlock>
                        <TextBlock theme:Bevel.Enabled="True" FontFamily="{DynamicResource WordmarkFont}" FontSize="{DynamicResource TitleWordmarkSize}"><Run Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Scan" FontSize="{DynamicResource TitleWordmarkBoldSize}" Foreground="{DynamicResource AccentLogo}"/></TextBlock>
                    </Grid>
                    <!-- The active view's bar rides after the wordmark. The classic theme moves
                         this same host below the caption so its controls remain full-sized. -->
                    <Border x:Name="TitleToolbarHost" VerticalAlignment="Center" Margin="{DynamicResource ScanTitleToolbarMargin}"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>

                <!-- The shortcuts, language and theme buttons used to sit here, left of the
                     window controls. They moved to the rail down the left of the content area
                     (2026-08-11) so KillerScan matches the rest of the family, where those three
                     are always the bottom of the rail in that order. The title bar now carries
                     the wordmark and the window controls only. -->

                <!-- Window Controls (Segoe MDL2 glyphs, matched to KillerPDF) -->
                <!-- The classic caption gives its buttons the original two-pixel insets. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="{DynamicResource ScanCaptionButtonsMargin}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- The device filter, where KillerShell keeps its search: left of the window
                         controls (Shell/Workspace.cs moves it here from the scan bar). -->
                    <StackPanel x:Name="TitleTools" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button VerticalAlignment="Top" Click="MinimizeBtn_Click" Style="{StaticResource ChromeButton}" ToolTip="{DynamicResource Str_Sys_Minimize}">
                        <Grid Height="{DynamicResource CaptionButtonHeight}">
                            <TextBlock x:Name="MinimizeGlyph" Text="&#xE921;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle x:Name="ClassicMinimizeGlyph" Width="6" Height="2" Fill="{DynamicResource CaptionGlyphBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" SnapsToDevicePixels="True" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="MaximizeBtn" VerticalAlignment="Top" Click="MaximizeBtn_Click" Style="{StaticResource ChromeButton}" ToolTip="{DynamicResource Str_Sys_Maximize}">
                        <Grid>
                            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;"/>
                            <Grid x:Name="ClassicMaximizeGlyph" Width="9" Height="9" Margin="0,0,0,1" SnapsToDevicePixels="True" Visibility="Collapsed">
                                <Rectangle Stroke="{DynamicResource CaptionGlyphBrush}" StrokeThickness="1" Fill="Transparent"/>
                                <Rectangle Height="2" Fill="{DynamicResource CaptionGlyphBrush}" VerticalAlignment="Top"/>
                            </Grid>
                            <Grid x:Name="ClassicRestoreGlyph" Width="10" Height="9" SnapsToDevicePixels="True" Visibility="Collapsed">
                                <Border Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource CaptionButtonBrush}" BorderBrush="{DynamicResource CaptionGlyphBrush}" BorderThickness="1,2,1,1"/>
                                <Border Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{DynamicResource CaptionButtonBrush}" BorderBrush="{DynamicResource CaptionGlyphBrush}" BorderThickness="1,2,1,1"/>
                            </Grid>
                        </Grid>
                    </Button>
                    <Button VerticalAlignment="Top" Click="CloseBtn_Click" Style="{StaticResource ChromeCloseButton}" ToolTip="{DynamicResource Str_Sys_Close}">
                        <Grid>
                            <TextBlock x:Name="CloseGlyph" Text="&#xE8BB;"/>
                            <Grid x:Name="ClassicCloseGlyph" Width="8" Height="8" Visibility="Collapsed">
                                <Rectangle Width="10" Height="2" Fill="{DynamicResource CaptionGlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle.RenderTransform><RotateTransform Angle="45" CenterX="5" CenterY="1"/></Rectangle.RenderTransform>
                                </Rectangle>
                                <Rectangle Width="10" Height="2" Fill="{DynamicResource CaptionGlyphBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle.RenderTransform><RotateTransform Angle="-45" CenterX="5" CenterY="1"/></Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The workspace host and theme-aware icon rail share the content area. -->
        <kl:UnclippedGrid x:Name="ScaleHost" Grid.Row="1" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 0: scan toolbar -->
                <RowDefinition Height="*"/>      <!-- 1: devices pane -->
            </Grid.RowDefinitions>

            <!-- Column 0 is the sidebar lane: the history panel with the icon rail on its inner
                 lip, exactly as KillerNotes lays it out. Collapsed it is the rail's own width,
                 so the rail sits at the window edge and the app looks as it always has; opening
                 history widens the column and carries the rail along with it. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="{DynamicResource RailColumnWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        <!-- Chrome strip behind the pane, so the side margins carry the grain like the other bars -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource BackgroundBrush}">
            <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}">
                <Border.Background><ImageBrush x:Name="GrainBrush" TileMode="Tile"
                    ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/></Border.Background>
            </Border>
        </Border>


        <!-- ================================================================
             ICON RAIL (column 0).

             Family order, and it is fixed: app-specific toggles first, then ?,
             then language, then theme, with theme always bottom-most. The three
             universal buttons land in the same place in every app so muscle
             memory carries across. KillerScan has no app-specific toggles and
             nothing to collapse, so it has no chevron and the rail is just those
             three, pinned to the bottom.
             ================================================================ -->
        <!-- Left margin 2, not 0: the panel is centred, so trimming 2px off the left of the
             available width shifts every glyph 1px toward the pane, which is where they read as
             centred on the strip. Same trick and same reason as the collapse chevron's
             Margin="2,10,0,0" in KillerNotes and Killendar. -->
        <!-- Theme + accent flyout. Both rail menus are positioned against DevicesPane's
             lower-left corner, matching KillerShell. Display/ClearType is deliberately local:
             this Popup must not inherit the zoom host's fractional-scale grayscale renderer. -->
        <Popup x:Name="ThemePopup" StaysOpen="False" AllowsTransparency="True"
               HorizontalOffset="-17" VerticalOffset="-13"
               TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
               UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Border Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource FlyoutCornerRadius}" Padding="12,10" Margin="22,18,22,26"
                    PreviewMouseWheel="Menu_ForwardWheelToGrid">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.55"/>
                </Border.Effect>
                <Grid>
                    <!-- Grain LAST inside the Grid would sit over the rows; here it is first but
                         the selected row's fill is transparent, so the texture still reads through
                         every row including the checked one. -->
                    <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}" CornerRadius="{DynamicResource PaneGrainCornerRadius}" Margin="-12,-10">
                        <Border.Background>
                            <ImageBrush x:Name="FlyoutGrainBrush" TileMode="Tile"
                                        ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>
                        </Border.Background>
                    </Border>
                    <!-- The theme column fills the menu (*) so the hover rows reach across
                         when the menu is wider than the list; the margin is set in Theme.cs. -->
                    <Grid x:Name="ThemeMenuContent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Named rows, not dots: twelve swatches do not fit, and a dot for a
                             grunge palette would be an invented color. Tag carries the Theme enum
                             name, so one handler serves every row and adding a theme is one line.
                             Order is presentation, deliberately NOT the enum's order, and matches
                             KillerShell and KillerNotes so the family lists themes the same way.
                             98SE slots in after Black when it lands. -->
                        <StackPanel x:Name="ThemeRadios" Grid.Column="0" MinWidth="120">
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Dark"      Content="{DynamicResource Str_Theme_Dark}"      Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Light"     Content="{DynamicResource Str_Theme_Light}"     Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Black"     Content="{DynamicResource Str_Theme_Black}"     Checked="ThemeRadio_Checked"/>
                            <!-- Tag is SE98, the enum member; the label reads "98SE". -->
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="SE98"      Content="{DynamicResource Str_Theme_SE98}"      Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Blood"     Content="{DynamicResource Str_Theme_Blood}"     Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Greed"     Content="{DynamicResource Str_Theme_Greed}"     Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Cyanotic"  Content="{DynamicResource Str_Theme_Cyanotic}"  Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Ectoplasm" Content="{DynamicResource Str_Theme_Ectoplasm}" Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Decay"     Content="{DynamicResource Str_Theme_Decay}"     Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Malaise"   Content="{DynamicResource Str_Theme_Malaise}"   Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Sepulchre" Content="{DynamicResource Str_Theme_Sepulchre}" Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Delirium"  Content="{DynamicResource Str_Theme_Delirium}"  Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Mourning"  Content="{DynamicResource Str_Theme_Mourning}"  Checked="ThemeRadio_Checked"/>
                        </StackPanel>
                        <Grid x:Name="AccentStripHost" Grid.Column="1" Width="0" ClipToBounds="True">
                            <Border Width="1" HorizontalAlignment="Left" Margin="0,6"
                                    Background="{DynamicResource MenuBorderBrush}"/>
                            <Grid x:Name="AccentStrip" Margin="7,6,2,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/><RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/><RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/><RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/><RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="AccentStripDot0" Grid.Row="0" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" MouseLeftButtonUp="AccentStripDot_Click"/>
                                <Border x:Name="AccentStripDot1" Grid.Row="1" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" MouseLeftButtonUp="AccentStripDot_Click"/>
                                <Border x:Name="AccentStripDot2" Grid.Row="2" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" MouseLeftButtonUp="AccentStripDot_Click"/>
                                <Border x:Name="AccentStripDot3" Grid.Row="3" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" MouseLeftButtonUp="AccentStripDot_Click"/>
                                <Border x:Name="AccentStripDot4" Grid.Row="4" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" MouseLeftButtonUp="AccentStripDot_Click"/>
                                <Border x:Name="AccentStripDot5" Grid.Row="5" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" MouseLeftButtonUp="AccentStripDot_Click"/>
                                <Border x:Name="AccentStripDot6" Grid.Row="6" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" MouseLeftButtonUp="AccentStripDot_Click"/>
                                <Border x:Name="AccentStripDot7" Grid.Row="7" Style="{StaticResource AccentDot}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0" MouseLeftButtonUp="AccentStripDot_Click"/>
                            </Grid>
                        </Grid>
                        <!-- Film Grain: one switch for the grain texture on every surface
                             (Services/FilmGrain.cs). Its own row under both columns, so the
                             accent strip still runs the height of the theme list only. -->
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                            <Border Height="1" Margin="0,0,9,8" Opacity="0.18" IsHitTestVisible="False"
                                    Background="{DynamicResource TextBrush}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="Black" Offset="0.15"/>
                                        <GradientStop Color="Black" Offset="0.85"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <CheckBox x:Name="FilmGrainCheck" Content="{DynamicResource Str_Theme_FilmGrain}"
                                      Style="{StaticResource ThemeCheck}" Margin="0"
                                      Click="FilmGrainCheck_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Popup>

        <!-- ==== HISTORY SIDEBAR (column 0, behind the rail) ==============================
             Clipped so the panel can be frozen at full width and wiped by the column tween
             rather than reflowing to nothing as it closes. -->
        <Grid x:Name="SidebarClip" Grid.Row="1" Grid.Column="0" Margin="0,0,24,0" ClipToBounds="True">
            <Grid x:Name="HistorySidebar" Margin="0,4,0,4" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- The panel's own surface. Transparent on the flat themes, which paint nothing
                     here and let the window through, and the white well on 98SE, where a panel
                     with no surface of its own is just an empty gray strip. -->
                <!-- Cancels the panel's inset so the well spans the same row height as
                     the content pane, then carries the same four-layer sunken edge. -->
                <Border Grid.RowSpan="3" Margin="0,-4,2,-4" Panel.ZIndex="-1"
                        Background="{DynamicResource SidebarPaneBrush}"/>
                <Border Grid.RowSpan="3" Margin="0,-4,2,-4" Panel.ZIndex="5" IsHitTestVisible="False"
                        BorderBrush="{DynamicResource PaneBevelDarkBrush}" BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
                <Border Grid.RowSpan="3" Margin="0,-4,2,-4" Panel.ZIndex="5" IsHitTestVisible="False"
                        BorderBrush="{DynamicResource PaneBevelLightBrush}" BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
                <Border Grid.RowSpan="3" Margin="1,-3,3,-3" Panel.ZIndex="5" IsHitTestVisible="False"
                        BorderBrush="{DynamicResource PaneBevelDark2Brush}" BorderThickness="{DynamicResource PaneBevel2LightThickness}"/>
                <Border Grid.RowSpan="3" Margin="1,-3,3,-3" Panel.ZIndex="5" IsHitTestVisible="False"
                        BorderBrush="{DynamicResource PaneBevelLight2Brush}" BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/>
                <!-- A DockPanel, not a horizontal StackPanel: the StackPanel gave the title unlimited
                     width, so a long translation ran off both sides of the sidebar. Here the title
                     gets the width beside the glyph and wraps to a second centered line when the
                     language needs it; short titles still size to their text and stay centered. -->
                <StackPanel Grid.Row="0">
                    <DockPanel x:Name="HistorySidebarHeader" HorizontalAlignment="Center" Margin="8,0,8,6">
                        <a11y:Glyph x:Name="SidebarSectionIcon" DockPanel.Dock="Left" Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,6,0"
                                   Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SidebarHeading" Text="{DynamicResource Str_History_Title}" TextAlignment="Center"
                                   Foreground="{DynamicResource PrimaryBrush}" FontFamily="{DynamicResource HeadingFont}"
                                   FontSize="20" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                    <!-- The Locations section's actions: a standard "+ New" button, then Import.
                         Saving a scan is in the Location picker. -->
                    <Grid x:Name="LocationsFooter" Margin="14,0,5,6" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="NewLocationButton" Style="{StaticResource SurfaceButton}" Click="NewLocation_Click"
                                Content="{DynamicResource Str_Loc_NewShort}" HorizontalAlignment="Left"
                                Height="26" FontSize="12" Padding="10,0" VerticalContentAlignment="Center">
                            <Button.ToolTip><TextBlock><Run Text="{DynamicResource Str_Loc_NewTitle}"/><Run Text=" (Ctrl+Alt+S)"/></TextBlock></Button.ToolTip>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource SurfaceButton}" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                Content="&#xE8B5;" Width="34" Height="26" Padding="0" Margin="6,0,0,0" Click="ImportLocation_Click"
                                ToolTip="{DynamicResource Str_Loc_Import}"/>
                    </Grid>
                </StackPanel>
                <ListBox x:Name="HistoryList" Grid.Row="1" AutomationProperties.Name="{DynamicResource Str_History_Title}" Background="Transparent" BorderThickness="0"
                         Margin="14,0,5,0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="HistoryList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="9,1"/>
                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" Background="Transparent" Margin="0,0,0,2"
                                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource SelectionBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- The saved date identifies the entry; the target is supporting detail. -->
                                <TextBlock Text="{Binding ScannedAt, StringFormat={}{0:g}}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" controls:ShrinkToFit.MinScale="0.85">
                                    <TextBlock.Style>
                                        <!-- Resting colour is a Setter, not an attribute on the
                                             element. A local value outranks a style trigger, so as
                                             an attribute it pinned the accent on and the selected
                                             row was accent text on the accent fill. -->
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding DisplayName}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" controls:ShrinkToFit.MinScale="0.85">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                                    <Setter Property="Opacity" Value="0.78"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <!-- Only filled when History lists every Location. -->
                                <TextBlock Text="{Binding LocationName}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" controls:ShrinkToFit.MinScale="0.85">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LocationName}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                                    <Setter Property="Opacity" Value="0.78"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>


                <!-- Third section: every Location, opened from Manage Locations in the Location
                     picker. A flat list for managing them: a click selects, a double-click or
                     Enter switches, and the right-click menu edits, exports or deletes. The
                     current Location carries a check. Saved scans live in the picker, not here
                     (LocationsSidebar.cs). -->
                <ListBox x:Name="LocationsList" Grid.Row="1" AutomationProperties.Name="{DynamicResource Str_Loc_ManageTitle}"
                         Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Margin="14,0,5,0" Visibility="Collapsed"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="LocationList_DoubleClick" PreviewKeyDown="LocationList_KeyDown">
                    <ListBox.Resources>
                        <!-- On the row container, not inside the template, so the Menu key and Shift+F10
                             open it for the focused row. -->
                        <ContextMenu x:Key="LocationRowMenu" x:Shared="False">
                                        <MenuItem Header="{DynamicResource Str_Loc_Open}" InputGestureText="Enter" Click="LocationOpen_Click">
                                            <MenuItem.Icon><a11y:Glyph Style="{StaticResource MenuIcon}" Text="&#xE707;"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Str_Loc_Edit}" InputGestureText="F2" Click="LocationRename_Click">
                                            <MenuItem.Icon><a11y:Glyph Style="{StaticResource MenuIcon}" Text="&#xE70F;"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Str_Loc_Export}" Click="LocationExport_Click">
                                            <MenuItem.Icon><a11y:Glyph Style="{StaticResource MenuIcon}" Text="&#xE896;"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="{DynamicResource Str_Loc_Delete}" InputGestureText="Delete" Click="LocationDelete_Click">
                                            <MenuItem.Icon><a11y:Glyph Style="{StaticResource MenuIcon}" Text="&#xE74D;"/></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="9,4"/>
                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                            <Setter Property="AutomationProperties.Name" Value="{Binding}"/>
                            <Setter Property="ContextMenu" Value="{StaticResource LocationRowMenu}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" Background="Transparent" Margin="0,0,0,2"
                                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource SelectionBg}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:LocationRow}">
                            <DockPanel ToolTip="{Binding Tip}">
                                <!-- The check marks the Location this scan is in. -->
                                <a11y:Glyph DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                            VerticalAlignment="Center" Margin="6,0,0,0">
                                    <a11y:Glyph.Style>
                                        <Style TargetType="a11y:Glyph">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </a11y:Glyph.Style>
                                </a11y:Glyph>
                                <a11y:Glyph Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Detail}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>
        </Grid>

        <!-- Drag edge for the sidebar. A Thumb rather than a GridSplitter, because the column
             next door is the fixed-width rail, matching KillerNotes. -->
        <Thumb x:Name="SidebarResizeGrip" Grid.Row="1" Grid.Column="0" Panel.ZIndex="50"
               HorizontalAlignment="Right" Margin="0,0,24,0" Width="5" Cursor="SizeWE"
               Visibility="Collapsed"
               DragDelta="SidebarResizeGrip_DragDelta" DragCompleted="SidebarResizeGrip_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Rectangle x:Name="hint" Width="1" HorizontalAlignment="{Binding HorizontalAlignment, RelativeSource={RelativeSource TemplatedParent}}" Opacity="0"
                                   Fill="{DynamicResource PaneBorderBrush}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hint" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="hint" Property="Opacity" Value="1"/>
                            <Setter TargetName="hint" Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <Border x:Name="SidebarToggleStrip" Grid.Row="1" Grid.Column="0" Panel.ZIndex="20"
                HorizontalAlignment="Right" Width="{DynamicResource RailWidth}" Background="Transparent">
        <Grid>
        <!-- Chevron: pinned to the top of the rail on its own, per the family rail order. -->
        <Button x:Name="SidebarToggleBtn" Style="{StaticResource RailButton}"
                Content="&#xE76C;" FontSize="16" Panel.ZIndex="20"
                VerticalAlignment="Top" HorizontalAlignment="Right" Margin="2,10,2,0"
                Click="SidebarToggle_Click"
                ToolTip="{DynamicResource Str_TT_ExpandSidebar}"/>

        <!-- Right-aligned inside the sidebar lane, so it rides the panel's inner lip and stays
             put at the window edge while the panel is collapsed. Width is pinned to the rail so
             the glyphs stay centred on their own strip however wide the lane gets. -->
        <StackPanel x:Name="RailButtons" VerticalAlignment="Bottom" Panel.ZIndex="20"
                    HorizontalAlignment="Right" Width="{DynamicResource RailWidth}" Margin="2,0,0,6">
            <Button x:Name="SpeedTestButton" Style="{StaticResource RailButton}" Content="&#xE9D2;"
                    FontSize="15" Click="SpeedTestButton_Click" Margin="0,0,0,10">
                <Button.ToolTip><TextBlock><Run Text="{DynamicResource Str_TT_SpeedTest}"/><Run Text=" (F4)"/></TextBlock></Button.ToolTip>
            </Button>
            <!-- Locations took the saved-scans slot when the two merged (2026-10-26). -->
            <Button x:Name="LocationsButton" Style="{StaticResource RailButton}" Content="&#xE707;"
                    FontSize="15" Click="LocationsButton_Click" Margin="0,0,0,10">
                <Button.ToolTip><TextBlock><Run Text="{DynamicResource Str_Loc_ManageTitle}"/><Run Text=" (Ctrl+Shift+P)"/></TextBlock></Button.ToolTip>
            </Button>
            <Button x:Name="HistoryButton" Style="{StaticResource RailButton}"
                    Content="&#xE81C;" FontSize="15"
                    Click="HistoryButton_Click" ContextMenuOpening="HistorySettingsMenu_Opening" Margin="0,0,0,10">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource Str_History_Settings}" InputGestureText="Ctrl+Alt+R"
                                  Click="HistorySettings_Click">
                            <MenuItem.Icon><a11y:Glyph Style="{StaticResource MenuIcon}" Text="&#xE81C;"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="HistoryAllLocationsItem" Header="{DynamicResource Str_History_AllLocations}"
                                  IsCheckable="True" Click="HistorySettingsMenu_LocationsClick"/>
                    </ContextMenu>
                </Button.ContextMenu>
                <Button.ToolTip>
                    <TextBlock><Run Text="{DynamicResource Str_History_Title}"/><Run Text=" (Ctrl+H)"/></TextBlock>
                </Button.ToolTip>
            </Button>
            <Button x:Name="ShortcutsButton" Style="{StaticResource RailButton}"
                    Content="?" FontFamily="Consolas" FontSize="18"
                    Click="ShortcutHelp_Click" Margin="0,0,0,10"
                    ToolTip="{DynamicResource Str_TT_Shortcuts}"/>
            <Button x:Name="LangButton" Style="{StaticResource RailButton}"
                    Content="&#xF2B7;" FontSize="15"
                    Click="LangButton_Click" ContextMenuOpening="RailLanguage_Opening" Margin="0,0,0,10"
                    ToolTip="{DynamicResource Str_TT_Language}">
                <Button.ContextMenu>
                    <ContextMenu x:Name="LangMenu" PreviewMouseWheel="Menu_ForwardWheelToGrid"/>
                </Button.ContextMenu>
            </Button>
            <Button x:Name="ThemeButton" Style="{StaticResource RailButton}"
                    Content="&#xE790;" FontSize="15"
                    Click="ThemeButton_Click" ToolTip="{DynamicResource Str_TT_Theme}"/>
        </StackPanel>
        </Grid>
        </Border>

        <!-- Devices pane - the lightest tier, lifted above the chrome with an outward drop shadow
             (kept tight to the bars; the shadow overlays them rather than adding gap) -->
        <!-- Named so the shadow can be switched off. Windows 98 had no drop shadows anywhere, and
             PaneShadow is a StaticResource effect that a palette cannot reach - so Theme.cs nulls
             the Effect on 98SE and restores it otherwise. Same approach KillerShell takes. -->
        <kl:UnclippedGrid x:Name="WorkspaceHost" Grid.Row="1" Grid.Column="1"
              Margin="{DynamicResource DevicesPaneMargin}" Panel.ZIndex="10">
        <Border x:Name="DevicesPaneShadow" Grid.Row="1" IsHitTestVisible="False"
                Background="{DynamicResource ScanContentPaneBrush}"
                CornerRadius="{DynamicResource PanelCornerRadius}"
                Effect="{StaticResource PaneShadow}"/>
        <controls:PickerBorder x:Name="DevicesPane" Grid.Row="1" SnapsToDevicePixels="True" UseLayoutRounding="True"
                Background="{DynamicResource ScanContentPaneBrush}"
                BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource PanelCornerRadius}">
            <Grid x:Name="TerminalLayout" WindowChrome.IsHitTestVisibleInChrome="True">
            </Grid>
        </controls:PickerBorder>
        <!-- The sunken edge around the content pane, drawn as four layers over it rather than as
             one border, because Win32's EDGE_SUNKEN is two tones on each side: #808080 then
             #000000 down the top and left, #ffffff then the face gray up the bottom and right. A
             single two-pixel gray has the right width and the wrong depth. Every thickness here is
             zero on the flat themes, so those draw nothing at all. Ported from KillerNotes. -->
        <Border Grid.Row="1" Panel.ZIndex="11" IsHitTestVisible="False"
                BorderBrush="{DynamicResource PaneBevelDarkBrush}"
                BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
        <Border Grid.Row="1" Panel.ZIndex="11" IsHitTestVisible="False"
                BorderBrush="{DynamicResource PaneBevelLightBrush}"
                BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
        <Border Grid.Row="1" Panel.ZIndex="11" IsHitTestVisible="False"
                Margin="{DynamicResource PaneBevelInnerMargin}"
                BorderBrush="{DynamicResource PaneBevelDark2Brush}"
                BorderThickness="{DynamicResource PaneBevel2LightThickness}"/>
        <Border Grid.Row="1" Panel.ZIndex="11" IsHitTestVisible="False"
                Margin="{DynamicResource PaneBevelInnerMargin}"
                BorderBrush="{DynamicResource PaneBevelLight2Brush}"
                BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/>
        </kl:UnclippedGrid>

        </kl:UnclippedGrid>
        <!-- end ScaleHost -->

        <!-- Status Bar -->
        <!-- ZIndex -1 so the content pane's shadow lands on the footer rather than being painted
             over by it. The footer is pushed down rather than the content row raised, which would
             also put it above the overlays declared later. -->
        <Border x:Name="FooterBar" Grid.Row="3" Panel.ZIndex="-1" Background="{DynamicResource FooterBackgroundBrush}">
          <Grid>
            <!-- FooterPadding: 16,0 on the flat themes (one continuous strip); 0 on 98SE, where
                 the strip breaks into sunken cells that run to the edges. -->
            <Grid Margin="{DynamicResource FooterPadding}">
                <!-- TWO cells now, not three: the wide LEFT cell is the status recess and it
                     ALSO holds the centered PORTABLE/install badge, so it runs from the left edge
                     right up to the version cell (Win98 status bars are a row of wide cells, the
                     first one dominant). The RIGHT cell is the version/copyright recess. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Film grain over the bar (negative margin pulls it to the full width) -->
                <Border Grid.ColumnSpan="2" IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}" Margin="-16,0">
                    <Border.Background>
                        <ImageBrush x:Name="StatusGrainBrush" TileMode="Tile"
                                    ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>
                    </Border.Background>
                </Border>
                <!-- WIDE SUNKEN STATUS CELL. Crossed bevels (dark in the Light slot) - a status
                     cell is a RECESS, not a button. Holds the status text (left) and the portable
                     badge (centered) in one recess. All four tokens zero on flat themes. -->
                <Grid Grid.Column="0" Margin="{DynamicResource FooterCellMargin}">
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource FooterBevelDarkBrush}"
                            BorderThickness="{DynamicResource FooterCellLightThickness}"/>
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource FooterBevelLightBrush}"
                            BorderThickness="{DynamicResource FooterCellDarkThickness}"/>
                    <!-- Clears the corner light, which ends 15px from the window edge. The flat
                         themes also have 16px of footer padding in front of this, but 98SE has
                         none, so a smaller margin here put the status text under the light. On the
                         cell's own content rather than the shared FooterCellPadding token, which
                         the version cell across the bar uses as well. -->
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0">
                    <!-- ToolTip is set to a placeholder so ToolTipOpening fires at all; the
                         handler replaces it with something written for the current view, or
                         cancels when there is nothing worth saying. ShowDuration is long
                         because the unknown-device list is read, not glanced at. -->
                    <!-- No fixed MaxWidth: FitFooterStatus measures the room up to the badge. -->
                    <TextBlock x:Name="StatusText" Text="Ready" TextTrimming="CharacterEllipsis"
                               AutomationProperties.LiveSetting="Polite"
                               Margin="{DynamicResource FooterCellPadding}" HorizontalAlignment="Left"
                               Foreground="{DynamicResource MutedTextBrush}" FontFamily="{DynamicResource BrandSansFont}"
                               FontSize="16" TextOptions.TextFormattingMode="Ideal" VerticalAlignment="Center"
                               ToolTip=" " ToolTipOpening="StatusText_ToolTipOpening"
                               ToolTipService.ShowDuration="30000" ToolTipService.InitialShowDelay="400"/>
                    <StackPanel x:Name="DeviceCountFooter" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <!-- Compact portable install action, centered against the complete footer/window,
                     not merely the shortened status cell to the left of the version block. -->
                <StackPanel x:Name="PortableBadge" Grid.ColumnSpan="2" Panel.ZIndex="5"
                            Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <!-- Labelled for the state it reports, not the action it offers, matching
                         KillerPDF: the badge tells you this copy is portable, and the tooltip
                         says what clicking it does. -->
                    <Button x:Name="InstallBtn" Content="{DynamicResource Str_Portable}"
                            Click="Install_Click" Style="{StaticResource OutlineButton}"
                            ToolTip="{DynamicResource Str_TT_Portable}"
                            FontFamily="{DynamicResource ChromeFontFamily}" FontSize="10" Padding="8,1"
                            VerticalAlignment="Center">
                        <Button.Resources>
                            <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
                        </Button.Resources>
                    </Button>
                </StackPanel>
                <!-- Version/progress cluster in its own sunken cell (crossed, like the status
                     cell). -->
                <Grid x:Name="VersionCell" Grid.Column="1" HorizontalAlignment="Right" Margin="{DynamicResource FooterCellMargin}">
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource FooterBevelDarkBrush}"
                            BorderThickness="{DynamicResource FooterCellLightThickness}"/>
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource FooterBevelLightBrush}"
                            BorderThickness="{DynamicResource FooterCellDarkThickness}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="{DynamicResource FooterCellPadding}">
                    <!-- Click anywhere on the address or the adapter to show or hide the detail.
                         Transparent background rather than none, so the whole strip is hit-testable
                         and not just the glyphs themselves. -->
                    <Border x:Name="NetworkFooterGroup" Background="Transparent" Cursor="Hand"
                            Margin="0,0,16,0" VerticalAlignment="Center"
                            MouseLeftButtonUp="NetworkFooter_Click"
                            ToolTip="{DynamicResource Str_TT_FooterNetwork}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <a11y:Glyph x:Name="NetworkFooterIcon" FontSize="13" FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NetworkFooter" FontSize="16" FontFamily="{DynamicResource BrandSansFont}" TextOptions.TextFormattingMode="Ideal"
                                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                            <!-- Adapter and link speed, each whole or not at all. No trimming: an
                                 ellipsis mid-adapter reads as damage rather than as a fit, so the
                                 speed goes first when the bar tightens and the adapter follows. -->
                            <TextBlock x:Name="NetworkFooterAdapter" FontSize="16" FontFamily="{DynamicResource BrandSansFont}" TextOptions.TextFormattingMode="Ideal"
                                       Foreground="{DynamicResource DimTextBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NetworkFooterSpeed" FontSize="16" FontFamily="{DynamicResource BrandSansFont}" TextOptions.TextFormattingMode="Ideal"
                                       Foreground="{DynamicResource DimTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ProgressBar x:Name="ScanProgress"
                                 Width="80" Height="4" VerticalAlignment="Center"
                                 Foreground="{DynamicResource HeaderLineBrush}"
                                 Background="{DynamicResource CardBorderBrush}"
                                 Visibility="Collapsed" Margin="0,0,12,0"/>
                    <TextBlock x:Name="VersionLabel" Opacity="0.75" Text="v1.5.2"
                               Foreground="{DynamicResource TextFooter}" FontFamily="{DynamicResource BrandSansFont}"
                               FontSize="16" TextOptions.TextFormattingMode="Ideal" VerticalAlignment="Center" Margin="0,0,12,0"
                               Cursor="Hand" ToolTip="{DynamicResource Str_TT_About}"
                               MouseLeftButtonUp="VersionLabel_Click"/>
                    <!-- 20px trailing margin keeps the copyright clear of the corner grip (family standard) -->
                    <TextBlock Opacity="0.75" FontSize="16" TextOptions.TextFormattingMode="Ideal" VerticalAlignment="Center"
                               FontFamily="{DynamicResource BrandSansFont}" Margin="0,0,20,0">
                        <Run Text="&#x00A9; 2026 " Foreground="{DynamicResource TextFooter}"/>
                        <Hyperlink NavigateUri="https://thekiller.net"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{DynamicResource TextFooter}" TextDecorations="None">
                            <Run Text="Steve the Killer"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                </Grid>
            </Grid>
            <!-- Scan state, in the corner itself rather than inside the status recess: amber for
                 nothing scanned or a scan stopped short, red while scanning, blue during a deep
                 pass, green when a scan finished. Outside the padded grid so it sits at the
                 window's own edge, and fixed colors rather than theme tokens, because a traffic
                 light means the same thing in all thirteen themes. -->
            <Border x:Name="ScanLight" Width="9" Height="9" CornerRadius="5" Panel.ZIndex="60"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"
                    Background="#E0A317" BorderThickness="1" BorderBrush="#40000000"/>
          </Grid>
        </Border>

        <!-- Bottom-right resize grip. Modern themes use the family six dots; 98SE switches to
             KillerNotes' three continuous beveled diagonal ridges. -->
        <Canvas x:Name="ResizeGripDots" Grid.Row="3" Width="13" Height="13" Panel.ZIndex="50"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                Background="Transparent" Cursor="SizeNWSE"
                MouseLeftButtonDown="ResizeGrip_MouseDown">
            <Canvas Visibility="{DynamicResource GripDotsVisibility}">
                <Rectangle Canvas.Left="10" Canvas.Top="2"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="6"  Canvas.Top="6"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="10" Canvas.Top="6"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="2"  Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="6"  Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="10" Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
            </Canvas>
            <Canvas Visibility="{DynamicResource GripLinesVisibility}">
                <Canvas.Resources>
                    <Style TargetType="Line">
                        <Setter Property="StrokeThickness" Value="1"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                    </Style>
                </Canvas.Resources>
                <Line X1="12.5" Y1="3.5"  X2="3.5"  Y2="12.5" Stroke="{DynamicResource BevelDarkBrush}"/>
                <Line X1="12.5" Y1="4.5"  X2="4.5"  Y2="12.5" Stroke="{DynamicResource BevelLightBrush}"/>
                <Line X1="12.5" Y1="6.5"  X2="6.5"  Y2="12.5" Stroke="{DynamicResource BevelDarkBrush}"/>
                <Line X1="12.5" Y1="7.5"  X2="7.5"  Y2="12.5" Stroke="{DynamicResource BevelLightBrush}"/>
                <Line X1="12.5" Y1="9.5"  X2="9.5"  Y2="12.5" Stroke="{DynamicResource BevelDarkBrush}"/>
                <Line X1="12.5" Y1="10.5" X2="10.5" Y2="12.5" Stroke="{DynamicResource BevelLightBrush}"/>
            </Canvas>
        </Canvas>


        <!-- Keyboard shortcuts overlay (F1 or the title-bar "?"). Same card chrome as the About
             overlay below; the rows are built in Shortcuts.cs so the list has one source of truth. -->
        <Grid x:Name="ShortcutsOverlay" Grid.RowSpan="4" Panel.ZIndex="9000" Visibility="Collapsed"
              Margin="{DynamicResource OverlayFrameBleed}"
              Background="#88000000" MouseLeftButtonDown="ShortcutsOverlay_Click">
            <Grid x:Name="ShortcutCardGrid" MaxWidth="420" Margin="24"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  MouseLeftButtonDown="ShortcutsCard_Click">
                <Border Background="{DynamicResource OverlayWindowBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.6"/>
                    </Border.Effect>
                </Border>
                <!-- PanelCornerRadius, not FlyoutCornerRadius: the shared KillerUI layer overwrites
                     FlyoutCornerRadius with 0,0,4,4 - a dropdown shape that hangs off a button, so
                     this centered card came out with square top corners. PanelCornerRadius is 6 on
                     every flat theme and 0 on 98SE, which is the shape a card wants. -->
                <Border Background="{DynamicResource OverlayWindowBrush}" BorderBrush="{DynamicResource OverlayEdgeBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}">
                    <Grid>
                        <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                                Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>

                        <Border VerticalAlignment="Top" ClipToBounds="True"
                                Height="{DynamicResource AboutCaptionHeight}"
                                Margin="{DynamicResource AboutCaptionMargin}"
                                Background="{DynamicResource TitleBarBrush}">
                            <TextBlock Text="{DynamicResource Str_Shortcuts_Title}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource ChromeFontFamily}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource ChromeTextBrush}"/>
                        </Border>

                        <!-- Glyph is a named TextBlock recolored by TargetName. Setting Foreground
                             on the Button would be a local value and would outrank the trigger, so
                             the hover would never take - the same trap the About overlay documents. -->
                        <Button Content="{DynamicResource AboutCloseGlyph}" Click="ShortcutsClose_Click" AutomationProperties.Name="{DynamicResource Str_Sys_Close}"
                                Style="{StaticResource OverlayCloseButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Width="{DynamicResource AboutCloseWidth}"
                                Height="{DynamicResource AboutCloseHeight}" Margin="{DynamicResource AboutCloseMargin}"
                                Panel.ZIndex="7"/>

                        <Grid Margin="{DynamicResource ShortcutsContentMargin}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ShortcutsTitle" Text="Keyboard shortcuts"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <!-- LIST / KEYBOARD, centered, active shown by foreground alone.
                                     KillerPDF's selector, not a pair of glyph buttons. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="12,0"
                                            VerticalAlignment="Center">
                                    <Button x:Name="ShortcutListViewButton" Style="{StaticResource ViewTabButton}"
                                            Content="{DynamicResource Str_KS_ViewList}"
                                            Margin="0,0,12,0" Click="ShortcutListView_Click"/>
                                    <Button x:Name="ShortcutMapViewButton" Style="{StaticResource ViewTabButton}"
                                            Content="{DynamicResource Str_KS_ViewKeyboard}"
                                            Click="ShortcutMapView_Click"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" FontFamily="{DynamicResource UiFont}" FontSize="11" Margin="12,0,24,0" MaxWidth="210"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap">
                                    <Hyperlink Click="OnlineHelp_Click" Focusable="True" Foreground="{DynamicResource PrimaryBrush}"
                                               ToolTip="https://killerscan.net/help.html#shortcuts"><Run Text="{DynamicResource Str_KS_OnlineHelp}"/></Hyperlink>
                                </TextBlock>
                            </Grid>
                            <ScrollViewer x:Name="ShortcutListHost" Grid.Row="1" Margin="{DynamicResource ShortcutsScrollBleed}"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Style="{StaticResource ShadowScrollViewer}">
                                <StackPanel Margin="{DynamicResource ShortcutsScrollInset}">
                                    <!-- Two authored columns with a fixed gutter, as in KillerPDF.
                                         Which category lands where is declared in the table, not
                                         balanced at runtime, so the grouping stays predictable. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel x:Name="ShortcutLeftColumn" Grid.Column="0"/>
                                        <StackPanel x:Name="ShortcutRightColumn" Grid.Column="2"/>
                                    </Grid>
                                    <TextBlock x:Name="ShortcutsHint" Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                            <Viewbox x:Name="ShortcutMapHost" Grid.Row="1" Visibility="Collapsed"
                                     Stretch="Uniform" StretchDirection="DownOnly"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel x:Name="ShortcutMapRows"/>
                            </Viewbox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- About overlay: dims the window behind it and shows a centered card (matches KillerPDF).
             The close X is blended into the card (no separate title bar) with a red hover. -->
        <Grid x:Name="AboutOverlay" Grid.RowSpan="4" Panel.ZIndex="9000" Visibility="Collapsed"
              Margin="{DynamicResource OverlayFrameBleed}"
              Background="#88000000" MouseLeftButtonDown="AboutOverlay_Click">
            <!-- No fixed width: the SHA-256 line never wraps, so it sizes the info panel and
                 the info panel sizes the card. The header below pins its width to that panel
                 so a long tagline wraps instead of widening the card. Family standard. -->
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MouseLeftButtonDown="AboutCard_Click">
                <!-- Shadow on a separate element so the card text stays crisp. Named so
                     ApplyFlatChrome (Theme.cs) can collapse it on 98SE - no shadows there,
                     and the card's elevation signal becomes the raised bevel below. -->
                <Border x:Name="AboutShadow" Background="{DynamicResource OverlayWindowBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.6"/>
                    </Border.Effect>
                </Border>
                <!-- PanelCornerRadius, not FlyoutCornerRadius: the shared KillerUI layer overwrites
                     FlyoutCornerRadius with 0,0,4,4 - a dropdown shape that hangs off a button, so
                     this centered card came out with square top corners. PanelCornerRadius is 6 on
                     every flat theme and 0 on 98SE, which is the shape a card wants. -->
                <Border Background="{DynamicResource OverlayWindowBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}">
                    <Grid>
                        <!-- Raised card bevel, KillerShell's About verbatim: FrameOuter pair, so on
                             98SE the card carries the same edge as the window. Nothing elsewhere. -->
                        <Border IsHitTestVisible="False" Panel.ZIndex="6"
                                BorderBrush="{DynamicResource FrameOuterLightBrush}"
                                BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
                        <Border IsHitTestVisible="False" Panel.ZIndex="6"
                                BorderBrush="{DynamicResource FrameOuterDarkBrush}"
                                BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
                        <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                                Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>

                        <Border VerticalAlignment="Top" ClipToBounds="True"
                                Height="{DynamicResource AboutCaptionHeight}"
                                Margin="{DynamicResource AboutCaptionMargin}"
                                Background="{DynamicResource TitleBarBrush}">
                            <TextBlock Text="{DynamicResource Str_About_Title}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource ChromeFontFamily}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource ChromeTextBrush}"/>
                        </Border>

                        <!-- Close X: just the glyph turns red on hover (no filled square), like KillerPDF.
                             Foreground is a Style setter (not a local value) so the hover trigger can win. -->
                        <Button Content="{DynamicResource AboutCloseGlyph}" Click="AboutClose_Click" AutomationProperties.Name="{DynamicResource Str_Sys_Close}"
                                Style="{StaticResource OverlayCloseButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Width="{DynamicResource AboutCloseWidth}"
                                Height="{DynamicResource AboutCloseHeight}" Margin="{DynamicResource AboutCloseMargin}"
                                Panel.ZIndex="7"/>

                        <StackPanel Margin="{DynamicResource ScanAboutContentMargin}">
                            <!-- Header: icon to the left of the wordmark + description + tagline.
                                 A Grid (not a horizontal StackPanel) so the text column is bounded and wraps.
                                 Width is pinned to the info panel so the SHA-256 line stays the only thing
                                 that sets the card width. -->
                            <Grid Margin="0,4,0,14" Width="{Binding ActualWidth, ElementName=AboutInfoGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <icons:AppIcon Grid.Column="0" Source="pack://application:,,,/Resources/ks-icon.ico" Width="58" Height="58"
                                       Margin="0,0,15,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <icons:AppIcon.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.55"/>
                                    </icons:AppIcon.Effect>
                                </icons:AppIcon>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,4" HorizontalAlignment="Left">
                                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" Margin="1,2,0,0" IsHitTestVisible="False"
                                                   Opacity="{DynamicResource WordmarkShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="2"/></TextBlock.Effect><Run Text="Killer" FontSize="17.21" Foreground="#C0000000"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Scan" FontSize="25.85" Foreground="#C0000000"/></TextBlock>
                                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" Margin="1,2,0,0" IsHitTestVisible="False"
                                                   Opacity="{DynamicResource WordmarkAccentShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="3"/></TextBlock.Effect><Run Text="Killer" FontSize="17.21" Foreground="Transparent"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Scan" FontSize="25.85" Foreground="#D8000000"/></TextBlock>
                                        <TextBlock theme:Bevel.Enabled="True" FontFamily="{DynamicResource WordmarkFont}"><Run Text="Killer" FontSize="17.21" Foreground="{DynamicResource TextBrush}"/><Run FontFamily="{DynamicResource WordmarkAccentFont}" Text="Scan" FontSize="25.85" Foreground="{DynamicResource AccentLogo}"/></TextBlock>
                                    </Grid>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"><Run Text="{DynamicResource Str_About_DescA}"/><Run Text="GPLv3 "/><Hyperlink NavigateUri="https://killertools.net" RequestNavigate="AboutLink_Navigate" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None">Killer Tools</Hyperlink><Run Text="{DynamicResource Str_About_DescB}"/></TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- Info panel - matte, lifted above the grainy card. Named: the header
                                 binds its width to this panel (see above). -->
                            <Grid x:Name="AboutInfoGrid">
                                <!-- Carries the panel's opaque fill AND the shadow (KillerShell's
                                     construction). The shadow opacity is the theme token, 0 on
                                     98SE, so this border must stay visible there - it is now the
                                     panel's only fill. -->
                                <Border x:Name="AboutInfoShadow" Background="{DynamicResource AboutPanelBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="{DynamicResource FlyoutShadowOpacity}"/>
                                    </Border.Effect>
                                </Border>
                                <!-- The Win98 sunken edge: gray above and left, white below and
                                     right, which is the inverse of a raised button and what makes
                                     a white panel read as a client area rather than a card. Both
                                     borders are transparent at zero thickness on every other
                                     theme, so they draw nothing there. -->
                                <Border IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource AboutPanelBevelTopBrush}"
                                        BorderThickness="{DynamicResource AboutPanelBevelTopThickness}"/>
                                <Border IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource AboutPanelBevelBottomBrush}"
                                        BorderThickness="{DynamicResource AboutPanelBevelBottomThickness}"/>
                                <!-- Grain on the info panel too, KillerShell's About verbatim: the
                                     opaque fill lives on the shadow border above, the grain is its
                                     own layer, and the content border below is transparent so both
                                     show through. Text renders above the grain and stays crisp.
                                     98SE needs no special case - its GrainOpacity is 0. -->
                                <Border IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>
                                <Border Background="Transparent"
                                        BorderBrush="{DynamicResource AboutPanelEdgeBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}" Padding="14,12,14,4">
                                    <StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Version}" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="10"/>
                                            <!-- One row, two ends: version accent left, release date muted and
                                                 italic hard right. Bottom-aligned so the two sizes share a
                                                 baseline. Only the version text is clickable. -->
                                            <Grid Margin="0,1,0,0">
                                                <TextBlock x:Name="AboutVersionBlock" Foreground="{DynamicResource PrimaryBrush}"
                                                           FontFamily="{DynamicResource UiFont}" FontSize="13" Cursor="Hand"
                                                           HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                           MouseLeftButtonUp="AboutVersion_Click"/>
                                                <TextBlock x:Name="AboutReleaseDateBlock" Foreground="{DynamicResource MutedTextBrush}"
                                                           FontFamily="{DynamicResource UiFont}" FontSize="11" FontStyle="Italic"
                                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Publisher}" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="10"/>
                                            <TextBlock x:Name="AboutPublisherBlock" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,1,0,0"/>
                                            <!-- Shown only on an exe signed by Steve. The alias is an accent link to
                                                 thekiller.net; "AKA" stays muted so the eye lands on the name. -->
                                            <TextBlock x:Name="AboutAkaBlock" Visibility="Collapsed" Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="11" Margin="0,3,0,0"><Run Text="{DynamicResource Str_About_Aka}"/><Hyperlink NavigateUri="https://thekiller.net" RequestNavigate="AboutLink_Navigate" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None" ToolTip="thekiller.net"><Run x:Name="AboutAkaRun"/></Hyperlink></TextBlock>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Thumbprint}" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="10"/>
                                            <TextBlock x:Name="AboutThumbprintBlock" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Sha}" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="10"/>
                                            <TextBlock x:Name="AboutSha256Block" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="11" TextWrapping="NoWrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Db}" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="10"/>
                                            <TextBlock x:Name="AboutDbBlock" Foreground="{DynamicResource TextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                            <TextBlock FontFamily="{DynamicResource UiFont}" FontSize="11" Margin="0,2,0,0">
                                                <Hyperlink x:Name="AboutDbUpdateLink" Click="AboutDbUpdate_Click" Foreground="{DynamicResource PrimaryBrush}"><Run Text="{DynamicResource Str_About_DbUpdate}"/></Hyperlink>
                                            </TextBlock>
                                            <TextBlock x:Name="AboutDbStatus" Foreground="{DynamicResource DimTextBrush}" FontFamily="{DynamicResource UiFont}" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource PaneBevelDarkBrush}"
                                        BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
                                <Border IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource PaneBevelLightBrush}"
                                        BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
                                <Border IsHitTestVisible="False" Margin="{DynamicResource PaneBevelInnerMargin}"
                                        BorderBrush="{DynamicResource PaneBevelDark2Brush}"
                                        BorderThickness="{DynamicResource PaneBevel2LightThickness}"/>
                                <Border IsHitTestVisible="False" Margin="{DynamicResource PaneBevelInnerMargin}"
                                        BorderBrush="{DynamicResource PaneBevelLight2Brush}"
                                        BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/>
                                <Border IsHitTestVisible="False" VerticalAlignment="Top"
                                        Height="{DynamicResource ScanPaneBandSize}" Background="{DynamicResource ScanPaneTopBrush}"/>
                                <Border IsHitTestVisible="False" HorizontalAlignment="Left"
                                        Width="{DynamicResource ScanPaneBandSize}" Background="{DynamicResource ScanPaneLeftBrush}"/>
                                <Border IsHitTestVisible="False" HorizontalAlignment="Right"
                                        Width="{DynamicResource ScanPaneBandSize}" Background="{DynamicResource ScanPaneRightBrush}"/>
                                <Border IsHitTestVisible="False" VerticalAlignment="Bottom"
                                        Height="{DynamicResource ScanPaneBandSize}" Background="{DynamicResource ScanPaneBottomBrush}"/>
                            </Grid>

                            <!-- About options sit below the identity pane, the startup check first. -->
                            <Grid Margin="0,12,0,0" Width="{Binding ActualWidth, ElementName=AboutInfoGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="AboutStartupUpdateCheck"
                                          FontSize="11" Click="AboutStartupUpdateCheck_Click">
                                    <TextBlock Text="{DynamicResource Str_About_StartupUpdateCheck}" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox x:Name="AboutShowShortcutsInMenus" Grid.Column="2" FontSize="11"
                                          IsChecked="{Binding Source={x:Static kl:ShortcutHints.Current}, Path=Enabled, Mode=TwoWay}">
                                    <TextBlock Text="{DynamicResource Str_About_ShowShortcutsInMenus}" TextWrapping="Wrap"/>
                                </CheckBox>
                            </Grid>

                            <!-- Update notice: shown only when a newer release is found -->
                            <Button x:Name="AboutUpdateButton" Style="{StaticResource OutlineButton}" Padding="14,7" Visibility="Collapsed" Margin="0,14,0,0"
                                    HorizontalAlignment="Left" Cursor="Hand" Click="AboutUpdateButton_Click">
                                <TextBlock x:Name="AboutUpdateText" Text="Update available" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                            </Button>

                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

    </Grid>
    <!-- /RootGrid -->

        <!-- Window frame, copied from KillerNotes. Each ring occupies its own depth instead of
             painting several unrelated bands over the same right and bottom pixels. -->
        <Border Panel.ZIndex="9001" IsHitTestVisible="False"
                BorderBrush="{DynamicResource FrameOuterLightBrush}"
                BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
        <Border Panel.ZIndex="9001" IsHitTestVisible="False"
                BorderBrush="{DynamicResource FrameOuterDarkBrush}"
                BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
        <Border Panel.ZIndex="8999" IsHitTestVisible="False"
                Margin="{DynamicResource WindowFrameMargin}"
                BorderBrush="{DynamicResource WindowFrameBrush}"
                BorderThickness="{DynamicResource WindowFrameThickness}"/>
        <Border Panel.ZIndex="9000" IsHitTestVisible="False"
                Margin="{DynamicResource FrameInnerMargin}"
                BorderBrush="{DynamicResource FrameInnerLightBrush}"
                BorderThickness="{DynamicResource FrameInnerLightThickness}"/>
        <Border Panel.ZIndex="9000" IsHitTestVisible="False"
                Margin="{DynamicResource FrameInnerMargin}"
                BorderBrush="{DynamicResource FrameInnerDarkBrush}"
                BorderThickness="{DynamicResource FrameInnerDarkThickness}"/>
        <!-- RootGrid is inset inside the 98SE sizing frame, so its modal backdrops cannot
             reliably paint over that frame. This sibling dims only the exposed frame area;
             RootGrid (z=9500) covers its center while its own overlay dims the client. -->
        <Border x:Name="FrameDimmer" Panel.ZIndex="9400" IsHitTestVisible="False"
                Background="#88000000" Visibility="Collapsed"/>
        </Grid>
    </Border>
    <!-- /WindowFrame -->
</Window>
