<Window x:Class="KillerScan.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KillerScan.Shell"
        xmlns:cm="clr-namespace:System.ComponentModel;assembly=System"
        mc:Ignorable="d"
        Title="KillerScan"
        Height="700" Width="1025"
        MinHeight="500" MinWidth="800"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        BorderThickness="0"
        BorderBrush="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Icon="pack://application:,,,/Resources/ks-icon.ico">

    <!-- Native custom chrome (no AllowsTransparency): WPF composites on the GPU and Windows
         draws the drop shadow + rounds the HWND (Win11, via DWMWA_WINDOW_CORNER_PREFERENCE in
         WindowChrome.cs). The 36px title bar becomes the draggable caption; interactive bits in
         it opt back in with WindowChrome.IsHitTestVisibleInChrome. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="8"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- WIN98 WINDOW FRAME, ported from KillerShell verbatim. Zero-thickness / transparent on
         every flat theme (DWM does the edge there); on 98SE it is the hard raised sizing border.
         WindowFrame fills the whole window with the frame face; the client-face Border repaints
         the flat window color INSIDE the frame; four directional bevels sit on the rim; RootGrid
         is inset by WindowFramePadding so a strip of frame shows on every side - the notepad
         edge. The bevels must be siblings of the client face, NOT padding on a wrapper, or the
         raised edge draws inward instead of on the rim. -->
    <!-- Exact KillerNotes frame hierarchy: outer directional ring, a separate 3px gradient
         face, then the inner directional ring. Keeping the face in its own Border prevents the
         right and bottom from becoming alternating full-height stripes. -->
    <Border x:Name="WindowFrame" BorderBrush="{DynamicResource WindowEdgeBrush}"
            BorderThickness="{DynamicResource WindowEdgeThickness}" SnapsToDevicePixels="True">
        <Grid x:Name="FrameHost">

    <Grid x:Name="RootGrid" Opacity="0" Panel.ZIndex="9500" Margin="{DynamicResource WindowFramePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>     <!-- 0: title bar -->
            <RowDefinition Height="Auto"/>   <!-- 1: scan toolbar -->
            <RowDefinition Height="*"/>      <!-- 2: devices pane -->
            <RowDefinition Height="24"/>     <!-- 3: footer / status bar (24px + 11.5/10.5 type, family standard) -->
        </Grid.RowDefinitions>

        <!-- TitleBarBrush: equal to the window background on every flat theme, the Win98 navy
             gradient on 98SE. What makes that work is the swap below - a real Win98 caption has no
             logotype in it, just the icon and the window's name in plain bold, so on 98SE the
             wordmark and subtitle collapse and PlainTitle shows instead. Painting the wordmark
             onto navy was the alternative and it does not work: "Killer" is TextBrush (black
             there) and "Scan" is PrimaryBrush (navy by default there). Same answer KillerShell
             reached. Theme.cs drives the visibilities. -->
        <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}">
            <Grid>
                <!-- Film grain over the bar (behind content) -->
                <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}" Margin="0,0,0,1">
                    <Border.Background>
                        <ImageBrush x:Name="TitleGrainBrush" TileMode="Tile"
                                    ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>
                    </Border.Background>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{DynamicResource ScanTitleBarPadding}">
                    <Image x:Name="TitleIcon" Source="pack://application:,,,/Resources/ks-icon.png" Width="27" Height="27"
                            VerticalAlignment="Center" Margin="0,0,7,0"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            MouseWheel="LogoBar_MouseWheel"
                            MouseLeftButtonDown="LogoBar_MouseLeftButtonDown"
                            ToolTip="{DynamicResource Str_TT_AppSize}"
                            RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- The 98SE caption title. A Win98 caption carries the window's name in plain
                         bold, not a logotype, so this shows only there and the wordmark collapses.
                         Wheel-zoomable and drag-enabled like the wordmark, because on 98SE it is
                         the ONLY thing in the caption to roll the wheel over - without that the
                         app-size control would simply be unreachable on this theme. -->
                    <TextBlock x:Name="PlainTitle" Text="KillerScan" Visibility="Collapsed"
                               VerticalAlignment="Center" Background="Transparent"
                               WindowChrome.IsHitTestVisibleInChrome="True"
                               MouseWheel="LogoBar_MouseWheel"
                               MouseLeftButtonDown="LogoBar_MouseLeftButtonDown"
                               ToolTip="{DynamicResource Str_TT_AppSize}"
                               FontFamily="Segoe UI" FontWeight="Bold" FontSize="11"
                               Foreground="{DynamicResource ChromeTextBrush}"/>
                    <!-- Typewriter wordmark with KillerPDF-style soft shadow: a blurred dark copy behind the
                         crisp text, faded by IconShadowOpacity (0 in light mode = no shadow).
                         Rolling the wheel over it drives the app-wide size (AppScale.cs). The
                         hit-test opt-in that lets the wheel reach it also takes it out of
                         WindowChrome's native caption, so drag and double-click-maximize are
                         restored by hand in AppScale.cs. The website link lives in About. -->
                    <Grid x:Name="LogoBar" VerticalAlignment="Center" Background="Transparent"
                          WindowChrome.IsHitTestVisibleInChrome="True"
                          MouseWheel="LogoBar_MouseWheel"
                          MouseLeftButtonDown="LogoBar_MouseLeftButtonDown"
                          ToolTip="{DynamicResource Str_TT_AppSize}">
                        <StackPanel Orientation="Horizontal" Margin="1,2,0,0" Opacity="{DynamicResource IconShadowOpacity}">
                            <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="18"><Run Text="Killer" Foreground="#D8000000"/><Run Text="Scan" FontSize="23.4" FontWeight="Bold" Foreground="#D8000000"/></TextBlock>
                        </StackPanel>
                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="18"><Run Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run Text="Scan" FontSize="23.4" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/></TextBlock>
                    </Grid>
                    <TextBlock x:Name="SubtitleText" Text="{DynamicResource Str_Subtitle}" Foreground="{DynamicResource MutedTextBrush}"
                               FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Margin="10,2,0,0"/>
                </StackPanel>

                <!-- The shortcuts, language and theme buttons used to sit here, left of the
                     window controls. They moved to the rail down the left of the content area
                     (2026-08-11) so KillerScan matches the rest of the family, where those three
                     are always the bottom of the rail in that order. The title bar now carries
                     the wordmark and the window controls only. -->

                <!-- Window Controls (Segoe MDL2 glyphs, matched to KillerPDF) -->
                <!-- CaptionButtonsMargin: 0 on every flat theme so the buttons run flush to the
                     window edge; on 98SE it insets them from the raised frame. VerticalAlignment
                     is Top rather than Stretch because the 98SE buttons are 16px in a 22px bar and
                     must sit against the top, not be stretched down it. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="{DynamicResource ScanCaptionButtonsMargin}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE921;" Click="MinimizeBtn_Click" Style="{StaticResource ChromeButton}"/>
                    <Button x:Name="MaximizeBtn" Content="&#xE922;" Click="MaximizeBtn_Click" Style="{StaticResource ChromeButton}"/>
                    <Button Content="&#xE8BB;" Click="CloseBtn_Click" Style="{StaticResource ChromeCloseButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The workspace host and theme-aware icon rail share the content area. -->
        <Grid x:Name="ScaleHost" Grid.Row="1" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 0: scan toolbar -->
                <RowDefinition Height="*"/>      <!-- 1: devices pane -->
            </Grid.RowDefinitions>

            <!-- Column 0 is the sidebar lane: the history panel with the icon rail on its inner
                 lip, exactly as KillerNotes lays it out. Collapsed it is the rail's own width,
                 so the rail sits at the window edge and the app looks as it always has; opening
                 history widens the column and carries the rail along with it. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="{DynamicResource RailColumnWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        <!-- Chrome strip behind the pane, so the side margins carry the grain like the other bars -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource BackgroundBrush}">
            <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}">
                <Border.Background><ImageBrush x:Name="GrainBrush" TileMode="Tile"
                    ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/></Border.Background>
            </Border>
        </Border>

        <!-- The family rail has a single hairline at its content edge. -->
        <Border x:Name="WorkspaceRailSeparator" Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource PaneBorderBrush}"
                BorderThickness="0,0,1,0" IsHitTestVisible="False"
                Margin="{DynamicResource RailSeparatorMargin}"
                Visibility="{DynamicResource RailSeparatorVisibility}"/>

        <!-- ================================================================
             ICON RAIL (column 0).

             Family order, and it is fixed: app-specific toggles first, then ?,
             then language, then theme, with theme always bottom-most. The three
             universal buttons land in the same place in every app so muscle
             memory carries across. KillerScan has no app-specific toggles and
             nothing to collapse, so it has no chevron and the rail is just those
             three, pinned to the bottom.
             ================================================================ -->
        <!-- Left margin 2, not 0: the panel is centred, so trimming 2px off the left of the
             available width shifts every glyph 1px toward the pane, which is where they read as
             centred on the strip. Same trick and same reason as the collapse chevron's
             Margin="2,10,0,0" in KillerNotes and Killendar. -->
        <!-- Theme + accent flyout. Both rail menus are positioned against DevicesPane's
             lower-left corner, matching KillerShell. Display/ClearType is deliberately local:
             this Popup must not inherit the zoom host's fractional-scale grayscale renderer. -->
        <Popup x:Name="ThemePopup" StaysOpen="False" AllowsTransparency="True"
               HorizontalOffset="-17" VerticalOffset="-13"
               TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
               UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Border Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                    BorderThickness="1" CornerRadius="{DynamicResource FlyoutCornerRadius}" Padding="12,10" Margin="22,18,22,26"
                    PreviewMouseWheel="Menu_ForwardWheelToGrid">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.55"/>
                </Border.Effect>
                <Grid>
                    <!-- Grain LAST inside the Grid would sit over the rows; here it is first but
                         the selected row's fill is transparent, so the texture still reads through
                         every row including the checked one. -->
                    <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}" CornerRadius="{DynamicResource PaneGrainCornerRadius}" Margin="-12,-10">
                        <Border.Background>
                            <ImageBrush x:Name="FlyoutGrainBrush" TileMode="Tile"
                                        ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>
                        </Border.Background>
                    </Border>
                    <Grid x:Name="ThemeMenuContent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Named rows, not dots: twelve swatches do not fit, and a dot for a
                             grunge palette would be an invented color. Tag carries the Theme enum
                             name, so one handler serves every row and adding a theme is one line.
                             Order is presentation, deliberately NOT the enum's order, and matches
                             KillerShell and KillerNotes so the family lists themes the same way.
                             98SE slots in after Black when it lands. -->
                        <StackPanel x:Name="ThemeRadios" Grid.Column="0" Width="120">
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Dark"      Content="{DynamicResource Str_Theme_Dark}"      Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Light"     Content="{DynamicResource Str_Theme_Light}"     Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Black"     Content="{DynamicResource Str_Theme_Black}"     Checked="ThemeRadio_Checked"/>
                            <!-- Tag is SE98, the enum member; the label reads "98SE". -->
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="SE98"      Content="{DynamicResource Str_Theme_SE98}"      Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Blood"     Content="{DynamicResource Str_Theme_Blood}"     Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Greed"     Content="{DynamicResource Str_Theme_Greed}"     Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Cyanotic"  Content="{DynamicResource Str_Theme_Cyanotic}"  Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Ectoplasm" Content="{DynamicResource Str_Theme_Ectoplasm}" Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Decay"     Content="{DynamicResource Str_Theme_Decay}"     Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Malaise"   Content="{DynamicResource Str_Theme_Malaise}"   Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Sepulchre" Content="{DynamicResource Str_Theme_Sepulchre}" Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Delirium"  Content="{DynamicResource Str_Theme_Delirium}"  Checked="ThemeRadio_Checked"/>
                            <RadioButton Style="{StaticResource ThemeRadio}" GroupName="ThemeGroup" Tag="Mourning"  Content="{DynamicResource Str_Theme_Mourning}"  Checked="ThemeRadio_Checked"/>
                        </StackPanel>
                        <Grid x:Name="AccentStripHost" Grid.Column="1" Width="0" ClipToBounds="True">
                            <Border Width="1" HorizontalAlignment="Left" Margin="0,6"
                                    Background="{DynamicResource MenuBorderBrush}"/>
                            <Grid x:Name="AccentStrip" Margin="7,6,2,6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/><RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/><RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/><RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Button x:Name="AccentStripDot0" Grid.Row="0" Style="{StaticResource ThemeSwatch}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" Click="AccentSwatch_Click"/>
                                <Button x:Name="AccentStripDot1" Grid.Row="1" Style="{StaticResource ThemeSwatch}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" Click="AccentSwatch_Click"/>
                                <Button x:Name="AccentStripDot2" Grid.Row="2" Style="{StaticResource ThemeSwatch}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" Click="AccentSwatch_Click"/>
                                <Button x:Name="AccentStripDot3" Grid.Row="3" Style="{StaticResource ThemeSwatch}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" Click="AccentSwatch_Click"/>
                                <Button x:Name="AccentStripDot4" Grid.Row="4" Style="{StaticResource ThemeSwatch}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0,0,0,8" Click="AccentSwatch_Click"/>
                                <Button x:Name="AccentStripDot5" Grid.Row="5" Style="{StaticResource ThemeSwatch}" Width="26" Height="Auto" VerticalAlignment="Stretch" Margin="0" Click="AccentSwatch_Click"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Popup>

        <!-- Original family rail for every geometrically flat theme. It remains inside the
             accessibility LayoutTransform exactly as before the 98SE work. -->
        <!-- ==== HISTORY SIDEBAR (column 0, behind the rail) ==============================
             Clipped so the panel can be frozen at full width and wiped by the column tween
             rather than reflowing to nothing as it closes. -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,24,0" ClipToBounds="True"
              Visibility="{DynamicResource ScaledRailVisibility}">
            <Grid x:Name="HistorySidebar" Margin="14,14,0,10" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="SidebarHeading" Grid.Row="0" Text="{DynamicResource Str_History_Title}" Margin="1,0,8,12"
                           Foreground="{DynamicResource PrimaryBrush}" FontFamily="{DynamicResource WordmarkFont}"
                           FontSize="20" TextTrimming="CharacterEllipsis"/>
                <ListBox x:Name="HistoryList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         Margin="0,0,8,0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="HistoryList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="9,7"/>
                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" Background="Transparent" Margin="0,0,0,3"
                                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource SelectionBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- The target carries the accent: it is the identity of the entry,
                                     and the timestamp under it is the supporting detail. -->
                                <TextBlock Text="{Binding Target}" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding ScannedAt, StringFormat={}{0:g}}" FontSize="12" Margin="0,2,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                                    <Setter Property="Opacity" Value="0.78"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Second section, sharing the row so the two cross-fade in place. -->
                <ListBox x:Name="ProfilesList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         Margin="0,0,8,0" HorizontalContentAlignment="Stretch" Visibility="Collapsed"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{Binding ItemContainerStyle, ElementName=HistoryList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{DynamicResource Str_Profiles_Run}" Click="ProfileRun_Click"/>
                                        <MenuItem Header="{DynamicResource Str_Profiles_Load}" Click="ProfileLoad_Click"/>
                                        <MenuItem Header="{DynamicResource Str_Profiles_Deep}" IsCheckable="True"
                                                  IsChecked="{Binding DeepScanAfter, Mode=OneWay}" Click="ProfileDeep_Click"/>
                                        <Separator/>
                                        <MenuItem Header="{DynamicResource Str_Profiles_Delete}" Click="ProfileDelete_Click"/>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource PrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Target}" FontSize="12" Margin="0,2,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource SelectionFg}"/>
                                                    <Setter Property="Opacity" Value="0.78"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button x:Name="SaveProfileButton" Grid.Row="2" Content="{DynamicResource Str_Profiles_Save}"
                        HorizontalAlignment="Left" Margin="9,8,0,0" FontSize="11" Visibility="Collapsed"
                        Style="{StaticResource LinkButton}" Click="SaveProfile_Click"/>
            </Grid>
        </Grid>

        <!-- Drag edge for the sidebar. A Thumb rather than a GridSplitter, because the column
             next door is the fixed-width rail, matching KillerNotes. -->
        <Thumb x:Name="SidebarResizeGrip" Grid.Row="1" Grid.Column="0" Panel.ZIndex="50"
               HorizontalAlignment="Right" Margin="0,0,24,0" Width="5" Cursor="SizeWE"
               Visibility="Collapsed"
               DragDelta="SidebarResizeGrip_DragDelta" DragCompleted="SidebarResizeGrip_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Rectangle x:Name="hint" Width="1" HorizontalAlignment="Right" Opacity="0"
                                   Fill="{DynamicResource PaneBorderBrush}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hint" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="hint" Property="Opacity" Value="1"/>
                            <Setter TargetName="hint" Property="Fill" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- Chevron: pinned to the top of the rail on its own, per the family rail order. -->
        <Button x:Name="SidebarToggleBtn" Grid.Row="1" Grid.Column="0" Style="{StaticResource RailButton}"
                Content="&#xE76C;" FontSize="12" Panel.ZIndex="20"
                VerticalAlignment="Top" HorizontalAlignment="Right" Margin="2,10,2,0"
                Click="SidebarToggle_Click" Visibility="{DynamicResource ScaledRailVisibility}"
                ToolTip="{DynamicResource Str_TT_ExpandSidebar}"/>

        <!-- Right-aligned inside the sidebar lane, so it rides the panel's inner lip and stays
             put at the window edge while the panel is collapsed. Width is pinned to the rail so
             the glyphs stay centred on their own strip however wide the lane gets. -->
        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Bottom" Panel.ZIndex="20"
                    HorizontalAlignment="Right" Width="{DynamicResource RailWidth}" Margin="2,0,0,10"
                    Visibility="{DynamicResource ScaledRailVisibility}">
            <Button x:Name="ProfilesButton" Style="{StaticResource RailButton}" Content="&#xE8D5;"
                    FontSize="15" Click="ProfilesButton_Click" Margin="0,0,0,10">
                <Button.ToolTip><TextBlock><Run Text="{DynamicResource Str_Profiles_Title}"/><Run Text=" (F10)"/></TextBlock></Button.ToolTip>
            </Button>
            <Button x:Name="HistoryButton" Style="{StaticResource RailButton}"
                    Content="&#xE81C;" FontSize="15"
                    Click="HistoryButton_Click" Margin="0,0,0,10">
                <Button.ToolTip>
                    <TextBlock><Run Text="{DynamicResource Str_History_Title}"/><Run Text=" (F6)"/></TextBlock>
                </Button.ToolTip>
            </Button>
            <Button x:Name="ShortcutsButton" Style="{StaticResource RailButton}"
                    Content="?" FontFamily="Consolas" FontSize="18"
                    Click="ShortcutHelp_Click" Margin="0,0,0,10"
                    ToolTip="{DynamicResource Str_TT_Shortcuts}"/>
            <Button x:Name="LangButton" Style="{StaticResource RailButton}"
                    Content="&#xF2B7;" FontSize="15"
                    Click="LangButton_Click" Margin="0,0,0,10"
                    ToolTip="{DynamicResource Str_TT_Language}">
                <Button.ContextMenu>
                    <ContextMenu x:Name="LangMenu" PreviewMouseWheel="Menu_ForwardWheelToGrid"/>
                </Button.ContextMenu>
            </Button>
            <Button x:Name="ThemeButton" Style="{StaticResource RailButton}"
                    Content="&#xE790;" FontSize="15"
                    Click="ThemeButton_Click" ToolTip="{DynamicResource Str_TT_Theme}"/>
        </StackPanel>

        <!-- Devices pane - the lightest tier, lifted above the chrome with an outward drop shadow
             (kept tight to the bars; the shadow overlays them rather than adding gap) -->
        <!-- Named so the shadow can be switched off. Windows 98 had no drop shadows anywhere, and
             PaneShadow is a StaticResource effect that a palette cannot reach - so Theme.cs nulls
             the Effect on 98SE and restores it otherwise. Same approach KillerShell takes. -->
        <Grid x:Name="WorkspaceHost" Grid.Row="1" Grid.Column="1"
              Margin="{DynamicResource DevicesPaneMargin}" Panel.ZIndex="10">
        <Border x:Name="DevicesPane" Grid.Row="1"
                Background="{DynamicResource ScanContentPaneBrush}"
                BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="0"
                CornerRadius="{DynamicResource PanelCornerRadius}"
                Effect="{StaticResource PaneShadow}">
            <Grid x:Name="TerminalLayout" WindowChrome.IsHitTestVisibleInChrome="True">
            </Grid>
        </Border>
        </Grid>

        </Grid>
        <!-- end ScaleHost -->

        <!-- The family rail is window furniture, not scalable document content. Keeping it
             outside ScaleHost matches KillerShell/KillerNotes and prevents fractional app zoom
             from rasterizing these small glyphs between device pixels. -->
        <!-- Left margin tracks the sidebar lane, so this rail stays on the panel's inner lip
             like the scaled one rather than being stranded at the window edge when history
             opens. Set from ApplySidebarState, since the lane is animated. -->
        <StackPanel x:Name="FixedRail" Grid.Row="2" Width="{DynamicResource RailWidth}" VerticalAlignment="Bottom"
                    HorizontalAlignment="Left" Margin="0,0,0,10" Panel.ZIndex="30"
                    Visibility="{DynamicResource FixedRailVisibility}">
            <Button x:Name="FixedProfilesButton" Style="{StaticResource RailButton}" Content="&#xE8D5;"
                    FontSize="15" Click="ProfilesButton_Click" Margin="0,0,0,10">
                <Button.ToolTip><TextBlock><Run Text="{DynamicResource Str_Profiles_Title}"/><Run Text=" (F10)"/></TextBlock></Button.ToolTip>
            </Button>
            <Button x:Name="FixedHistoryButton" Style="{StaticResource RailButton}"
                    Content="&#xE81C;" FontSize="15"
                    Click="HistoryButton_Click" Margin="0,0,0,10">
                <Button.ToolTip>
                    <TextBlock><Run Text="{DynamicResource Str_History_Title}"/><Run Text=" (F6)"/></TextBlock>
                </Button.ToolTip>
            </Button>
            <Button x:Name="FixedShortcutsButton" Style="{StaticResource RailButton}"
                    Content="?" FontFamily="Consolas" FontSize="18"
                    Click="ShortcutHelp_Click" Margin="0,0,0,10"
                    ToolTip="{DynamicResource Str_TT_Shortcuts}"/>
            <Button x:Name="FixedLangButton" Style="{StaticResource RailButton}"
                    Content="&#xF2B7;" FontSize="15"
                    Click="LangButton_Click" Margin="0,0,0,10"
                    ToolTip="{DynamicResource Str_TT_Language}">
                <Button.ContextMenu>
                    <ContextMenu x:Name="FixedLangMenu" PreviewMouseWheel="Menu_ForwardWheelToGrid"/>
                </Button.ContextMenu>
            </Button>
            <Button x:Name="FixedThemeButton" Style="{StaticResource RailButton}"
                    Content="&#xE790;" FontSize="15"
                    Click="ThemeButton_Click" ToolTip="{DynamicResource Str_TT_Theme}"/>
        </StackPanel>

        <!-- Status Bar -->
        <!-- ZIndex -1 so the content pane's shadow lands on the footer rather than being painted
             over by it. The footer is pushed down rather than the content row raised, which would
             also put it above the overlays declared later. -->
        <Border Grid.Row="3" Panel.ZIndex="-1" Background="{DynamicResource BackgroundBrush}">
            <!-- FooterPadding: 16,0 on the flat themes (one continuous strip); 0 on 98SE, where
                 the strip breaks into sunken cells that run to the edges. -->
            <Grid Margin="{DynamicResource FooterPadding}">
                <!-- TWO cells now, not three: the wide LEFT cell is the status recess and it
                     ALSO holds the centered PORTABLE/install badge, so it runs from the left edge
                     right up to the version cell (Win98 status bars are a row of wide cells, the
                     first one dominant). The RIGHT cell is the version/copyright recess. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Film grain over the bar (negative margin pulls it to the full width) -->
                <Border Grid.ColumnSpan="2" IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}" Margin="-16,0">
                    <Border.Background>
                        <ImageBrush x:Name="StatusGrainBrush" TileMode="Tile"
                                    ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>
                    </Border.Background>
                </Border>
                <!-- WIDE SUNKEN STATUS CELL. Crossed bevels (dark in the Light slot) - a status
                     cell is a RECESS, not a button. Holds the status text (left) and the portable
                     badge (centered) in one recess. All four tokens zero on flat themes. -->
                <Grid Grid.Column="0" Margin="{DynamicResource FooterCellMargin}">
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource FooterBevelDarkBrush}"
                            BorderThickness="{DynamicResource FooterCellLightThickness}"/>
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource FooterBevelLightBrush}"
                            BorderThickness="{DynamicResource FooterCellDarkThickness}"/>
                    <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusText" Text="Ready" MaxWidth="230" TextTrimming="CharacterEllipsis"
                               Margin="{DynamicResource FooterCellPadding}" HorizontalAlignment="Left"
                               Foreground="{DynamicResource MutedTextBrush}" FontFamily="Consolas"
                               FontSize="11.5" VerticalAlignment="Center"/>
                    <StackPanel x:Name="DeviceCountFooter" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <!-- Compact portable install action, centered against the complete footer/window,
                     not merely the shortened status cell to the left of the version block. -->
                <StackPanel x:Name="PortableBadge" Grid.ColumnSpan="2" Panel.ZIndex="5"
                            Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Button x:Name="InstallBtn" Content="{DynamicResource Str_InstallBtn}"
                            Click="Install_Click" Style="{StaticResource OutlineButton}"
                            FontFamily="{DynamicResource ChromeFontFamily}" FontSize="10" Padding="8,1"
                            VerticalAlignment="Center">
                        <Button.Resources>
                            <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
                        </Button.Resources>
                    </Button>
                </StackPanel>
                <!-- Version/progress cluster in its own sunken cell (crossed, like the status
                     cell). -->
                <Grid Grid.Column="1" HorizontalAlignment="Right" Margin="{DynamicResource FooterCellMargin}">
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource FooterBevelDarkBrush}"
                            BorderThickness="{DynamicResource FooterCellLightThickness}"/>
                    <Border IsHitTestVisible="False"
                            BorderBrush="{DynamicResource FooterBevelLightBrush}"
                            BorderThickness="{DynamicResource FooterCellDarkThickness}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="{DynamicResource FooterCellPadding}">
                    <TextBlock x:Name="NetworkFooter" FontSize="10" FontFamily="Consolas"
                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="ScanProgress"
                                 Width="80" Height="4" VerticalAlignment="Center"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Background="{DynamicResource CardBorderBrush}"
                                 Visibility="Collapsed" Margin="0,0,12,0"/>
                    <TextBlock x:Name="VersionLabel" Text="v1.5.2"
                               Foreground="{DynamicResource TextFooter}" FontFamily="Consolas"
                               FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"
                               Cursor="Hand" ToolTip="{DynamicResource Str_TT_About}"
                               MouseLeftButtonUp="VersionLabel_Click"/>
                    <!-- 14px trailing margin keeps the copyright clear of the corner grip (family standard) -->
                    <TextBlock FontSize="10" VerticalAlignment="Center"
                               FontFamily="Consolas" Margin="0,0,14,0">
                        <Run Text="&#x00A9; 2026 " Foreground="{DynamicResource TextFooter}"/>
                        <Hyperlink NavigateUri="https://thekiller.net"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{DynamicResource TextFooter}" TextDecorations="None">
                            <Run Text="Steve the Killer"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Bottom-right resize grip. Modern themes use the family six dots; 98SE switches to
             KillerNotes' three continuous beveled diagonal ridges. -->
        <Canvas x:Name="ResizeGripDots" Grid.Row="3" Width="13" Height="13" Panel.ZIndex="50"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                Background="Transparent" Cursor="SizeNWSE"
                MouseLeftButtonDown="ResizeGrip_MouseDown">
            <Canvas Visibility="{DynamicResource GripDotsVisibility}">
                <Rectangle Canvas.Left="10" Canvas.Top="2"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="6"  Canvas.Top="6"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="10" Canvas.Top="6"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="2"  Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="6"  Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
                <Rectangle Canvas.Left="10" Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
            </Canvas>
            <Canvas Visibility="{DynamicResource GripHatchVisibility}">
                <Canvas.Resources>
                    <Style TargetType="Line">
                        <Setter Property="StrokeThickness" Value="1"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                    </Style>
                </Canvas.Resources>
                <Line X1="12.5" Y1="3.5"  X2="3.5"  Y2="12.5" Stroke="{DynamicResource BevelDarkBrush}"/>
                <Line X1="12.5" Y1="4.5"  X2="4.5"  Y2="12.5" Stroke="{DynamicResource BevelLightBrush}"/>
                <Line X1="12.5" Y1="6.5"  X2="6.5"  Y2="12.5" Stroke="{DynamicResource BevelDarkBrush}"/>
                <Line X1="12.5" Y1="7.5"  X2="7.5"  Y2="12.5" Stroke="{DynamicResource BevelLightBrush}"/>
                <Line X1="12.5" Y1="9.5"  X2="9.5"  Y2="12.5" Stroke="{DynamicResource BevelDarkBrush}"/>
                <Line X1="12.5" Y1="10.5" X2="10.5" Y2="12.5" Stroke="{DynamicResource BevelLightBrush}"/>
            </Canvas>
        </Canvas>


        <!-- Keyboard shortcuts overlay (F1 or the title-bar "?"). Same card chrome as the About
             overlay below; the rows are built in Shortcuts.cs so the list has one source of truth. -->
        <Grid x:Name="ShortcutsOverlay" Grid.RowSpan="4" Panel.ZIndex="9000" Visibility="Collapsed"
              Margin="{DynamicResource OverlayFrameBleed}"
              Background="#88000000" MouseLeftButtonDown="ShortcutsOverlay_Click">
            <Grid x:Name="ShortcutCardGrid" MaxWidth="420" Margin="24"
                  HorizontalAlignment="Stretch" VerticalAlignment="Center"
                  MouseLeftButtonDown="ShortcutsCard_Click">
                <Border Background="{DynamicResource OverlayWindowBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.6"/>
                    </Border.Effect>
                </Border>
                <!-- PanelCornerRadius, not FlyoutCornerRadius: the shared KillerUI layer overwrites
                     FlyoutCornerRadius with 0,0,4,4 - a dropdown shape that hangs off a button, so
                     this centered card came out with square top corners. PanelCornerRadius is 6 on
                     every flat theme and 0 on 98SE, which is the shape a card wants. -->
                <Border Background="{DynamicResource OverlayWindowBrush}" BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}">
                    <Grid>
                        <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                                Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>

                        <Border VerticalAlignment="Top" ClipToBounds="True"
                                Height="{DynamicResource AboutCaptionHeight}"
                                Margin="{DynamicResource AboutCaptionMargin}"
                                Background="{DynamicResource TitleBarBrush}">
                            <TextBlock Text="{DynamicResource Str_Shortcuts_Title}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource ChromeFontFamily}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource ChromeTextBrush}"/>
                        </Border>

                        <!-- Glyph is a named TextBlock recolored by TargetName. Setting Foreground
                             on the Button would be a local value and would outrank the trigger, so
                             the hover would never take - the same trap the About overlay documents. -->
                        <Button Content="{DynamicResource AboutCloseGlyph}" Click="ShortcutsClose_Click"
                                Style="{StaticResource OverlayCloseButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Width="{DynamicResource AboutCloseWidth}"
                                Height="{DynamicResource AboutCloseHeight}" Margin="{DynamicResource AboutCloseMargin}"
                                Panel.ZIndex="7"/>

                        <Grid Margin="{DynamicResource ShortcutsContentMargin}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <TextBlock x:Name="ShortcutsTitle" Text="Keyboard shortcuts"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="ShortcutListViewButton" Content="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                                            Width="28" Height="24" Margin="0,0,6,0" Click="ShortcutListView_Click"/>
                                    <Button x:Name="ShortcutMapViewButton" Content="&#xE765;" FontFamily="Segoe MDL2 Assets"
                                            Width="28" Height="24" Click="ShortcutMapView_Click"/>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer x:Name="ShortcutListHost" Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Grid x:Name="ShortcutList">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="112"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                    </Grid>
                                    <TextBlock x:Name="ShortcutsHint" Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                            <Viewbox x:Name="ShortcutMapHost" Grid.Row="1" Visibility="Collapsed"
                                     Stretch="Uniform" StretchDirection="DownOnly"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel x:Name="ShortcutMapRows"/>
                            </Viewbox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- About overlay: dims the window behind it and shows a centered card (matches KillerPDF).
             The close X is blended into the card (no separate title bar) with a red hover. -->
        <Grid x:Name="AboutOverlay" Grid.RowSpan="4" Panel.ZIndex="9000" Visibility="Collapsed"
              Margin="{DynamicResource OverlayFrameBleed}"
              Background="#88000000" MouseLeftButtonDown="AboutOverlay_Click">
            <!-- No fixed width: the SHA-256 line never wraps, so it sizes the info panel and
                 the info panel sizes the card. The header below pins its width to that panel
                 so a long tagline wraps instead of widening the card. Family standard. -->
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" MouseLeftButtonDown="AboutCard_Click">
                <!-- Shadow on a separate element so the card text stays crisp. Named so
                     ApplyFlatChrome (Theme.cs) can collapse it on 98SE - no shadows there,
                     and the card's elevation signal becomes the raised bevel below. -->
                <Border x:Name="AboutShadow" Background="{DynamicResource OverlayWindowBrush}" CornerRadius="{DynamicResource PanelCornerRadius}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.6"/>
                    </Border.Effect>
                </Border>
                <!-- PanelCornerRadius, not FlyoutCornerRadius: the shared KillerUI layer overwrites
                     FlyoutCornerRadius with 0,0,4,4 - a dropdown shape that hangs off a button, so
                     this centered card came out with square top corners. PanelCornerRadius is 6 on
                     every flat theme and 0 on 98SE, which is the shape a card wants. -->
                <Border Background="{DynamicResource OverlayWindowBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource PanelCornerRadius}">
                    <Grid>
                        <!-- Raised card bevel, KillerShell's About verbatim: FrameOuter pair, so on
                             98SE the card carries the same edge as the window. Nothing elsewhere. -->
                        <Border IsHitTestVisible="False" Panel.ZIndex="6"
                                BorderBrush="{DynamicResource FrameOuterLightBrush}"
                                BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
                        <Border IsHitTestVisible="False" Panel.ZIndex="6"
                                BorderBrush="{DynamicResource FrameOuterDarkBrush}"
                                BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
                        <Border IsHitTestVisible="False" CornerRadius="{DynamicResource PanelCornerRadius}"
                                Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>

                        <Border VerticalAlignment="Top" ClipToBounds="True"
                                Height="{DynamicResource AboutCaptionHeight}"
                                Margin="{DynamicResource AboutCaptionMargin}"
                                Background="{DynamicResource TitleBarBrush}">
                            <TextBlock Text="{DynamicResource Str_About_Title}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       FontFamily="{DynamicResource ChromeFontFamily}" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource ChromeTextBrush}"/>
                        </Border>

                        <!-- Close X: just the glyph turns red on hover (no filled square), like KillerPDF.
                             Foreground is a Style setter (not a local value) so the hover trigger can win. -->
                        <Button Content="{DynamicResource AboutCloseGlyph}" Click="AboutClose_Click"
                                Style="{StaticResource OverlayCloseButton}" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Width="{DynamicResource AboutCloseWidth}"
                                Height="{DynamicResource AboutCloseHeight}" Margin="{DynamicResource AboutCloseMargin}"
                                Panel.ZIndex="7"/>

                        <StackPanel Margin="{DynamicResource ScanAboutContentMargin}">
                            <!-- Header: icon to the left of the wordmark + description + tagline.
                                 A Grid (not a horizontal StackPanel) so the text column is bounded and wraps.
                                 Width is pinned to the info panel so the SHA-256 line stays the only thing
                                 that sets the card width. -->
                            <Grid Margin="0,4,0,14" Width="{Binding ActualWidth, ElementName=AboutInfoGrid}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="pack://application:,,,/Resources/ks-icon.png" Width="58" Height="58"
                                       Margin="0,0,15,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.55"/>
                                    </Image.Effect>
                                </Image>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,4" HorizontalAlignment="Left">
                                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" Margin="1,2,0,0" IsHitTestVisible="False"
                                                   Opacity="{DynamicResource IconShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="2"/></TextBlock.Effect><Run Text="Killer" FontSize="22" Foreground="#C0000000"/><Run Text="Scan" FontSize="28.6" FontWeight="Bold" Foreground="#C0000000"/></TextBlock>
                                        <TextBlock FontFamily="{DynamicResource WordmarkFont}"><Run Text="Killer" FontSize="22" Foreground="{DynamicResource TextBrush}"/><Run Text="Scan" FontSize="28.6" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/></TextBlock>
                                    </Grid>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"><Run Text="{DynamicResource Str_About_DescA}"/><Run Text="GPLv3 "/><Hyperlink NavigateUri="https://killertools.net" RequestNavigate="AboutLink_Navigate" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None">Killer Tools</Hyperlink><Run Text="{DynamicResource Str_About_DescB}"/></TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- Info panel - matte, lifted above the grainy card. Named: the header
                                 binds its width to this panel (see above). -->
                            <Grid x:Name="AboutInfoGrid">
                                <!-- Carries the panel's opaque fill AND the shadow (KillerShell's
                                     construction). The shadow opacity is the theme token, 0 on
                                     98SE, so this border must stay visible there - it is now the
                                     panel's only fill. -->
                                <Border x:Name="AboutInfoShadow" Background="{DynamicResource MenuBackgroundBrush}" CornerRadius="{DynamicResource ControlCornerRadius}" IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="{DynamicResource FlyoutShadowOpacity}"/>
                                    </Border.Effect>
                                </Border>
                                <!-- Grain on the info panel too, KillerShell's About verbatim: the
                                     opaque fill lives on the shadow border above, the grain is its
                                     own layer, and the content border below is transparent so both
                                     show through. Text renders above the grain and stays crisp.
                                     98SE needs no special case - its GrainOpacity is 0. -->
                                <Border IsHitTestVisible="False" CornerRadius="{DynamicResource ControlCornerRadius}"
                                        Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>
                                <Border Background="Transparent"
                                        BorderBrush="{DynamicResource PaneBorderBrush}" BorderThickness="1"
                                        CornerRadius="{DynamicResource ControlCornerRadius}" Padding="14,12,14,4">
                                    <StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Version}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <!-- One row, two ends: version accent left, release date muted and
                                                 italic hard right. Bottom-aligned so the two sizes share a
                                                 baseline. Only the version text is clickable. -->
                                            <Grid Margin="0,1,0,0">
                                                <TextBlock x:Name="AboutVersionBlock" Foreground="{DynamicResource PrimaryBrush}"
                                                           FontFamily="Consolas" FontSize="13" Cursor="Hand"
                                                           HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                           MouseLeftButtonUp="AboutVersion_Click"/>
                                                <TextBlock x:Name="AboutReleaseDateBlock" Foreground="{DynamicResource MutedTextBrush}"
                                                           FontFamily="Consolas" FontSize="11" FontStyle="Italic"
                                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Publisher}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <TextBlock x:Name="AboutPublisherBlock" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,1,0,0"/>
                                            <!-- Shown only on an exe signed by Steve. The alias is an accent link to
                                                 thekiller.net; "AKA" stays muted so the eye lands on the name. -->
                                            <TextBlock x:Name="AboutAkaBlock" Visibility="Collapsed" Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="11" Margin="0,3,0,0"><Run Text="{DynamicResource Str_About_Aka}"/><Hyperlink NavigateUri="https://thekiller.net" RequestNavigate="AboutLink_Navigate" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None" ToolTip="thekiller.net"><Run x:Name="AboutAkaRun"/></Hyperlink></TextBlock>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Thumbprint}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <TextBlock x:Name="AboutThumbprintBlock" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Sha}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <TextBlock x:Name="AboutSha256Block" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Db}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <TextBlock x:Name="AboutDbBlock" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                            <TextBlock FontFamily="Consolas" FontSize="11" Margin="0,2,0,0">
                                                <Hyperlink x:Name="AboutDbUpdateLink" Click="AboutDbUpdate_Click" Foreground="{DynamicResource PrimaryBrush}"><Run Text="{DynamicResource Str_About_DbUpdate}"/></Hyperlink>
                                            </TextBlock>
                                            <TextBlock x:Name="AboutDbStatus" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource PaneBevelDarkBrush}"
                                        BorderThickness="{DynamicResource PaneBevelLightThickness}"/>
                                <Border IsHitTestVisible="False"
                                        BorderBrush="{DynamicResource PaneBevelLightBrush}"
                                        BorderThickness="{DynamicResource PaneBevelDarkThickness}"/>
                                <Border IsHitTestVisible="False" Margin="{DynamicResource PaneBevelInnerMargin}"
                                        BorderBrush="{DynamicResource PaneBevelDark2Brush}"
                                        BorderThickness="{DynamicResource PaneBevel2LightThickness}"/>
                                <Border IsHitTestVisible="False" Margin="{DynamicResource PaneBevelInnerMargin}"
                                        BorderBrush="{DynamicResource PaneBevelLight2Brush}"
                                        BorderThickness="{DynamicResource PaneBevel2DarkThickness}"/>
                                <Border IsHitTestVisible="False" VerticalAlignment="Top"
                                        Height="{DynamicResource ScanPaneBandSize}" Background="{DynamicResource ScanPaneTopBrush}"/>
                                <Border IsHitTestVisible="False" HorizontalAlignment="Left"
                                        Width="{DynamicResource ScanPaneBandSize}" Background="{DynamicResource ScanPaneLeftBrush}"/>
                                <Border IsHitTestVisible="False" HorizontalAlignment="Right"
                                        Width="{DynamicResource ScanPaneBandSize}" Background="{DynamicResource ScanPaneRightBrush}"/>
                                <Border IsHitTestVisible="False" VerticalAlignment="Bottom"
                                        Height="{DynamicResource ScanPaneBandSize}" Background="{DynamicResource ScanPaneBottomBrush}"/>
                            </Grid>

                            <!-- Update notice: shown only when a newer release is found -->
                            <Button x:Name="AboutUpdateButton" Visibility="Collapsed" Margin="0,14,0,0"
                                    HorizontalAlignment="Left" Cursor="Hand" Click="AboutUpdateButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ub" Background="Transparent" BorderBrush="{DynamicResource PrimaryBrush}"
                                                BorderThickness="1" CornerRadius="{DynamicResource ControlCornerRadius}" Padding="14,7">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ub" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="AboutUpdateText" Text="Update available" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </Button>

                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

    </Grid>
    <!-- /RootGrid -->

        <!-- Window frame, copied from KillerNotes. Each ring occupies its own depth instead of
             painting several unrelated bands over the same right and bottom pixels. -->
        <Border Panel.ZIndex="9001" IsHitTestVisible="False"
                BorderBrush="{DynamicResource FrameOuterLightBrush}"
                BorderThickness="{DynamicResource FrameOuterLightThickness}"/>
        <Border Panel.ZIndex="9001" IsHitTestVisible="False"
                BorderBrush="{DynamicResource FrameOuterDarkBrush}"
                BorderThickness="{DynamicResource FrameOuterDarkThickness}"/>
        <Border Panel.ZIndex="8999" IsHitTestVisible="False"
                Margin="{DynamicResource WindowFrameMargin}"
                BorderBrush="{DynamicResource WindowFrameBrush}"
                BorderThickness="{DynamicResource WindowFrameThickness}"/>
        <Border Panel.ZIndex="9000" IsHitTestVisible="False"
                Margin="{DynamicResource FrameInnerMargin}"
                BorderBrush="{DynamicResource FrameInnerLightBrush}"
                BorderThickness="{DynamicResource FrameInnerLightThickness}"/>
        <Border Panel.ZIndex="9000" IsHitTestVisible="False"
                Margin="{DynamicResource FrameInnerMargin}"
                BorderBrush="{DynamicResource FrameInnerDarkBrush}"
                BorderThickness="{DynamicResource FrameInnerDarkThickness}"/>
        <!-- RootGrid is inset inside the 98SE sizing frame, so its modal backdrops cannot
             reliably paint over that frame. This sibling dims only the exposed frame area;
             RootGrid (z=9500) covers its center while its own overlay dims the client. -->
        <Border x:Name="FrameDimmer" Panel.ZIndex="9400" IsHitTestVisible="False"
                Background="#88000000" Visibility="Collapsed"/>
        </Grid>
    </Border>
    <!-- /WindowFrame -->
</Window>
