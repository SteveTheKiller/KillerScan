                    </DataGrid.ContextMenu>

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource TableHeaderBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource HeaderLineBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Grid>
                                        <Border x:Name="hdrBg"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                <TextBlock x:Name="sortGlyph" Grid.Column="1"
                                                           Text="&#x25B2;" FontSize="8"
                                                           VerticalAlignment="Center" Margin="6,1,0,0"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                        <!-- Column-resize grippers: WPF wires resize drags to these exact
                                             PART_ names; the old template dropped them, which killed column
                                             resizing. Invisible 8px grab zones straddling each column edge,
                                             so defaults stay as designed but users can drag. -->
                                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                                               Width="8" Margin="-4,0,0,0" Cursor="SizeWE">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                                               Width="8" Margin="0,0,-4,0" Cursor="SizeWE">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb"><Border Background="Transparent"/></ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="SortDirection" Value="{x:Static cm:ListSortDirection.Ascending}">
                                                <Setter TargetName="sortGlyph" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="sortGlyph" Property="Text" Value="&#x25B2;"/>
                                            </Trigger>
                                            <Trigger Property="SortDirection" Value="{x:Static cm:ListSortDirection.Descending}">
                                                <Setter TargetName="sortGlyph" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="sortGlyph" Property="Text" Value="&#x25BC;"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="hdrBg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="hdrBg" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColIp" Header="{DynamicResource Str_Col_Ip}" Binding="{Binding IpAddress}" Width="Auto" MinWidth="92" SortMemberPath="IpSortKey"/>
                        <DataGridTextColumn x:Name="ColHost" Header="{DynamicResource Str_Col_Host}" Binding="{Binding Hostname}" Width="Auto" MinWidth="142" MaxWidth="220"/>
                        <DataGridTextColumn x:Name="ColMac" Header="{DynamicResource Str_Col_Mac}" Binding="{Binding MacAddress}" Width="Auto" MinWidth="110"/>
                        <DataGridTextColumn x:Name="ColVendor" Header="{DynamicResource Str_Col_Vendor}" Binding="{Binding Vendor}" Width="2*"/>
                        <DataGridTemplateColumn x:Name="ColType" Header="{DynamicResource Str_Col_Type}" Width="Auto" MinWidth="95" SortMemberPath="DeviceType">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeviceType}" FontWeight="Medium">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Router">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeRouter}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Router/DNS">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeRouter}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Windows">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeWindows}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Windows Server">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeWindows}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Printer">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypePrinter}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Switch/AP">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeSwitch}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Hypervisor">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeHypervisor}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="NAS">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeNas}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="IoT">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeIot}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Server">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeServer}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Linux/SSH">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeLinux}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="DNS Server">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeDns}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Home Assistant">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeHa}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Mobile">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeMobile}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Camera">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeCamera}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Apple Device">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeSwitch}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Smart TV">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeSmarttv}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Apple TV">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeSwitch}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DeviceType}" Value="Media Streamer">
                                                        <Setter Property="Foreground" Value="{DynamicResource TypeMedia}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="ColPorts" Header="{DynamicResource Str_Col_Ports}" Binding="{Binding OpenPortsDisplay}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
                                    <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
                                    <!-- Full port list on hover: the cell truncates, the tooltip wraps and shows every open port. -->
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <TextBlock Text="{Binding OpenPortsDisplay}" TextWrapping="Wrap" MaxWidth="360"/>
                                        </Setter.Value>
                                    </Setter>
                                    <!-- No open ports: nothing worth a tooltip. -->
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OpenPortsDisplay}" Value="-">
                                            <Setter Property="ToolTip" Value="{x:Null}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        </Grid>
        <!-- end ScaleHost -->

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource BackgroundBrush}">
            <Grid Margin="16,0">
                <!-- Three zones so the centered PORTABLE badge and the right-hand version/progress
                     cluster live in separate columns and can never overlap. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Film grain over the bar (negative margin pulls it to the full width) -->
                <Border Grid.ColumnSpan="3" IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}" Margin="-16,0">
                    <Border.Background>
                        <ImageBrush x:Name="StatusGrainBrush" TileMode="Tile"
                                    ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>
                    </Border.Background>
                </Border>
                <TextBlock x:Name="StatusText" Grid.Column="0" Text="Ready"
                           Foreground="{DynamicResource ChromeTextBrush}" FontFamily="Consolas"
                           FontSize="11.5" VerticalAlignment="Center"/>
                <!-- Portable mode indicator (hidden when installed) -->
                <StackPanel x:Name="PortableBadge" Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource Str_Portable}" Foreground="{DynamicResource TextFooter}"
                               FontFamily="Consolas" FontSize="9"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="InstallBtn" Content="{DynamicResource Str_InstallBtn}"
                            Click="Install_Click" Style="{StaticResource OutlineButton}"
                            FontFamily="Segoe UI" FontSize="10" Padding="8,1"
                            VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ProgressBar x:Name="ScanProgress"
                                 Width="200" Height="4" VerticalAlignment="Center"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Background="{DynamicResource CardBorderBrush}"
                                 Visibility="Collapsed" Margin="0,0,12,0"/>
                    <TextBlock x:Name="VersionLabel" Text="v1.5.2"
                               Foreground="{DynamicResource TextFooter}" FontFamily="Consolas"
                               FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"
                               Cursor="Hand" ToolTip="About KillerScan"
                               MouseLeftButtonUp="VersionLabel_Click"/>
                    <!-- 14px trailing margin keeps the copyright clear of the corner grip (family standard) -->
                    <TextBlock FontSize="10" VerticalAlignment="Center"
                               FontFamily="Consolas" Margin="0,0,14,0">
                        <Run Text="&#x00A9; 2026 " Foreground="{DynamicResource TextFooter}"/>
                        <Hyperlink NavigateUri="https://thekiller.net"
                                   RequestNavigate="Hyperlink_RequestNavigate"
                                   Foreground="{DynamicResource TextFooter}" TextDecorations="None">
                            <Run Text="Steve the Killer"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Custom bottom-right resize grip (6 dots), ported from KillerPDF. Sits at the visible
             content corner and forwards a HTBOTTOMRIGHT resize to Windows on drag. -->
        <Canvas x:Name="ResizeGripDots" Grid.Row="3" Width="13" Height="13" Panel.ZIndex="50"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                Background="Transparent" Cursor="SizeNWSE"
                MouseLeftButtonDown="ResizeGrip_MouseDown">
            <Rectangle Canvas.Left="10" Canvas.Top="2"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
            <Rectangle Canvas.Left="6"  Canvas.Top="6"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
            <Rectangle Canvas.Left="10" Canvas.Top="6"  Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
            <Rectangle Canvas.Left="2"  Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
            <Rectangle Canvas.Left="6"  Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
            <Rectangle Canvas.Left="10" Canvas.Top="10" Width="2" Height="2" Fill="{DynamicResource DimTextBrush}"/>
        </Canvas>

        <!-- Keyboard shortcuts overlay (F1 or the title-bar "?"). Same card chrome as the About
             overlay below; the rows are built in Shortcuts.cs so the list has one source of truth. -->
        <Grid x:Name="ShortcutsOverlay" Grid.RowSpan="4" Panel.ZIndex="9000" Visibility="Collapsed"
              Background="#88000000" MouseLeftButtonDown="ShortcutsOverlay_Click">
            <Grid Width="420" VerticalAlignment="Center" MouseLeftButtonDown="ShortcutsCard_Click">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.6"/>
                    </Border.Effect>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Border IsHitTestVisible="False" CornerRadius="6"
                                Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>

                        <!-- Glyph is a named TextBlock recoloured by TargetName. Setting Foreground
                             on the Button would be a local value and would outrank the trigger, so
                             the hover would never take - the same trap the About overlay documents. -->
                        <Button Click="ShortcutsClose_Click" HorizontalAlignment="Right"
                                VerticalAlignment="Top" Width="28" Height="26" Margin="0,6,6,0"
                                Panel.ZIndex="2"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <TextBlock x:Name="glyph" Text="&#x2715;" FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource DangerRed}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <StackPanel Margin="24,18,24,18">
                            <TextBlock x:Name="ShortcutsTitle" Text="Keyboard shortcuts"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>
                            <Grid x:Name="ShortcutList">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <TextBlock x:Name="ShortcutsHint" Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- About overlay: dims the window behind it and shows a centred card (matches KillerPDF).
             The close X is blended into the card (no separate title bar) with a red hover. -->
        <Grid x:Name="AboutOverlay" Grid.RowSpan="4" Panel.ZIndex="9000" Visibility="Collapsed"
              Background="#88000000" MouseLeftButtonDown="AboutOverlay_Click">
            <Grid Width="454" VerticalAlignment="Center" MouseLeftButtonDown="AboutCard_Click">
                <!-- Shadow on a separate element so the card text stays crisp -->
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="5" Direction="270" Opacity="0.6"/>
                    </Border.Effect>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Border IsHitTestVisible="False" CornerRadius="6"
                                Opacity="{DynamicResource GrainOpacity}" Background="{DynamicResource GrainTileBrush}"/>

                        <!-- Close X: just the glyph turns red on hover (no filled square), like KillerPDF.
                             Foreground is a Style setter (not a local value) so the hover trigger can win. -->
                        <Button Content="&#x2715;" Click="AboutClose_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Width="28" Height="26" Margin="0,6,6,0" Panel.ZIndex="2" FontSize="11"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <ContentPresenter x:Name="cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="#E04444"/>
                                                        <Setter TargetName="cp" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.5"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <StackPanel Margin="18,10,18,18">
                            <!-- Header: icon to the left of the wordmark + description + tagline.
                                 A Grid (not a horizontal StackPanel) so the text column is bounded and wraps. -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="pack://application:,,,/Resources/ks-icon.png" Width="58" Height="58"
                                       Margin="0,0,15,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.55"/>
                                    </Image.Effect>
                                </Image>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Grid Margin="0,0,0,4" HorizontalAlignment="Left">
                                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" Margin="1,2,0,0" IsHitTestVisible="False"
                                                   Opacity="{DynamicResource IconShadowOpacity}"><TextBlock.Effect><BlurEffect Radius="2"/></TextBlock.Effect><Run Text="Killer" FontSize="22" Foreground="#C0000000"/><Run Text="Scan" FontSize="28.6" FontWeight="Bold" Foreground="#C0000000"/></TextBlock>
                                        <TextBlock FontFamily="{DynamicResource WordmarkFont}"><Run Text="Killer" FontSize="22" Foreground="{DynamicResource TextBrush}"/><Run Text="Scan" FontSize="28.6" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/></TextBlock>
                                    </Grid>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"><Run Text="{DynamicResource Str_About_DescA}"/><Run Text="GPLv3 "/><Hyperlink NavigateUri="https://killertools.net" RequestNavigate="AboutLink_Navigate" Foreground="{DynamicResource PrimaryBrush}" TextDecorations="None">Killer Tools</Hyperlink><Run Text="{DynamicResource Str_About_DescB}"/></TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- Info panel - matte, lifted above the grainy card -->
                            <Grid>
                                <Border Background="{DynamicResource PaneBrush}" CornerRadius="4" IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.5"/>
                                    </Border.Effect>
                                </Border>
                                <Border Background="{DynamicResource PaneBrush}" CornerRadius="4" Padding="14,12,14,4">
                                    <StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Version}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <TextBlock x:Name="AboutVersionBlock" Foreground="{DynamicResource PrimaryBrush}"
                                                       FontFamily="Consolas" FontSize="13" Cursor="Hand"
                                                       MouseLeftButtonUp="AboutVersion_Click" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Publisher}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <TextBlock x:Name="AboutPublisherBlock" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Thumbprint}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <TextBlock x:Name="AboutThumbprintBlock" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Sha}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <TextBlock x:Name="AboutSha256Block" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{DynamicResource Str_About_Db}" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10"/>
                                            <TextBlock x:Name="AboutDbBlock" Foreground="{DynamicResource TextBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                            <TextBlock FontFamily="Consolas" FontSize="11" Margin="0,2,0,0">
                                                <Hyperlink x:Name="AboutDbUpdateLink" Click="AboutDbUpdate_Click" Foreground="{DynamicResource PrimaryBrush}"><Run Text="{DynamicResource Str_About_DbUpdate}"/></Hyperlink>
                                            </TextBlock>
                                            <TextBlock x:Name="AboutDbStatus" Foreground="{DynamicResource DimTextBrush}" FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Update notice: shown only when a newer release is found -->
                            <Button x:Name="AboutUpdateButton" Visibility="Collapsed" Margin="0,14,0,0"
                                    HorizontalAlignment="Left" Cursor="Hand" Click="AboutUpdateButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ub" Background="Transparent" BorderBrush="{DynamicResource PrimaryBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="14,7">
                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ub" Property="Background" Value="{DynamicResource RowSelectedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="AboutUpdateText" Text="Update available" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </Button>

                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</Window>
