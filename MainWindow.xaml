<Window x:Class="KillerScan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KillerScan"
        xmlns:cm="clr-namespace:System.ComponentModel;assembly=System"
        mc:Ignorable="d"
        Title="KillerScan"
        Height="700" Width="1025"
        MinHeight="500" MinWidth="800"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        BorderThickness="0"
        BorderBrush="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Icon="Resources/ks-icon.ico">

    <!-- Native custom chrome (no AllowsTransparency): WPF composites on the GPU and Windows
         draws the drop shadow + rounds the HWND (Win11, via DWMWA_WINDOW_CORNER_PREFERENCE in
         WindowChrome.cs). The 36px title bar becomes the draggable caption; interactive bits in
         it opt back in with WindowChrome.IsHitTestVisibleInChrome. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="8"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" Opacity="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>     <!-- 0: title bar -->
            <RowDefinition Height="Auto"/>   <!-- 1: scan toolbar -->
            <RowDefinition Height="*"/>      <!-- 2: devices pane -->
            <RowDefinition Height="24"/>     <!-- 3: footer / status bar (24px + 11.5/10.5 type, family standard) -->
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}">
            <Grid>
                <!-- Film grain over the bar (behind content) -->
                <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}">
                    <Border.Background>
                        <ImageBrush x:Name="TitleGrainBrush" TileMode="Tile"
                                    ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>
                    </Border.Background>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <Image Source="pack://application:,,,/Resources/ks-icon.png" Width="27" Height="27"
                           VerticalAlignment="Center" Margin="0,0,7,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <!-- Typewriter wordmark with KillerPDF-style soft shadow: a blurred dark copy behind the
                         crisp text, faded by IconShadowOpacity (0 in light mode = no shadow).
                         Rolling the wheel over it drives the app-wide size (AppScale.cs). The
                         hit-test opt-in that lets the wheel reach it also takes it out of
                         WindowChrome's native caption, so drag and double-click-maximize are
                         restored by hand in AppScale.cs. The website link lives in About. -->
                    <Grid x:Name="LogoBar" VerticalAlignment="Center" Background="Transparent"
                          WindowChrome.IsHitTestVisibleInChrome="True"
                          MouseWheel="LogoBar_MouseWheel"
                          MouseLeftButtonDown="LogoBar_MouseLeftButtonDown"
                          ToolTip="{DynamicResource Str_TT_AppSize}">
                        <StackPanel Orientation="Horizontal" Margin="1,2,0,0" Opacity="{DynamicResource IconShadowOpacity}">
                            <StackPanel.Effect><BlurEffect Radius="3"/></StackPanel.Effect>
                            <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="18"><Run Text="Killer" Foreground="#D8000000"/><Run Text="Scan" FontSize="23.4" FontWeight="Bold" Foreground="#D8000000"/></TextBlock>
                        </StackPanel>
                        <TextBlock FontFamily="{DynamicResource WordmarkFont}" FontSize="18"><Run Text="Killer" Foreground="{DynamicResource TextBrush}"/><Run Text="Scan" FontSize="23.4" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/></TextBlock>
                    </Grid>
                    <TextBlock Text="{DynamicResource Str_Subtitle}" Foreground="{DynamicResource MutedTextBrush}"
                               FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" Margin="10,2,0,0"/>
                </StackPanel>

                <!-- Appearance + language (sit left of the window controls) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,140,0">

                    <!-- Keyboard shortcuts (F1). A Consolas "?" rather than an MDL2 glyph, matching
                         KillerNotes and KillerPDF, which both sit theirs right beside the globe. -->
                    <Button x:Name="ShortcutsButton" Click="ShortcutHelp_Click" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Width="30" Height="26"
                            Margin="0,0,12,0" ToolTip="{DynamicResource Str_TT_Shortcuts}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                                    <TextBlock x:Name="ico" Text="?" FontFamily="Consolas" FontSize="18"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                        <Setter TargetName="ico" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Language picker -->
                    <Button x:Name="LangButton" Click="LangButton_Click" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Width="30" Height="26"
                            Margin="0,0,12,0" ToolTip="{DynamicResource Str_TT_Language}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                                    <TextBlock x:Name="ico" Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                        <Setter TargetName="ico" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="LangMenu" Placement="Bottom" PreviewMouseWheel="Menu_ForwardWheelToGrid"/>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Theme picker button (opens a flyout, keeping the title bar grabbable) -->
                    <Button x:Name="ThemeButton" Click="ThemeButton_Click" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Width="30" Height="26" ToolTip="{DynamicResource Str_TT_Theme}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                                    <TextBlock x:Name="ico" Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                        <Setter TargetName="ico" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Theme + accent flyout -->
                <Popup x:Name="ThemePopup" PlacementTarget="{Binding ElementName=ThemeButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-92" VerticalOffset="5">
                    <Border Background="{DynamicResource MenuBackgroundBrush}" BorderBrush="{DynamicResource MenuBorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="14"
                            PreviewMouseWheel="Menu_ForwardWheelToGrid">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.55"/>
                        </Border.Effect>
                        <Grid>
                            <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}" CornerRadius="5" Margin="-12,-10">
                                <Border.Background>
                                    <ImageBrush x:Name="FlyoutGrainBrush" TileMode="Tile"
                                                ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>
                                </Border.Background>
                            </Border>
                            <StackPanel>
                            <TextBlock Text="{DynamicResource Str_Lbl_Theme}" Foreground="{DynamicResource DimTextBrush}" FontSize="10"
                                       FontWeight="SemiBold" Margin="2,0,0,6"/>
                            <StackPanel x:Name="ThemeSwatches" Orientation="Horizontal">
                                <Button Style="{StaticResource ThemeSwatch}" Tag="Dark"     Background="#3a3a3a" Click="ThemeSwatch_Click" ToolTip="Dark"/>
                                <Button Style="{StaticResource ThemeSwatch}" Tag="Light"    Background="#e8e8e8" Click="ThemeSwatch_Click" ToolTip="Light"/>
                                <Button Style="{StaticResource ThemeSwatch}" Tag="Black"    Background="#000000" Click="ThemeSwatch_Click" ToolTip="Black"/>
                                <Button Style="{StaticResource ThemeSwatch}" Tag="Blood"    Background="#4a1f20" Click="ThemeSwatch_Click" ToolTip="Blood"/>
                                <Button Style="{StaticResource ThemeSwatch}" Tag="Greed"    Background="#0a5234" Click="ThemeSwatch_Click" ToolTip="Greed"/>
                                <Button Style="{StaticResource ThemeSwatch}" Tag="Cyanotic" Background="#0a4a6e" Click="ThemeSwatch_Click" ToolTip="Cyanotic"/>
                            </StackPanel>
                            <TextBlock x:Name="AccentLabel" Text="{DynamicResource Str_Lbl_Accent}" Foreground="{DynamicResource DimTextBrush}" FontSize="10"
                                       FontWeight="SemiBold" Margin="2,10,0,6" Visibility="Collapsed"/>
                            <!-- Accent dots in ROYGBIV order; revealed only for accent-capable themes -->
                            <StackPanel x:Name="AccentSwatches" Orientation="Horizontal" Visibility="Collapsed">
                                <Button Style="{StaticResource ThemeSwatch}" Tag="Red"    Background="#DD504B" Click="AccentSwatch_Click" ToolTip="Red"/>
                                <Button Style="{StaticResource ThemeSwatch}" Tag="Orange" Background="#E8962C" Click="AccentSwatch_Click" ToolTip="Orange"/>
                                <Button Style="{StaticResource ThemeSwatch}" Tag="Green"  Background="#1ea54c" Click="AccentSwatch_Click" ToolTip="Green"/>
                                <Button Style="{StaticResource ThemeSwatch}" Tag="Teal"   Background="#1FB8A8" Click="AccentSwatch_Click" ToolTip="Teal"/>
                                <Button Style="{StaticResource ThemeSwatch}" Tag="Blue"   Background="#50AEE8" Click="AccentSwatch_Click" ToolTip="Blue"/>
                                <Button Style="{StaticResource ThemeSwatch}" Tag="Purple" Background="#B982E3" Click="AccentSwatch_Click" ToolTip="Purple"/>
                            </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Popup>

                <!-- Window Controls (Segoe MDL2 glyphs, matched to KillerPDF) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE921;" Click="MinimizeBtn_Click" Style="{StaticResource ChromeButton}"/>
                    <Button x:Name="MaximizeBtn" Content="&#xE922;" Click="MaximizeBtn_Click" Style="{StaticResource ChromeButton}"/>
                    <Button Content="&#xE8BB;" Click="CloseBtn_Click" Style="{StaticResource ChromeCloseButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scan / toolbar - part of the chrome, blends with the title bar above -->
        <!-- Top padding 0 + a 1px pull-up: the title bar's fixed 36px row leaves ~9px of slack under
             the wordmark, so the toolbar's own 8px top padding read as ~17px above the subnet box vs
             8px below. Removing the 8 and overlapping the title row by 1 equalizes it at 8/8; both
             bars share the same background+grain, so the 1px overlap is invisible. -->
        <!-- ScaleHost: the app-wide accessibility zoom (AppScale.cs) scales THIS grid only, so
             the title bar and footer stay a fixed size and the wordmark you scroll to zoom
             never moves. The DataGrid's saved column widths are logical px measured inside
             this transform, so they need no conversion across a scale change. -->
        <Grid x:Name="ScaleHost" Grid.Row="1" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 0: scan toolbar -->
                <RowDefinition Height="*"/>      <!-- 1: devices pane -->
            </Grid.RowDefinitions>

        <!-- IsHitTestVisibleInChrome is REQUIRED here, not optional polish. WindowChrome measures
             CaptionHeight (36) from BELOW ResizeBorderThickness (8), so the caption region runs to
             44px from the window top - past the 36px title row and 9px into this toolbar. Windows
             swallows every click in that region as caption, so the top of the Scan button and the
             subnet box were dead: only their lower two thirds responded. Opting the bar into chrome
             hit-testing hands those pixels back to WPF. Dragging the bar still works, because
             Toolbar_MouseDown forwards empty-space clicks as a caption drag itself. -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" Padding="16,0,16,8" Margin="0,-1,0,0"
                WindowChrome.IsHitTestVisibleInChrome="True"
                MouseLeftButtonDown="Toolbar_MouseDown">
            <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Film grain over the toolbar (behind content), matching the title bar.
                         Negative margin mirrors the Border's padding (16,0,16,8) so the grain
                         covers the bar exactly once - no double-grain band. -->
                    <Border Grid.ColumnSpan="6" IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}" Margin="-16,0,-16,-8">
                        <Border.Background>
                            <ImageBrush x:Name="ToolbarGrainBrush" TileMode="Tile"
                                        ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>
                        </Border.Background>
                    </Border>

                    <TextBlock Grid.Column="0" Text="{DynamicResource Str_Lbl_Subnet}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <TextBox Grid.Column="1" x:Name="SubnetInput"
                             Style="{StaticResource DarkTextBox}"
                             Padding="9,3" FontSize="12"
                             Text="192.168.1.0/24"
                             VerticalAlignment="Center"/>

                    <Button Grid.Column="2" x:Name="ScanBtn" Content="{DynamicResource Str_Btn_Scan}"
                            Style="{StaticResource OutlineButton}"
                            Click="ScanBtn_Click"
                            FontSize="12" Padding="14,5" Margin="10,0,0,0"/>

                    <!-- Local network info - clean label/value pairs + an accent interface badge -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="{DynamicResource Str_Lbl_Local}" Foreground="{DynamicResource ChromeTextBrush}"
                                   FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="LocalIpLabel" Text="--" Foreground="{DynamicResource TextBrush}"
                                   FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <TextBlock Text="{DynamicResource Str_Lbl_Gateway}" Foreground="{DynamicResource ChromeTextBrush}"
                                   FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="GatewayLabel" Text="--" Foreground="{DynamicResource TextBrush}"
                                   FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <TextBlock Text="{DynamicResource Str_Lbl_Dns}" Foreground="{DynamicResource ChromeTextBrush}"
                                   FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="DnsLabel" Text="--" Foreground="{DynamicResource TextBrush}"
                                   FontFamily="Consolas" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <TextBlock x:Name="InterfaceIcon" Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="InterfaceLabel" Text="--" Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>

            </Grid>
        </Border>

        <!-- Chrome strip behind the pane, so the side margins carry the grain like the other bars -->
        <Border Grid.Row="1" Background="{DynamicResource BackgroundBrush}">
            <Border IsHitTestVisible="False" Opacity="{DynamicResource GrainOpacity}"
                    Background="{DynamicResource GrainTileBrush}"/>
        </Border>

        <!-- Devices pane - the lightest tier, lifted above the chrome with an outward drop shadow
             (kept tight to the bars; the shadow overlays them rather than adding gap) -->
        <Border Grid.Row="1" Background="{DynamicResource PaneBrush}" BorderBrush="{DynamicResource PaneBorderBrush}"
                BorderThickness="1" CornerRadius="4" Margin="8,0,8,0" Panel.ZIndex="10">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Film grain over the WHOLE pane (behind content, clipped to the rounded corners) -->
                <Border Grid.RowSpan="2" IsHitTestVisible="False" Opacity="0.20" Panel.ZIndex="-1" CornerRadius="3">
                    <Border.Background>
                        <ImageBrush x:Name="GrainBrush" TileMode="Tile"
                                    ViewportUnits="Absolute" Viewport="0,0,256,256" Stretch="None"/>
                    </Border.Background>
                </Border>

                <Grid Grid.Row="0" Margin="12,8,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource Str_DiscoveredDevices}"
                               Foreground="{DynamicResource TextBrush}" FontFamily="Consolas"
                               FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    <!-- Search/filter box - magnifier + placeholder so it's clearly a search -->
                    <Border Grid.Column="1" Margin="16,0,0,0" Width="180" Height="26" VerticalAlignment="Center"
                            Background="{DynamicResource SurfaceBrush}" BorderThickness="1" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                                <Style.Triggers>
                                    <!-- Hover first, focus second so a focused box keeps the accent border -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource DimTextBrush}" Margin="8,0,5,0" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <TextBlock Text="{DynamicResource Str_FilterPlaceholder}" Foreground="{DynamicResource DimTextBrush}"
                                           FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=FilterInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="FilterInput" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                         SelectionBrush="{DynamicResource PrimaryBrush}" SelectionOpacity="0.35"
                                         FontSize="12" Padding="0,0,8,0" VerticalContentAlignment="Center"
                                         TextChanged="FilterInput_TextChanged"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="3" x:Name="DeviceCount"
                               Text="0 devices found"
                               Foreground="{DynamicResource ChromeTextBrush}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Grid.Column="4" x:Name="ExportButton"
                            Click="ExportButton_Click" IsEnabled="False"
                            ToolTip="{DynamicResource Str_TT_Export}" Cursor="Hand"
                            Background="Transparent" BorderThickness="0"
                            Width="32" Height="26" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent" CornerRadius="4">
                                    <TextBlock x:Name="ico" Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="15" Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                        <Setter TargetName="ico" Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom" HorizontalOffset="0" VerticalOffset="2"
                                         PreviewMouseWheel="Menu_ForwardWheelToGrid">
                                <MenuItem Header="{DynamicResource Str_Export_Csv}" Click="ExportCsv_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE9F9;"/></MenuItem.Icon>
                                </MenuItem>
                                <!-- Braces, not a globe: the globe is the language picker in the
                                     title bar and the Web Device type, and this is markup. -->
                                <MenuItem Header="{DynamicResource Str_Export_Html}" Click="ExportHtml_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource MenuIcon}" Text="&#xE943;"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <!-- Results DataGrid -->
                <DataGrid Grid.Row="1" x:Name="ResultsGrid"
                          Margin="8,0,0,8"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="Transparent"
                          Foreground="{DynamicResource TextBrush}"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource PaneBorderBrush}"
                          HeadersVisibility="Column"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          SelectionMode="Extended"
                          ContextMenuOpening="ResultsGrid_ContextMenuOpening"
                          ColumnHeaderHeight="28"
                          RowHeight="28"
                          AlternationCount="2"
                          RowStyle="{StaticResource DarkDataGridRow}"
                          CellStyle="{StaticResource DarkDataGridCell}">

                    <!-- Custom template: vertical scrollbar overlays the table's 8px right inset
                         at the pane edge, so it never takes layout space from the rows. -->
                    <DataGrid.Template>
                        <ControlTemplate TargetType="DataGrid">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="DG_ScrollViewer" Focusable="false">
                                    <ScrollViewer.Template>
                                        <ControlTemplate TargetType="ScrollViewer">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Border Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" SizeChanged="HeaderStrip_SizeChanged">
                                                    <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter"
                                                        Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                                                </Border>
                                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                                <!-- Overlay bar: the DataGrid itself now runs to the pane edge
                                                     (no right margin) while header/content keep an 8px right
                                                     inset above. The bar sits in the SAME cell as the content,
                                                     right-aligned, so it floats in that 8px gap at the pane edge
                                                     (like the website) and showing/hiding it never reflows the
                                                     table. 8px top margin keeps it off the header strip. -->
                                                <ScrollBar x:Name="PART_VerticalScrollBar"
                                                    Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right"
                                                    Orientation="Vertical" Margin="0,8,0,0"
                                                    Maximum="{TemplateBinding ScrollableHeight}"
                                                    ViewportSize="{TemplateBinding ViewportHeight}"
                                                    Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                                <ScrollBar x:Name="PART_HorizontalScrollBar"
                                                    Grid.Row="2" Grid.Column="0" Margin="0,0,8,0" Orientation="Horizontal"
                                                    Maximum="{TemplateBinding ScrollableWidth}"
                                                    ViewportSize="{TemplateBinding ViewportWidth}"
                                                    Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </ScrollViewer.Template>
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
