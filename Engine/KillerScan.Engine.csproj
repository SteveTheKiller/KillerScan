<Project Sdk="Microsoft.NET.Sdk">

  <!-- Scanning, discovery, fingerprinting and the raw result models, with no WPF and no UI
       text. The desktop app, its command line and any other host reference this project; the
       app embeds the built DLL in its single exe. net48 serves the current Windows apps and
       net10.0 is the target for future hosts. -->
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KillerScan.Engine</RootNamespace>
    <AssemblyName>KillerScan.Engine</AssemblyName>
    <!-- KillerScan.csproj stays the single version source; the engine reads it at build time. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\KillerScan.csproj')), '&lt;Version&gt;([0-9]+\.[0-9]+\.[0-9]+)&lt;/Version&gt;').Groups[1].Value)</Version>
    <FileVersion>$(Version).0</FileVersion>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- NuGet package. Published by .github/workflows/nuget-engine-release.yml when a KillerScan
       release is published, at the app's version. -->
  <PropertyGroup>
    <PackageId>KillerScan.Engine</PackageId>
    <Title>KillerScan.Engine</Title>
    <Authors>Steve the Killer</Authors>
    <Copyright>Copyright (c) 2026 Steve the Killer</Copyright>
    <Description>The network scanning engine behind KillerScan: local network detection, ARP and ping discovery, port scanning, service fingerprinting, mDNS and SSDP discovery, device classification, offline MAC vendor lookup, and a speed test client, for .NET Framework 4.8 and .NET 10.</Description>
    <PackageTags>network;network-scanner;lan;arp;port-scan;device-discovery;fingerprinting;mac-vendor;oui;mdns;ssdp;speed-test;csharp</PackageTags>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://killerscan.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SteveTheKiller/KillerScan</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/SteveTheKiller/KillerScan/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <!-- Same transitive pin as the app: System.Text.Json brings in packages whose old
         System.Net.Http and RegularExpressions versions carry advisories. Nothing from them
         is compiled or shipped. -->
    <PackageReference Include="System.Net.Http" Version="4.3.4" ExcludeAssets="all" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" ExcludeAssets="all" />
    <PackageReference Include="System.Text.Json" Version="10.0.11" />
    <PackageReference Include="PolySharp" Version="1.16.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The vendor database stays at Resources\oui.txt, where release.ps1 refreshes it. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Resources\oui.txt" Link="Resources\oui.txt" LogicalName="KillerScan.Engine.oui.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KillerScan.Engine.Tests" />
  </ItemGroup>

</Project>
