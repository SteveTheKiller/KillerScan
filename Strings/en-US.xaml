<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ================================================================
         KillerScan  -  English (en-US) strings.
         x:Key values are looked up at runtime - never change them.
         Other locales layer over this file; any key they omit falls back here.
         ================================================================ -->

    <!-- Title bar / chrome -->
    <sys:String x:Key="Str_Subtitle">Network Scanner</sys:String>
    <sys:String x:Key="Str_TT_Language">Language</sys:String>
    <sys:String x:Key="Str_TT_AppSize">Scroll over the wordmark to resize the app</sys:String>
    <sys:String x:Key="Str_TT_Theme">Theme</sys:String>
    <sys:String x:Key="Str_TT_Export">Export</sys:String>
    <sys:String x:Key="Str_Lbl_Theme">THEME</sys:String>
    <sys:String x:Key="Str_Lbl_Accent">ACCENT</sys:String>

    <!-- Scan bar -->
    <sys:String x:Key="Str_Lbl_Subnet">Subnet</sys:String>
    <sys:String x:Key="Str_Btn_Scan">Scan</sys:String>
    <sys:String x:Key="Str_Lbl_Local">Local</sys:String>
    <sys:String x:Key="Str_Lbl_Gateway">Gateway</sys:String>
    <sys:String x:Key="Str_Lbl_Dns">DNS</sys:String>

    <!-- Status bar + counts ({0}/{1} are filled in by the app - keep them) -->
    <sys:String x:Key="Str_Btn_Stop">Stop</sys:String>
    <sys:String x:Key="Str_Status_Ready">Ready - {0} OUI vendors loaded</sys:String>
    <sys:String x:Key="Str_Count_Found">{0} devices found</sys:String>
    <sys:String x:Key="Str_Count_Shown">{0} of {1} shown</sys:String>

    <!-- Results pane -->
    <sys:String x:Key="Str_DiscoveredDevices">Discovered Devices</sys:String>
    <sys:String x:Key="Str_FilterPlaceholder">Filter devices...</sys:String>
    <sys:String x:Key="Str_Export_Csv">Export as CSV</sys:String>
    <sys:String x:Key="Str_Export_Html">Export as HTML</sys:String>

    <!-- Results columns -->
    <sys:String x:Key="Str_Col_Ip">IP Address</sys:String>
    <sys:String x:Key="Str_Col_Host">Hostname</sys:String>
    <sys:String x:Key="Str_Col_Mac">MAC Address</sys:String>
    <sys:String x:Key="Str_Col_Vendor">Vendor</sys:String>
    <sys:String x:Key="Str_Col_Type">Type</sys:String>
    <sys:String x:Key="Str_Col_Ports">Open Ports</sys:String>

    <!-- Right-click device menu -->
    <sys:String x:Key="Str_Ctx_RescanOne">Rescan IP</sys:String>
    <sys:String x:Key="Str_Ctx_RescanMany">Rescan IPs</sys:String>
    <sys:String x:Key="Str_Ctx_CopyIp">Copy IP Address</sys:String>
    <sys:String x:Key="Str_Ctx_CopyMac">Copy MAC Address</sys:String>
    <sys:String x:Key="Str_Ctx_CopyHost">Copy Hostname</sys:String>
    <sys:String x:Key="Str_Ctx_Ping">Ping</sys:String>
    <sys:String x:Key="Str_Ctx_OpenBrowser">Open in Browser</sys:String>
    <sys:String x:Key="Str_Ctx_Rdp">RDP</sys:String>
    <sys:String x:Key="Str_Ctx_Ssh">SSH</sys:String>
    <sys:String x:Key="Str_Ctx_SshAs">SSH as...</sys:String>
    <sys:String x:Key="Str_Ctx_SetType">Set Device Type</sys:String>
    <sys:String x:Key="Str_Ctx_ClearOverride">Clear Override</sys:String>

    <!-- SSH username prompt ({0} is the device, filled in by the app) -->
    <sys:String x:Key="Str_Ssh_Head">Connect to {0} over SSH</sys:String>
    <sys:String x:Key="Str_Ssh_Detail">The account to sign in as. KillerScan remembers it for this device, so you are only asked once. Leave it empty to let the SSH client decide.</sys:String>
    <sys:String x:Key="Str_Ssh_User">USERNAME</sys:String>
    <sys:String x:Key="Str_Ssh_Connect">Connect</sys:String>
    <sys:String x:Key="Str_Btn_Cancel">Cancel</sys:String>

    <!-- Theme names, shown in the rail's theme flyout. Shared with KillerShell and KillerNotes
         key for key, so the same thirteen themes read the same way across the family. SE98 is
         listed here ahead of the theme itself landing, because the name is not translated. -->
    <sys:String x:Key="Str_Theme_Dark">Dark</sys:String>
    <sys:String x:Key="Str_Theme_Light">Light</sys:String>
    <sys:String x:Key="Str_Theme_Black">Black</sys:String>
    <sys:String x:Key="Str_Theme_SE98">98SE</sys:String>
    <sys:String x:Key="Str_Theme_Blood">Blood</sys:String>
    <sys:String x:Key="Str_Theme_Greed">Greed</sys:String>
    <sys:String x:Key="Str_Theme_Cyanotic">Cyanotic</sys:String>
    <sys:String x:Key="Str_Theme_Ectoplasm">Ectoplasm</sys:String>
    <sys:String x:Key="Str_Theme_Decay">Decay</sys:String>
    <sys:String x:Key="Str_Theme_Malaise">Malaise</sys:String>
    <sys:String x:Key="Str_Theme_Sepulchre">Sepulchre</sys:String>
    <sys:String x:Key="Str_Theme_Delirium">Delirium</sys:String>
    <sys:String x:Key="Str_Theme_Mourning">Mourning</sys:String>

    <!-- About overlay -->
    <sys:String x:Key="Str_About_Version">VERSION</sys:String>
    <sys:String x:Key="Str_About_Publisher">PUBLISHER</sys:String>
    <sys:String x:Key="Str_About_Thumbprint">THUMBPRINT</sys:String>
    <sys:String x:Key="Str_About_Sha">EXE SHA-256</sys:String>
    <sys:String x:Key="Str_About_Db">VENDOR DATABASE</sys:String>
    <sys:String x:Key="Str_About_DbUpdate">Update from the latest registries</sys:String>
    <sys:String x:Key="Str_About_DbHint">From the Wireshark OUI list.</sys:String>
    <sys:String x:Key="Str_About_DbEntries">{0} entries</sys:String>
    <sys:String x:Key="Str_About_DbRefreshed">refreshed {0}</sys:String>
    <sys:String x:Key="Str_About_DbBundled">bundled with the app</sys:String>
    <sys:String x:Key="Str_About_DescA" xml:space="preserve">ARP + IP sweep with vendor lookup, device classification, and a themeable, sortable HTML export. A </sys:String>
    <sys:String x:Key="Str_About_DescB" xml:space="preserve"> utility.</sys:String>

    <!-- Status bar messages (composed in code - {0}/{1} are filled in by the app) -->
    <sys:String x:Key="Str_St_Discovering">Discovering hosts on {0}...</sys:String>
    <sys:String x:Key="Str_St_ResolvingMacs">Resolving {0} MAC addresses...</sys:String>
    <sys:String x:Key="Str_St_Probing">Probing {0} alive hosts...</sys:String>
    <sys:String x:Key="Str_St_ResolvingHosts">Resolving {0} hosts...</sys:String>
    <sys:String x:Key="Str_St_ScanComplete">Scan complete - {0} devices found</sys:String>
    <sys:String x:Key="Str_St_ScanCancelled">Scan canceled</sys:String>
    <sys:String x:Key="Str_St_Rescanning">Deep scanning {0} ...</sys:String>
    <sys:String x:Key="Str_St_RescanDone">Rescan complete - {0} host(s) refreshed</sys:String>
    <sys:String x:Key="Str_St_Exported">Exported to {0}</sys:String>
    <sys:String x:Key="Str_St_OverrideSet">Override set: {0} = {1}</sys:String>
    <sys:String x:Key="Str_St_OverrideCleared">Override cleared for {0}</sys:String>
    <sys:String x:Key="Str_St_AppSize">App size {0}%</sys:String>
    <sys:String x:Key="Str_St_BadTarget">Not a valid target: "{0}" - use 192.168.1.0/24, 192.168.1.7, or 192.168.1.10-50, separated by commas</sys:String>
    <sys:String x:Key="Str_St_TooManyAddresses">That is {0} addresses - too many for one scan (limit {1}). Narrow the range or split it across tabs.</sys:String>
    <sys:String x:Key="Str_St_NoTarget">Enter a subnet, address, or range to scan</sys:String>

    <!-- Portable footer badge + install dialog -->
    <sys:String x:Key="Str_Portable">PORTABLE</sys:String>
    <sys:String x:Key="Str_InstallBtn">Install KillerScan...</sys:String>
    <sys:String x:Key="Str_Install_AllUsers">Install for all users (Admin required)</sys:String>
    <sys:String x:Key="Str_Install_AllUsersNote">Installs to Program Files for every account on this PC. Windows will ask for permission.</sys:String>
    <sys:String x:Key="Str_Install_HeadUser">Install KillerScan to your user profile?</sys:String>
    <sys:String x:Key="Str_Install_HeadAll">Install KillerScan for all users on this PC?</sys:String>
    <sys:String x:Key="Str_Install_AlreadyAllUsers">KillerScan is already installed for all users on this PC, so this will update that copy. Windows will ask for permission.</sys:String>
    <sys:String x:Key="Str_St_InstallCancelled">Install canceled</sys:String>

    <!-- Themed window system menu (right-click the title bar / Alt+Space) -->
    <sys:String x:Key="Str_Sys_Restore">Restore</sys:String>
    <sys:String x:Key="Str_Sys_Move">Move</sys:String>
    <sys:String x:Key="Str_Sys_Size">Size</sys:String>
    <sys:String x:Key="Str_Sys_Minimize">Minimize</sys:String>
    <sys:String x:Key="Str_Sys_Maximize">Maximize</sys:String>
    <sys:String x:Key="Str_Sys_Close">Close</sys:String>

    <!-- Keyboard shortcuts overlay (F1) -->
    <sys:String x:Key="Str_TT_Shortcuts">Keyboard shortcuts (F1)</sys:String>
    <sys:String x:Key="Str_Shortcuts_Title">Keyboard shortcuts</sys:String>
    <sys:String x:Key="Str_Sc_Scan">Start or stop a scan</sys:String>
    <sys:String x:Key="Str_Sc_Cancel">Cancel the scan, or close this</sys:String>
    <sys:String x:Key="Str_Sc_Rescan">Deep rescan the selected hosts</sys:String>
    <sys:String x:Key="Str_Sc_Subnet">Jump to the subnet box</sys:String>
    <sys:String x:Key="Str_Sc_SelectAll">Select every device</sys:String>
    <sys:String x:Key="Str_Sc_Export">Export results</sys:String>
    <sys:String x:Key="Str_Sc_Browser">Open the selected device in a browser</sys:String>
    <sys:String x:Key="Str_Sc_Ping">Ping the selected device</sys:String>
    <sys:String x:Key="Str_Sc_Rdp">Open Remote Desktop to the selected device</sys:String>
    <sys:String x:Key="Str_Sc_Ssh">Connect to the selected device over SSH</sys:String>
    <sys:String x:Key="Str_Sc_SshAs">Choose an SSH account and connect</sys:String>
    <sys:String x:Key="Str_Sc_CopyIp">Copy the selected IP address</sys:String>
    <sys:String x:Key="Str_Sc_CopyMac">Copy the selected MAC address</sys:String>
    <sys:String x:Key="Str_Sc_CopyHost">Copy the selected hostname</sys:String>
    <sys:String x:Key="Str_Sc_DeviceMenu">Open every action for the selected device</sys:String>
    <sys:String x:Key="Str_Sc_AppBigger">Make the app bigger</sys:String>
    <sys:String x:Key="Str_Sc_AppSmaller">Make the app smaller</sys:String>
    <sys:String x:Key="Str_Sc_AppReset">Reset the app size</sys:String>
    <sys:String x:Key="Str_Sc_Help">Show this list</sys:String>
    <sys:String x:Key="Str_Sc_Hint">The app size also follows the mouse wheel over the wordmark.</sys:String>

</ResourceDictionary>
